<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Controls.SensorRow.SensorRowHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    IsTabStop="False"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Stretch">

        <!--
            (the columns of the CardContent grid in SensorRowControl, changed together, the MaxWidth of
            workaround: star columns fill greedily included)
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="NameColumn"
                Width="5*"
                MinWidth="70" />
            <ColumnDefinition
                x:Name="ThresholdColumn"
                Width="36"
                MinWidth="36" />
            <ColumnDefinition
                x:Name="CurrentColumn"
                Width="2*"
                MinWidth="60"
                MaxWidth="10000" />
            <ColumnDefinition
                x:Name="MinimumColumn"
                Width="2*"
                MinWidth="60"
                MaxWidth="10000" />
            <ColumnDefinition
                x:Name="MaximumColumn"
                Width="2*"
                MinWidth="60"
                MaxWidth="10000" />
            <ColumnDefinition
                x:Name="AverageColumn"
                Width="2*"
                MinWidth="60"
                MaxWidth="10000" />
            <ColumnDefinition
                x:Name="UnitColumn"
                Width="0"
                MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!--  (the left margin aligns the label with the sensor name, past the checkbox)  -->
        <TextBlock
            x:Uid="SensorRowHeader_SensorText"
            Grid.Column="0"
            Margin="38,0,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            x:Name="ThresholdLabel"
            Grid.Column="1"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="T"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <!--<FontIcon
            Grid.Column="1"
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Glyph="&#xE7C1;" />-->
        <TextBlock
            x:Name="CurrentLabel"
            x:Uid="SensorRowHeader_CurrentLabel"
            Grid.Column="2"
            HorizontalAlignment="Right"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            x:Name="MinimumLabel"
            x:Uid="SensorRowHeader_MinimumLabel"
            Grid.Column="3"
            HorizontalAlignment="Right"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            x:Name="MaximumLabel"
            x:Uid="SensorRowHeader_MaximumLabel"
            Grid.Column="4"
            HorizontalAlignment="Right"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            x:Name="AverageLabel"
            x:Uid="SensorRowHeader_AverageLabel"
            Grid.Column="5"
            HorizontalAlignment="Right"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            x:Name="UnitLabel"
            x:Uid="SensorRowHeader_UnitLabel"
            Grid.Column="6"
            HorizontalAlignment="Right"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
