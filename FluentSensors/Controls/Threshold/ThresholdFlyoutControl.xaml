<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Controls.Threshold.ThresholdFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    FocusVisualMargin="-3"
    UseSystemFocusVisuals="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ThresholdIndicatorHoverBrush" Color="#13FFFFFF" />
                    <SolidColorBrush x:Key="ThresholdIndicatorPressedBrush" Color="#0CFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ThresholdIndicatorHoverBrush" Color="#FFEFEFEF" />
                    <SolidColorBrush x:Key="ThresholdIndicatorPressedBrush" Color="#FFF3F3F3" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  badge: "-" or the configured value on the threshold color  -->
    <!--
        a tap opens the editor flyout; with OutlineWhileOpen an unset badge shows an empty outline in the picked color
        while the flyout is open (the border is always 1 px, so only its brush changes)
        the Border is the Content of the UserControl, so the VisualStateGroups live on it; GoToState
        looks only at the Content root
    -->
    <Border
        x:Name="IndicatorBorder"
        Width="34"
        Padding="4,1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{x:Bind IndicatorBrush, Mode=OneWay}"
        BackgroundSizing="OuterBorderEdge"
        BorderBrush="{x:Bind IndicatorBorderBrush, Mode=OneWay}"
        BorderThickness="1"
        CornerRadius="3"
        Opacity="0.95"
        PointerEntered="IndicatorBorder_PointerEntered"
        PointerExited="IndicatorBorder_PointerExited"
        PointerPressed="IndicatorBorder_PointerPressed"
        PointerReleased="IndicatorBorder_PointerReleased"
        Tapped="IndicatorBorder_Tapped">
        <FlyoutBase.AttachedFlyout>
            <Flyout
                x:Name="ThresholdFlyout"
                Closed="ThresholdFlyout_Closed"
                Opened="ThresholdFlyout_Opened"
                Placement="Bottom"
                ShouldConstrainToRootBounds="False">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0,0,0,0" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <StackPanel
                    Width="105"
                    Padding="4"
                    Spacing="8">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Uid="Threshold_ThresholdConfigText"
                            Grid.Column="0"
                            Margin="5,3,16,0"
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />

                        <Button
                            x:Name="ThresholdCloseButton"
                            x:Uid="Threshold_ThresholdCloseButton"
                            Grid.Column="0"
                            Width="28"
                            Height="28"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="ThresholdCloseButton_Click"
                            Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <Grid
                        Height="90"
                        Margin="0"
                        ColumnSpacing="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <RepeatButton
                                x:Uid="Threshold_IncreaseThresholdButton"
                                Grid.Row="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Click="{x:Bind Threshold.Increase}">
                                <FontIcon FontSize="12" Glyph="&#xE70E;" />
                            </RepeatButton>

                            <RepeatButton
                                x:Uid="Threshold_DecreaseThresholdButton"
                                Grid.Row="1"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Click="{x:Bind Threshold.Decrease}">
                                <FontIcon FontSize="12" Glyph="&#xE70D;" />
                            </RepeatButton>

                            <ToggleButton
                                x:Uid="Threshold_ToggleThresholdLineButton"
                                Grid.Row="2"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="T"
                                FontSize="12"
                                FontWeight="Normal"
                                IsChecked="{x:Bind Threshold.IsEnabled, Mode=TwoWay}" />
                        </Grid>

                        <Grid Grid.Column="1" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ToggleButton
                                x:Uid="Threshold_MarkAboveThresholdButton"
                                Grid.Row="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsChecked="{x:Bind Threshold.IsAboveDirection, Mode=TwoWay}">
                                <FontIcon
                                    FontSize="12"
                                    Glyph="&#xEDE1;"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </ToggleButton>

                            <Button
                                x:Uid="Threshold_ThresholdColorButton"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{x:Bind Threshold.ColorBrush, Mode=OneWay}"
                                Style="{StaticResource ColorSwatchButtonStyle}">

                                <Button.Flyout>
                                    <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                                        <controls:ColorPicker
                                            x:Uid="Threshold_ThresholdColorPicker"
                                            ColorSpectrumShape="Box"
                                            IsAlphaEnabled="False"
                                            IsAlphaSliderVisible="False"
                                            IsAlphaTextInputVisible="False"
                                            IsColorChannelTextInputVisible="True"
                                            IsColorPaletteVisible="True"
                                            IsColorSliderVisible="True"
                                            IsColorSpectrumVisible="True"
                                            Color="{x:Bind Threshold.Color, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <ToggleButton
                                x:Uid="Threshold_MarkUnderThresholdButton"
                                Grid.Row="2"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsChecked="{x:Bind Threshold.IsBelowDirection, Mode=TwoWay}">
                                <FontIcon
                                    FontSize="12"
                                    Glyph="&#xEDE1;"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="90" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </ToggleButton>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Flyout>
        </FlyoutBase.AttachedFlyout>

        <TextBlock
            Margin="0,0,0,1"
            HorizontalAlignment="Center"
            FontSize="10"
            Text="{x:Bind IndicatorText, Mode=OneWay}"
            TextAlignment="Center" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ThresholdIndicatorStates">
                <VisualState x:Name="IndicatorNormal" />

                <!--  (unconfigured only)  -->
                <VisualState x:Name="IndicatorHover">
                    <VisualState.Setters>
                        <Setter Target="IndicatorBorder.Background" Value="{ThemeResource ThresholdIndicatorHoverBrush}" />
                    </VisualState.Setters>
                </VisualState>

                <!--  (unconfigured only)  -->
                <VisualState x:Name="IndicatorPressedUnconfigured">
                    <VisualState.Setters>
                        <Setter Target="IndicatorBorder.Background" Value="{ThemeResource ThresholdIndicatorPressedBrush}" />
                        <Setter Target="IndicatorBorder.Opacity" Value="1.0" />
                    </VisualState.Setters>
                </VisualState>

                <!--  pressed on a set threshold color  -->
                <VisualState x:Name="IndicatorPressedConfigured">
                    <VisualState.Setters>
                        <Setter Target="IndicatorBorder.Opacity" Value="0.6" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Border>
</UserControl>
