<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Controls.TimeRange.TimeRangePickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="18"
    HorizontalAlignment="Left"
    mc:Ignorable="d">

    <Grid>

        <!--  the time range with a chevron  -->
        <!--  (a subtle button that opens the hidden combobox in one click, like the sensor switch of SensorPanelControl)  -->
        <Button
            x:Name="PickerButton"
            Padding="4,0,4,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
            Click="PickerButton_Click"
            SizeChanged="PickerButton_SizeChanged"
            Style="{StaticResource SubtleButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind FormatLabel(Label, SelectedSeconds), Mode=OneWay}" />
                <FontIcon FontSize="10" Glyph="&#xE70D;" />
            </StackPanel>
        </Button>

        <!--  the real selection  -->
        <!--  (invisible, sized to the button from code; a canvas, so it never widens the control)  -->
        <Canvas>
            <ComboBox
                x:Name="OptionsComboBox"
                MinWidth="0"
                MinHeight="0"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                DisplayMemberPath="DisplayName"
                DropDownClosed="OptionsComboBox_DropDownClosed"
                DropDownOpened="OptionsComboBox_DropDownOpened"
                IsHitTestVisible="False"
                Opacity="0"
                SelectionChanged="OptionsComboBox_SelectionChanged" />
        </Canvas>
    </Grid>
</UserControl>
