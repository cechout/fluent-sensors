<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Controls.SensorGraph.SensorGraphControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <Border
        x:Name="CardBorder"
        Padding="0,0,0,0"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid CornerRadius="3.3">
            <lvc:CartesianChart
                x:Name="Chart"
                Margin="-3,0,-3,-2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AnimationsSpeed="00:00:00"
                Background="Transparent"
                CornerRadius="20"
                DrawMargin="{Binding ChartMargin, ElementName=Root}"
                Sections="{Binding Sections, ElementName=Root}"
                Series="{Binding Series, ElementName=Root}"
                TooltipPosition="Hidden"
                XAxes="{Binding XAxes, ElementName=Root}"
                YAxes="{Binding YAxes, ElementName=Root}" />

            <!--  static title + current value overlay  -->
            <!--  (top row, only shown when IsLabelVisible is true; see LabelText/CurrentValueText/IsLabelVisible)  -->
            <Grid
                Margin="4,1,4,0"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  left: sensor name + unit  -->
                <TextBlock
                    x:Name="GraphLabelText"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="Collapsed" />

                <!--  right: current value  -->
                <TextBlock
                    x:Name="GraphCurrentValueText"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Typography.NumeralAlignment="Tabular"
                    Visibility="Collapsed" />
            </Grid>

            <Canvas
                x:Name="HoverCanvas"
                Margin="-3,0,-3,-2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False">

                <Ellipse
                    x:Name="HoverCircle"
                    Width="8"
                    Height="8"
                    StrokeThickness="1"
                    Visibility="Collapsed" />

                <Border
                    x:Name="CurrentValueLabelBorder"
                    Padding="4,2"
                    CornerRadius="3"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="CurrentValueLabelText"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        TextAlignment="Center" />
                </Border>

                <Border
                    x:Name="ThresholdValueLabelBorder"
                    Padding="4,2"
                    CornerRadius="3"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ThresholdValueLabelText"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        TextAlignment="Center" />
                </Border>
            </Canvas>
        </Grid>


        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CardBackgroundStates">
                <VisualState x:Name="CardBackgroundVisible">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Border>
</UserControl>
