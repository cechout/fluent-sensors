<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Controls.SensorGraph.SensorPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhThreshold="using:FluentSensors.Controls.Threshold"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <Grid Background="Transparent" RowSpacing="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  label row  -->
        <!--  (title row and status row overlap here, both independently toggleable via ShowTitleRow/ShowStatusRow)  -->
        <Grid Grid.Row="0" Visibility="{x:Bind GetContentVisibility(ViewModel), Mode=OneWay}">

            <!--  separate title row: just the sensor name  -->
            <TextBlock
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.SensorName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind BoolToVisibility(ShowTitleRow), Mode=OneWay}" />

            <!--  status row: toggle button, current Y-max, sensor name (+ unit), current value  -->
            <Grid
                Padding="0,0,0,0"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                ColumnSpacing="0"
                Visibility="{x:Bind BoolToVisibility(ShowStatusRow), Mode=OneWay}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  toggle button; what it does depends on ButtonTapAction  -->
                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="18"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Click="ToggleButton_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Toggle Panel"
                    Visibility="Visible">

                    <FontIcon
                        FontSize="14"
                        FontWeight="Normal"
                        Glyph="&#xE90C;" />
                </Button>

                <!--  current max y-axis value  -->
                <TextBlock
                    Grid.Column="1"
                    Margin="1,0,10,0"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ActualYMaxText, Mode=OneWay}" />

                <!--  sensor name, or name + unit if ShowUnitInStatusRow  -->
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind GetStatusRowTitle(ShowUnitInStatusRow, ViewModel.SensorName, ViewModel.DisplayNameWithUnit), Mode=OneWay}" />

                <!--  current value  -->
                <TextBlock
                    Grid.Column="2"
                    Padding="0,0,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{x:Bind ViewModel.CurrentValueColor, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentValueText, Mode=OneWay}" />
            </Grid>
        </Grid>


        <!--  graph  -->
        <!--  (left + right: control buttons, middle: LiveChart graph)  -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="0"
            Visibility="{x:Bind GetContentVisibility(ViewModel), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Y-axis control buttons  -->
            <Grid
                Grid.Column="0"
                Width="36"
                Padding="0,0,3,0"
                RowSpacing="3"
                Visibility="{x:Bind GetYAxisControlsVisibility(ShowYAxisControls, GraphTapAction, ButtonTapAction, ViewModel.ControlPanelVisibility), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <RepeatButton
                    Grid.Row="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="{x:Bind ViewModel.IncreaseYMax}"
                    ToolTipService.ToolTip="Increase Y-Axis">
                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                </RepeatButton>

                <RepeatButton
                    Grid.Row="1"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="{x:Bind ViewModel.DecreaseYMax}"
                    ToolTipService.ToolTip="Decrease Y-Axis">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </RepeatButton>

                <ToggleButton
                    Grid.Row="2"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="A"
                    FontSize="12"
                    FontWeight="Normal"
                    IsChecked="{x:Bind ViewModel.IsAutoScaled, Mode=TwoWay}"
                    ToolTipService.ToolTip="Auto-Scale" />
            </Grid>

            <!--  threshold buttons 1  -->
            <Grid
                Grid.Column="2"
                Width="36"
                Padding="3,0,0,0"
                RowSpacing="3"
                Visibility="{x:Bind GetThresholdControlsVisibility(ShowThresholdControls, GraphTapAction, ButtonTapAction, ViewModel.ControlPanelVisibility), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <RepeatButton
                    Grid.Row="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="{x:Bind ViewModel.Threshold.Increase}"
                    ToolTipService.ToolTip="Increase Threshold">
                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                </RepeatButton>

                <RepeatButton
                    Grid.Row="1"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="{x:Bind ViewModel.Threshold.Decrease}"
                    ToolTipService.ToolTip="Decrease Threshold">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </RepeatButton>

                <ToggleButton
                    Grid.Row="2"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="T"
                    FontSize="12"
                    FontWeight="Normal"
                    IsChecked="{x:Bind ViewModel.Threshold.IsEnabled, Mode=TwoWay}"
                    ToolTipService.ToolTip="Toggle Threshold-Line" />
            </Grid>

            <!--  threshold buttons 2  -->
            <Grid
                Grid.Column="3"
                Width="36"
                Padding="3,0,0,0"
                RowSpacing="3"
                Visibility="{x:Bind GetThresholdControlsVisibility(ShowThresholdControls, GraphTapAction, ButtonTapAction, ViewModel.ControlPanelVisibility), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ToggleButton
                    Grid.Row="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsChecked="{x:Bind ViewModel.Threshold.IsAboveDirection, Mode=TwoWay}"
                    ToolTipService.ToolTip="Mark Above Threshold">
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xEDE1;"
                        RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </ToggleButton>

                <Button
                    Grid.Row="1"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                    <Border
                        Background="{x:Bind ViewModel.Threshold.ColorBrush, Mode=OneWay}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3" />

                    <Button.Flyout>
                        <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                            <controls:ColorPicker
                                ColorSpectrumShape="Box"
                                IsAlphaEnabled="False"
                                IsAlphaSliderVisible="False"
                                IsAlphaTextInputVisible="False"
                                IsColorChannelTextInputVisible="True"
                                IsColorPaletteVisible="True"
                                IsColorSliderVisible="False"
                                IsColorSpectrumVisible="True"
                                Color="{x:Bind ViewModel.Threshold.Color, Mode=TwoWay}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <ToggleButton
                    Grid.Row="2"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsChecked="{x:Bind ViewModel.Threshold.IsBelowDirection, Mode=TwoWay}"
                    ToolTipService.ToolTip="Mark Under Threshold">
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xEDE1;"
                        RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="90" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </ToggleButton>
            </Grid>

            <!--  graph, plus optional threshold-flyout badge overlay top-right when either tap action opens it  -->
            <Grid Grid.Column="1">
                <fhGraph:SensorGraphControl
                    x:Name="GraphControl"
                    AccentColor="{x:Bind GetEffectiveGraphColor(GraphColorOverride, ViewModel.GraphColor), Mode=OneWay}"
                    CardBackgroundOverride="{x:Bind BoolToCardBackgroundOverride(ShowGraphCardBackground), Mode=OneWay}"
                    IsAutoScaled="{x:Bind ViewModel.IsAutoScaled, Mode=OneWay}"
                    IsLabelVisible="{x:Bind ShowGraphLabel, Mode=OneWay}"
                    LabelFollowsPointer="True"
                    LabelText="{x:Bind ViewModel.DisplayNameWithUnit, Mode=OneWay}"
                    ManualYMax="{x:Bind ViewModel.ManualYMax, Mode=OneWay}"
                    SensorType="{x:Bind ViewModel.SensorType, Mode=OneWay}"
                    Tapped="GraphControl_Tapped"
                    ThresholdColor="{x:Bind ViewModel.Threshold.Color, Mode=OneWay}"
                    ThresholdDirection="{x:Bind ViewModel.Threshold.Direction, Mode=OneWay}"
                    ThresholdLabelAlwaysVisible="{x:Bind ThresholdLabelAlwaysVisible, Mode=OneWay}"
                    ThresholdValue="{x:Bind ViewModel.Threshold.EffectiveValue, Mode=OneWay}"
                    Values="{x:Bind ViewModel.SensorData, Mode=OneWay}" />

                <fhThreshold:ThresholdFlyoutControl
                    x:Name="ThresholdFlyoutBadge"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsHitTestVisible="{x:Bind ShowThresholdFlyoutIndicator, Mode=OneWay}"
                    Opacity="{x:Bind BoolToOpacity(ShowThresholdFlyoutIndicator), Mode=OneWay}"
                    Threshold="{x:Bind ViewModel.Threshold, Mode=OneWay}"
                    Visibility="{x:Bind GetThresholdFlyoutVisibility(GraphTapAction, ButtonTapAction), Mode=OneWay}" />
            </Grid>
        </Grid>

        <!--  not found placeholder; shown instad of the whole panel when viewmodel is null  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{x:Bind GetNotFoundVisibility(ViewModel), Mode=OneWay}">
            <TextBlock
                Margin="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind FormatNotFoundMessage(PlaceholderSensorName, PlaceholderUnit)}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>