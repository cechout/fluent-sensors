<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Controls.InfoPopup.InfoPopupControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentSensors.Controls.InfoPopup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Unloaded="InfoPopupControl_Unloaded"
    mc:Ignorable="d">


    <UserControl.Resources>
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <!--  rest state, the bound ButtonBackground (Transparent by default)  -->
                                    <VisualState x:Name="Normal" />

                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  (SourceLinkButtonStyle sits in App.xaml, shared with the release dialog)  -->
    </UserControl.Resources>


    <Grid x:Name="RootGrid" MinHeight="{x:Bind ButtonSize, Mode=OneWay}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PopupStates">

                <!--  rest state, no setters: the defaults or a consumer TitleForeground and ButtonGlyphForeground  -->
                <VisualState x:Name="PopupClosed" />

                <!--  (setters, since a Foreground from code cuts the ThemeResource and the theme switch with it)  -->
                <VisualState x:Name="PopupOpen">
                    <VisualState.Setters>
                        <Setter Target="TitleTextBlock.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Setter Target="ButtonGlyphIcon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Setter Target="TitleContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  optional title, collapsed without Title or TitleContent  -->
        <Grid
            x:Name="TitleHost"
            VerticalAlignment="Center"
            Visibility="{x:Bind GetTitleVisibility(Title, TitleContent), Mode=OneWay}">
            <TextBlock
                x:Name="TitleTextBlock"
                Margin="{x:Bind GetTitleMargin(ButtonSize, ShowInfoButton), Mode=OneWay}"
                HorizontalAlignment="Left"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                SizeChanged="TitleSlot_SizeChanged"
                Style="{x:Bind TitleStyle, Mode=OneWay}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextTrimming="{x:Bind TitleTextTrimming, Mode=OneWay}"
                TextWrapping="{x:Bind TitleTextWrapping, Mode=OneWay}" />

            <!--  consumer content instead of Title; shares the cell, the unused one measures zero  -->
            <ContentPresenter
                x:Name="TitleContentPresenter"
                Margin="{x:Bind GetTitleMargin(ButtonSize, ShowInfoButton), Mode=OneWay}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{x:Bind TitleContent, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                SizeChanged="TitleSlot_SizeChanged" />
        </Grid>


        <!--  info button  -->
        <Grid
            x:Name="ButtonHost"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Button
                x:Name="InfoButton"
                Width="{x:Bind ButtonSize, Mode=OneWay}"
                Height="{x:Bind ButtonSize, Mode=OneWay}"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind GetInfoButtonName(Title), Mode=OneWay}"
                Background="{x:Bind ButtonBackground, Mode=OneWay}"
                BorderThickness="0"
                Click="InfoButton_Click"
                CornerRadius="{x:Bind ButtonCornerRadius, Mode=OneWay}"
                Style="{StaticResource InfoButtonStyle}"
                Visibility="{x:Bind BoolToVisibility(ShowInfoButton), Mode=OneWay}">

                <FontIcon
                    x:Name="ButtonGlyphIcon"
                    FontSize="{x:Bind ButtonGlyphSize, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind ButtonGlyph, Mode=OneWay}" />
            </Button>


            <!--  popup  -->
            <Popup
                x:Name="InfoPopup"
                Closed="InfoPopup_Closed"
                IsLightDismissEnabled="True"
                Opened="InfoPopup_Opened">

                <Popup.ChildTransitions>
                    <TransitionCollection />
                </Popup.ChildTransitions>

                <Border
                    x:Name="PopupContentBorder"
                    MaxWidth="280"
                    Padding="12"
                    x:Load="False"
                    Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    SizeChanged="PopupContent_SizeChanged">

                    <!--  top to bottom: source intro, source links (or the plain source line), description  -->
                    <StackPanel Spacing="4">

                        <!--  source intro, collapsed by default  -->
                        <ItemsControl ItemsSource="{x:Bind SplitParagraphs(SourceIntro), Mode=OneWay}" Visibility="{x:Bind GetSourceIntroVisibility(SourceIntro), Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  source links, one HyperlinkButton each  -->
                        <ItemsControl
                            Margin="0,0,0,8"
                            ItemsSource="{x:Bind SourceLinks}"
                            Visibility="{x:Bind GetSourceLinksVisibility(SourceLinks)}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SourceLink">
                                    <HyperlinkButton
                                        Content="{x:Bind Label}"
                                        NavigateUri="{x:Bind Url}"
                                        Style="{StaticResource SourceLinkButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  (the plain source line while SourceLinks is empty)  -->
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind FormatSource(Source), Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind GetSourceVisibility(Source, SourceLinks), Mode=OneWay}" />

                        <!--  description, one TextBlock per paragraph  -->
                        <ItemsControl ItemsSource="{x:Bind SplitParagraphs(Description), Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>