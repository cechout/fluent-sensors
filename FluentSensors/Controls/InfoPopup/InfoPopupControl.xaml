<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Controls.InfoPopup.InfoPopupControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentSensors.Controls.InfoPopup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="InfoPopupControl_Loaded"
    Unloaded="InfoPopupControl_Unloaded"
    mc:Ignorable="d">


    <UserControl.Resources>
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <!--  rest state  -->
                                    <!--  whatever ButtonBackground  is bound to (Transparent by default)  -->
                                    <VisualState x:Name="Normal" />

                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceLinkButtonStyle" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="6,2,6,2" />
            <Setter Property="Margin" Value="-6,0,0,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>


    <Grid x:Name="RootGrid" MinHeight="{x:Bind ButtonSize, Mode=OneWay}">


        <!--  optional title  -->
        <!--  (collapses entirely, including its layout space, when Title is empty)  -->
        <Grid
            x:Name="TitleHost"
            VerticalAlignment="Center"
            Visibility="{x:Bind GetTitleVisibility(Title), Mode=OneWay}">
            <TextBlock
                x:Name="TitleTextBlock"
                Margin="{x:Bind GetTitleMargin(ButtonSize, ShowInfoButton), Mode=OneWay}"
                HorizontalAlignment="Left"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                SizeChanged="TitleTextBlock_SizeChanged"
                Style="{x:Bind TitleStyle, Mode=OneWay}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextTrimming="{x:Bind TitleTextTrimming, Mode=OneWay}"
                TextWrapping="{x:Bind TitleTextWrapping, Mode=OneWay}" />
        </Grid>


        <!--  InfoButton  -->
        <Grid
            x:Name="ButtonHost"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Button
                x:Name="InfoButton"
                Width="{x:Bind ButtonSize, Mode=OneWay}"
                Height="{x:Bind ButtonSize, Mode=OneWay}"
                VerticalAlignment="Center"
                Background="{x:Bind ButtonBackground, Mode=OneWay}"
                BorderThickness="0"
                Click="InfoButton_Click"
                CornerRadius="{x:Bind ButtonCornerRadius, Mode=OneWay}"
                Style="{StaticResource InfoButtonStyle}"
                Visibility="{x:Bind BoolToVisibility(ShowInfoButton), Mode=OneWay}">

                <FontIcon
                    x:Name="ButtonGlyphIcon"
                    FontSize="{x:Bind ButtonGlyphSize, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind ButtonGlyph, Mode=OneWay}" />
            </Button>


            <!--  Popup  -->
            <Popup
                x:Name="InfoPopup"
                HorizontalOffset="-280"
                IsLightDismissEnabled="True">

                <Popup.ChildTransitions>
                    <TransitionCollection />
                </Popup.ChildTransitions>

                <Border
                    x:Name="PopupContentBorder"
                    MaxWidth="280"
                    Padding="12"
                    x:Load="False"
                    Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    SizeChanged="PopupContent_SizeChanged">

                    <!--  order top to bottom:  -->
                    <!--  SourceIntro  -->
                    <!--  SourceLinks (or the plain Source line as fallback)  -->
                    <!--  Description  -->
                    <StackPanel Spacing="4">

                        <!--  SourceIntro,  -->
                        <!--  (empty and collapsed by default)  -->
                        <ItemsControl ItemsSource="{x:Bind SplitParagraphs(SourceIntro), Mode=OneWay}" Visibility="{x:Bind GetSourceIntroVisibility(SourceIntro), Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  SourceLinks  -->
                        <!--  (clickable sources, one HyperlinkButton per entry)  -->
                        <ItemsControl
                            Margin="0,0,0,8"
                            ItemsSource="{x:Bind SourceLinks}"
                            Visibility="{x:Bind GetSourceLinksVisibility(SourceLinks)}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SourceLink">
                                    <HyperlinkButton
                                        Content="{x:Bind Label}"
                                        NavigateUri="{x:Bind Url}"
                                        Style="{StaticResource SourceLinkButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  (fallback plain text line, only shown while SourceLinks is still empty)  -->
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind FormatSource(Source), Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind GetSourceVisibility(Source, SourceLinks), Mode=OneWay}" />

                        <!--  Description  -->
                        <!--  (each paragraph in its own TextBlock instead of one block with embedded line breaks)  -->
                        <ItemsControl ItemsSource="{x:Bind SplitParagraphs(Description), Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>