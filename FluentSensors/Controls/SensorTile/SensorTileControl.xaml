<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Controls.SensorTile.SensorTileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="2"
        Background="Transparent"
        CornerRadius="4">
        <StackPanel Spacing="2">

            <!--  title row: fixed title text + optional info button  -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <Button
                    Width="20"
                    Height="20"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="{x:Bind BoolToVisibility(ShowInfoButton), Mode=OneWay}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE946;" />
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <TextBlock
                                MaxWidth="240"
                                Text="{x:Bind InfoMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!--  current value (live-updating direct property path) or a static "not found" fallback  -->
            <Grid>
                <TextBlock
                    Foreground="{x:Bind ViewModel.CurrentValueColor, Mode=OneWay}"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentValueText, Mode=OneWay}"
                    Visibility="{x:Bind GetValueVisibility(ViewModel), Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="-"
                    Visibility="{x:Bind GetNotFoundVisibility(ViewModel), Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>