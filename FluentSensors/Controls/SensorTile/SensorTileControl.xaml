<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Controls.SensorTile.SensorTileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="2"
        Background="Transparent"
        CornerRadius="4">
        <StackPanel Spacing="2">

            <!--  title + optional info button/popup  -->
            <!--  (PlacementMode "Above" matches the previous Flyout Placemnt=Top)  -->
            <infoPopup:InfoPopupControl
                Title="{x:Bind Title, Mode=OneWay}"
                Margin="0,0,0,-3"
                Description="{x:Bind InfoMessage, Mode=OneWay}"
                PlacementMode="Above"
                ShowInfoButton="{x:Bind ShowInfoButton, Mode=OneWay}"
                TitleForeground="{ThemeResource TextFillColorSecondaryBrush}"
                TitleStyle="{ThemeResource CaptionTextBlockStyle}"
                TitleTextTrimming="CharacterEllipsis"
                TitleTextWrapping="NoWrap" />

            <!--  current value (live-updating direct property path) or a static "not found" fallback  -->
            <Grid>

                <!--  invisible width anchor  -->
                <TextBlock
                    IsHitTestVisible="False"
                    Opacity="0"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind MaxValueText, Mode=OneWay}" />

                <TextBlock
                    Foreground="{x:Bind ViewModel.CurrentValueColor, Mode=OneWay}"
                    Style="{ThemeResource BodyLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentValueText, Mode=OneWay}"
                    Typography.NumeralAlignment="Tabular"
                    Visibility="{x:Bind GetValueVisibility(ViewModel), Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="-"
                    Visibility="{x:Bind GetNotFoundVisibility(ViewModel), Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>