<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentSensors.Features.Start.ReleaseNotesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Dialog_Loaded"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!--
            no button text is set anywhere on this dialog, which puts the template into its NoneVisible state and
            collapses the whole command bar; the close affordance is the X in the header instead
            padding goes to zero so the header and the navigation pane reach the dialog edges, and the separator
            above the now-absent command bar would otherwise still draw
        -->
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">980</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">740</x:Double>

        <!--
            the templates own top overlay is a square opaque fill that paints straight over the rounded corners,
            and DialogSpace above it is a Grid, which rounds only its own background and does not clip children
            transparent here plus the rounding Border below is what actually gives the dialog round corners
        -->
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
    </ContentDialog.Resources>

    <!--  (size and corner clipping are both applied in code, see ResizeToWindow)  -->
    <Border x:Name="RootBorder" CornerRadius="{ThemeResource OverlayCornerRadius}">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: title and close  -->
        <!--  (stands in for the dialogs own Title, so the padding stays ours)  -->
        <Grid
            Grid.Row="0"
            Padding="24,16,14,8"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="What's new" />

            <Button
                Grid.Column="1"
                Width="36"
                Height="36"
                Padding="0"
                VerticalAlignment="Top"
                Click="CloseButton_Click"
                Style="{ThemeResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
                <Button.KeyboardAccelerators>
                    <!--  (a dialog without a command bar has no close button for ESC to map onto)  -->
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!--  content: release navigation  -->
        <!--  (a real NavigationView driving a real Frame, which is what buys the native page transition)  -->
        <NavigationView
            x:Name="ReleaseNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="168"
            PaneDisplayMode="Left"
            SelectionChanged="ReleaseNav_SelectionChanged">

            <Grid>
                <Frame x:Name="ReleaseFrame" />

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="StatusText"
                    Margin="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
    </Border>
</ContentDialog>
