<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentSensors.Features.Start.ReleaseNotesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Dialog_Loaded"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <!--
        the style has to be named: an implicit style reaches its exact type only, never a subclass like this;
        without it the template stays but CornerRadius, BorderThickness and the button styles go (square corners)
    -->

    <ContentDialog.Resources>
        <!--
            no button text, so the template collapses the command bar (NoneVisible) and the header X closes;
            zero padding lets header and navigation pane reach the edges
        -->
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>

        <!--  painted on the content grid, which at zero padding covers the whole dialog  -->
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
    </ContentDialog.Resources>

    <!--  (the size is applied in code, see ResizeToWindow)  -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: title and close button, instead of the dialog Title so the padding stays ours  -->
        <Grid
            Grid.Row="0"
            Padding="12,8,12,8"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  title; Tight and TrimSideBearings start the visible text at the padding  -->
            <TextBlock
                x:Uid="ReleaseNotesDialog_WhatsNewText"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                OpticalMarginAlignment="TrimSideBearings"
                Style="{ThemeResource BodyLargeTextBlockStyle}"
                TextLineBounds="Tight" />

            <!--  close button  -->
            <Button
                x:Uid="ReleaseNotesDialog_CloseButton"
                Grid.Column="1"
                Width="36"
                Height="36"
                Margin="0,0,0,6"
                Padding="0"
                VerticalAlignment="Center"
                Click="CloseButton_Click"
                Style="{StaticResource SubtleBarButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
                <Button.KeyboardAccelerators>
                    <!--  (without a command bar ESC has no close button to map onto)  -->
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!--  content: a NavigationView driving a Frame, for the native page transition  -->
        <NavigationView
            x:Name="ReleaseNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="90"
            PaneDisplayMode="Left"
            SelectionChanged="ReleaseNav_SelectionChanged">

            <Grid>
                <!--  release page  -->
                <Frame x:Name="ReleaseFrame" />

                <!--  loading ring  -->
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />

                <!--  status text instead of the frame, offline or an empty catalog  -->
                <TextBlock
                    x:Name="StatusText"
                    Margin="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</ContentDialog>
