<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentSensors.Features.Start.ReleaseNotesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CloseButtonText="Close"
    Loaded="Dialog_Loaded"
    mc:Ignorable="d">

    <!--
        TEARDOWN STAGE 1
        stage 0 was already square at 24px of padding, where our content cannot reach a corner at all, so the
        content is not what squares it off

        that leaves the one structural thing this dialog did differently from every other dialog in the app: it
        carried no button text, which puts the template into NoneVisible and collapses CommandSpace
        the grid above CommandSpace then covers the whole dialog rather than its upper part, and that grid paints
        ContentDialogTopOverlay as a square fill and ContentDialogSeparatorThickness as a square 1px edge along
        its bottom, straight through both lower corners

        CloseButtonText above is what tests that, and nothing else changed; the X in the header is redundant for
        this build
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: title and close  -->
        <!--  (stands in for the dialogs own Title, so the padding stays ours)  -->
        <Grid
            Grid.Row="0"
            Padding="24,16,14,8"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="What's new" />

            <Button
                Grid.Column="1"
                Width="36"
                Height="36"
                Padding="0"
                VerticalAlignment="Top"
                Click="CloseButton_Click"
                Style="{ThemeResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
                <Button.KeyboardAccelerators>
                    <!--  (a dialog without a command bar has no close button for ESC to map onto)  -->
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!--  content: release navigation  -->
        <!--  (a real NavigationView driving a real Frame, which is what buys the native page transition)  -->
        <NavigationView
            x:Name="ReleaseNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="120"
            PaneDisplayMode="Left"
            SelectionChanged="ReleaseNav_SelectionChanged">

            <Grid>
                <Frame x:Name="ReleaseFrame" />

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="StatusText"
                    Margin="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</ContentDialog>
