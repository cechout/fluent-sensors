<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentSensors.Features.Start.ReleaseNotesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Dialog_Loaded"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <!--
        the style has to be named, it cannot be left to the platform: WinUI keys this style twice, once implicitly
        as TargetType ContentDialog and once as DefaultContentDialogStyle, and an implicit style only ever reaches
        its exact type
        this class derives from ContentDialog, so without the line above it never gets CornerRadius,
        BorderThickness, BorderBrush or CloseButtonStyle, while the template still arrives through DefaultStyleKey
        that is a dialog which looks entirely right and is square down to its buttons
    -->

    <ContentDialog.Resources>
        <!--
            no button text is set anywhere on this dialog, which puts the template into its NoneVisible state and
            collapses the whole command bar; the close affordance is the X in the header instead
            padding goes to zero so the header and the navigation pane reach the dialog edges, and the separator
            above the now-absent command bar would otherwise still draw
        -->
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>

        <!--
            the template paints this brush on the grid that carries the content, and at zero padding that grid
            covers the whole dialog rather than only the top of it
        -->
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
    </ContentDialog.Resources>

    <!--  (the size is applied in code, see ResizeToWindow)  -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: title and close  -->
        <!--  (stands in for the dialogs own Title, so the padding stays ours)  -->
        <Grid
            Grid.Row="0"
            Padding="12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  (Tight plus TrimSideBearings, so the visible text starts where the padding says it does)  -->
            <TextBlock
                VerticalAlignment="Center"
                OpticalMarginAlignment="TrimSideBearings"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="What's new"
                TextLineBounds="Tight" />

            <Button
                Grid.Column="1"
                Width="36"
                Height="36"
                Padding="0"
                VerticalAlignment="Center"
                Click="CloseButton_Click"
                Style="{ThemeResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
                <Button.KeyboardAccelerators>
                    <!--  (a dialog without a command bar has no close button for ESC to map onto)  -->
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!--  content: release navigation  -->
        <!--  (a real NavigationView driving a real Frame, which is what buys the native page transition)  -->
        <NavigationView
            x:Name="ReleaseNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="80"
            PaneDisplayMode="Left"
            SelectionChanged="ReleaseNav_SelectionChanged">

            <Grid>
                <Frame x:Name="ReleaseFrame" />

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="StatusText"
                    Margin="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</ContentDialog>
