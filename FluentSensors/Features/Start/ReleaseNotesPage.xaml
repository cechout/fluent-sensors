<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Start.ReleaseNotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  the release body inset  -->
        <Thickness x:Key="ReleaseContentPadding">24,16,24,28</Thickness>

        <!--  the full changelog label; the link button has its own style  -->
        <x:Double x:Key="ChangelogLabelFontSize">12</x:Double>
    </Page.Resources>

    <!--  (no padding here, a scroller clips it; the body carries the inset)  -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!--
                header image, edge to edge; scaled once to the physical pixels of the page width, and Fill at exactly
                that size maps one bitmap pixel onto one screen pixel (see RenderHeroAsync)
            -->
            <Image
                x:Name="HeroImage"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Stretch="Fill"
                Visibility="Collapsed" />

            <!--  release body: date, notes (the Grid only carries the padding)  -->
            <Grid Padding="{StaticResource ReleaseContentPadding}">
                <StackPanel Spacing="16">

                    <!--  release meta, no name (the header image carries it)  -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            x:Name="DateText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                        <HyperlinkButton
                            x:Name="GitHubLink"
                            x:Uid="ReleaseNotes_GitHubLink"
                            Style="{StaticResource SourceLinkButtonStyle}" />
                        <!--<HyperlinkButton x:Name="GitHubLink" Content="View on GitHub" />-->
                    </StackPanel>

                    <!--  release notes, a panel so callouts can be Borders  -->
                    <StackPanel x:Name="NotesHost" />

                    <!--  empty state  -->
                    <TextBlock
                        x:Name="EmptyText"
                        x:Uid="ReleaseNotes_EmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <!--
                        full changelog, the closing line lifted out by ExtractChangelogLink; the flush label ends the
                        indented bullets, the button names the compare range
                    -->
                    <StackPanel
                        x:Name="ChangelogRow"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Uid="ReleaseNotes_FullChangelogText"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource ChangelogLabelFontSize}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton
                            x:Name="ChangelogLink"
                            VerticalAlignment="Center"
                            Style="{StaticResource SourceLinkButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
