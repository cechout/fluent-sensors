<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Start.ReleaseNotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  the one knob for how far the release body sits from the dialog edges  -->
        <Thickness x:Key="ReleaseContentPadding">28,16,28,28</Thickness>
    </Page.Resources>

    <!--  (no padding on a scroller, it clips what it is meant to scroll; the body below carries the inset)  -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!--  header image  -->
            <!--  (edge to edge, which is why the inset sits on the body rather than on this panel)  -->
            <!--  (Uniform rather than UniformToFill, which crops a banner wider than the dialog on both sides)  -->
            <Border
                x:Name="HeroBorder"
                CornerRadius="0"
                Visibility="Collapsed">
                <Image
                    x:Name="HeroImage"
                    MaxHeight="200"
                    HorizontalAlignment="Stretch"
                    Stretch="Uniform" />
            </Border>

            <!--  release body  -->
            <!--  (a Grid around the panel, only so there is something with a Padding to hang the knob on)  -->
            <Grid Padding="{StaticResource ReleaseContentPadding}">
                <StackPanel Spacing="16">

                    <!--  release meta  -->
                    <!--  (no release name, the header image carries it in every release)  -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            x:Name="DateText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                        <HyperlinkButton
                            x:Name="GitHubLink"
                            Content="View on GitHub"
                            Style="{StaticResource SourceLinkButtonStyle}" />
                    </StackPanel>

                    <!--  release notes  -->
                    <!--  (a panel rather than a RichTextBlock, so callouts can be real Borders)  -->
                    <StackPanel x:Name="NotesHost" />

                    <TextBlock
                        x:Name="EmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="This release was published without notes"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
