<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Start.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentSensors.Features.Start"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <!--  capped rather than stretched, unlike the settings page: the snapshot rows below read badly once  -->
        <!--  they run the full width of a wide monitor  -->
        <StackPanel
            MaxWidth="1000"
            Margin="20"
            HorizontalAlignment="Left"
            Spacing="4">

            <!--  app title and running version  -->
            <StackPanel
                Margin="4,0,0,12"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Fluent Sensors" />
                <TextBlock
                    x:Name="VersionTextBlock"
                    Margin="0,0,0,3"
                    VerticalAlignment="Bottom"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{ThemeResource BodyTextBlockStyle}" />
            </StackPanel>


            <!--  release notes and update state  -->
            <!--
                two separate jobs on purpose: the left button only ever reads out what changed, the right one is
                the only thing that offers to install anything
                a WrapPanel rather than two fixed columns, so a narrow window stacks them instead of clipping
            -->
            <controls:WrapPanel
                Margin="0,0,0,8"
                HorizontalSpacing="8"
                VerticalSpacing="8">

                <!--  what is new in the latest release  -->
                <Button Padding="12,10" Style="{ThemeResource SubtleButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Source="/Assets/Icon/Icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="What's new" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ReleaseNotesSubtitle, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Button.Flyout>
                        <!--  the presenter scrolls nothing itself, the control inside brings its own scroller  -->
                        <Flyout Opening="ReleaseNotesFlyout_Opening" Placement="Bottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="470" />
                                    <Setter Property="Padding" Value="16" />
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <local:ReleaseNotesControl x:Name="ReleaseNotes" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--  update state; what a click does depends on the state, see UpdateStatusButton_Click  -->
                <Button
                    Padding="12,10"
                    Click="UpdateStatusButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsUpdateActionEnabled, Mode=OneWay}"
                    Style="{ThemeResource SubtleButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  badge and progress ring swap places, they never show at the same time  -->
                        <Grid
                            Grid.Column="0"
                            Width="36"
                            Height="36">
                            <Border
                                Width="24"
                                Height="24"
                                Background="{x:Bind ViewModel.UpdateBadgeBrush, Mode=OneWay}"
                                CornerRadius="12"
                                Visibility="{x:Bind InverseBoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="{x:Bind ViewModel.UpdateBadgeGlyph, Mode=OneWay}" />
                            </Border>
                            <ProgressRing
                                Width="22"
                                Height="22"
                                IsActive="{x:Bind ViewModel.IsUpdateChecking, Mode=OneWay}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}" />
                        </Grid>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpdateStatusTitle, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpdateStatusDescription, Mode=OneWay}"
                                Visibility="{x:Bind HasText(ViewModel.UpdateStatusDescription), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </controls:WrapPanel>


            <!--  system snapshot  -->
            <!--
                static machine facts, built once in the view model; the icon, colour and category label per row
                come from HardwareGroupInfo, the same profile the sensor list and the hardware view use
            -->
            <TextBlock
                Margin="4,8,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="System" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">

                <ItemsControl Padding="4,8" ItemsSource="{x:Bind ViewModel.SystemSnapshot}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SystemSnapshotEntry">

                            <Grid Padding="12,8" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Top"
                                    FontSize="20"
                                    Foreground="{x:Bind IconBrush}"
                                    Glyph="{x:Bind IconGlyph}" />

                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Category}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap" />

                                    <!--  the facts themselves, wrapped so a narrow window reflows instead of clipping  -->
                                    <ItemsControl Margin="0,3,0,0" ItemsSource="{x:Bind Details}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
