<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Start.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:local="using:FluentSensors.Features.Start"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  (the header exports are 2560x1317, so 150 wide lands on 77 high; the update button matches that height)  -->
        <x:Double x:Key="StartHeroWidth">150</x:Double>
        <x:Double x:Key="StartHeroHeight">77</x:Double>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: app title and release-button + check-for-updates-button  -->
        <!--  (the inset is padding inside the border, so the divider line reaches both window edges)  -->
        <Border
            Grid.Row="0"
            Padding="20,20,20,12"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <!--
                (left aligned the same way the scrolled content is, which is what keeps the update button
                beside its neighbour instead of out at the window edge)
            -->
            <StackPanel HorizontalAlignment="Left" Spacing="4">

                <!--  app title and version  -->
                <StackPanel
                    Margin="4,0,0,12"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Fluent Sensors" />
                    <TextBlock
                        x:Name="VersionTextBlock"
                        Margin="0,0,0,3"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{ThemeResource BodyTextBlockStyle}" />
                </StackPanel>


                <!--  release-button and check-for-updates-button  -->
                <!--
                    the left button only reads out what changed, the right one is the only thing that offers to
                    install anything; both carry the same MinHeight so they read as a pair
                    (MaxWidth is the two column widths plus the spacing, the star weights hold that ratio while the
                    window narrows, and both buttons trim their text instead of wrapping)
                -->
                <Grid
                    MaxWidth="628"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340*" />
                        <ColumnDefinition Width="280*" />
                    </Grid.ColumnDefinitions>

                    <!--  whats new button  -->
                    <!--  (no left padding, the image sits flush against the button edge the way the hover fill does)  -->
                    <Button
                        Grid.Column="0"
                        Padding="0,0,18,0"
                        Click="ReleaseNotesButton_Click"
                        Style="{ThemeResource SubtleButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  hero image  -->
                            <!--
                                (an ImageBrush rather than a child Image: a background is clipped by the corner
                                radius for certain, and the fixed pair keeps the export at its own 2560x1317 ratio
                                the source is assigned in code, one file per theme, see ApplyHeroImage)
                            -->
                            <Border
                                x:Name="HeroBorder"
                                Grid.Column="0"
                                Width="{StaticResource StartHeroWidth}"
                                Height="{StaticResource StartHeroHeight}"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Border.Background>
                                    <ImageBrush x:Name="HeroBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="What's new"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ReleaseNotesSubtitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!--  update state button  -->
                    <!--  (what a click does depends on the state, see UpdateStatusButton_Click)  -->
                    <Button
                        Grid.Column="1"
                        MinHeight="{StaticResource StartHeroHeight}"
                        Padding="18,0"
                        Click="UpdateStatusButton_Click"
                        IsEnabled="{x:Bind ViewModel.IsUpdateActionEnabled, Mode=OneWay}"
                        Style="{ThemeResource SubtleButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  state badge and progress ring  -->
                            <!--
                                these two never show at the same time, and they sit directly in the column rather than
                                in a fixed-size wrapper: a 24px badge centred in a 36px box reads as 6px of padding the
                                neighbouring button does not have
                            -->
                            <Border
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Background="{x:Bind ViewModel.UpdateBadgeBrush, Mode=OneWay}"
                                CornerRadius="12"
                                Visibility="{x:Bind InverseBoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="{x:Bind ViewModel.UpdateBadgeGlyph, Mode=OneWay}" />
                            </Border>
                            <ProgressRing
                                Grid.Column="0"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsUpdateChecking, Mode=OneWay}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UpdateStatusTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UpdateStatusDescription, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind HasText(ViewModel.UpdateStatusDescription), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                Margin="20"
                HorizontalAlignment="Left"
                Spacing="4">

                <!--  content: system snapshot  -->
                <!--
                    one tile per device, with icon, colour and category label from HardwareGroupInfo, the same profile
                    the sensor list and the hardware view use
                    All tiles are placed in a SquareGridPanel
                -->
                <TextBlock
                    Margin="4,8,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="System" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.SystemSnapshot}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <fhControls:SquareGridPanel MinCellWidth="240" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SystemSnapshotEntry">

                            <!--  (no padding on the card itself, the divider has to reach both edges)  -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">

                                <!--
                                    (SquareGridPanel gives every tile in a row the height of the tallest one,
                                    so the Star row is what pushes the button down onto the card edge)
                                -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">

                                        <!--  tile header  -->
                                        <!--  (category over device name, the fact idiom SensorTileControl uses)  -->
                                        <Grid Margin="16,14,16,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  (no alignment set, so it centres across both lines like the hardware start view)  -->
                                            <FontIcon
                                                Grid.Column="0"
                                                FontSize="20"
                                                Foreground="{x:Bind IconBrush}"
                                                Glyph="{x:Bind IconGlyph}" />

                                            <!--  (the Star column is what gives the trimming below a width to trim against)  -->
                                            <StackPanel Grid.Column="1" Spacing="0">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Category}" />
                                                <TextBlock
                                                    Style="{ThemeResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    ToolTipService.ToolTip="{x:Bind Title}" />
                                            </StackPanel>
                                        </Grid>

                                        <!--  static facts  -->
                                        <!--  (wrapped, so a narrow tile reflows instead of clipping)  -->
                                        <ItemsControl Margin="16,10,16,14" ItemsSource="{x:Bind Details}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">

                                        <!--  divider  -->
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!--  sensor count button  -->
                                        <!--  (opens this hardware group on the sensors page, disabled when there is none)  -->
                                        <Button
                                            Padding="16,10"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="SensorCount_Click"
                                            CornerRadius="0,0,4,4"
                                            IsEnabled="{x:Bind HasSensors, Mode=OneWay}"
                                            Style="{StaticResource SubtleBarButtonStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Glyph="&#xECAA;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind SensorCountText, Mode=OneWay}" />
                                                <FontIcon
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Glyph="&#xE76C;" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <!--  content: app status  -->
                <!--
                    fed by AppStatusService, the same snapshot the title bar readout runs on, so the two always agree
                    carded with the same recipe as the system snapshot above, so the page reads as one board
                    instead of a board with a loose paragraph under it
                -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="App Status" />

                <!--
                    (MaxWidth is the two 300 wide cards plus the 8 spacing; without it the star columns would push
                    them apart on a wide window, and Auto columns would clip instead of shrink on a narrow one)
                -->
                <Grid
                    MaxWidth="608"
                    HorizontalAlignment="Left"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  lhm group  -->
                    <!--  (the inset sits on the panel, nothing in this card has to reach its edge)  -->
                    <Border
                        Grid.Column="0"
                        MaxWidth="300"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Margin="16,14,16,14" Spacing="6">
                            <fhInfoPopup:InfoPopupControl
                                Title="LibreHardwareMonitor"
                                Description="Found Sensors - every sensor LibreHardwareMonitor reports on this machine&#10;Rendering Sensors - how many of them are actively drawn right now&#10;LibreHardwareMonitorLib is the largest and most established hardware monitoring library for Windows"
                                PlacementMode="Above"
                                SourceIntro="This App is powered by the open source LibreHardwareMonitor project:"
                                TitleTextTrimming="CharacterEllipsis">
                                <fhInfoPopup:InfoPopupControl.SourceLinks>
                                    <fhInfoPopup:SourceLink Label="LibreHardwareMonitor on GitHub" Url="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                                </fhInfoPopup:InfoPopupControl.SourceLinks>
                            </fhInfoPopup:InfoPopupControl>

                            <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Found Sensors" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SensorsFoundText, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Rendering Sensors" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SensorsRenderedText, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <!--  this app group  -->
                    <!--  (this apps own usage rather than the machines, which is what the flyout spells out)  -->
                    <Border
                        Grid.Column="1"
                        MaxWidth="300"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Margin="16,14,16,14" Spacing="6">
                            <fhInfoPopup:InfoPopupControl
                                Title="This App"
                                Description="CPU Usage - this app's own CPU time relative to total capacity across all cores&#10;RAM Usage - physical memory currently mapped by this app (working set)"
                                PlacementMode="Above"
                                SourceIntro="Source:"
                                TitleTextTrimming="CharacterEllipsis">
                                <fhInfoPopup:InfoPopupControl.SourceLinks>
                                    <fhInfoPopup:SourceLink Label="Windows Process API" Url="https://learn.microsoft.com/en-us/dotnet/api/system.diagnostics.process" />
                                </fhInfoPopup:InfoPopupControl.SourceLinks>
                            </fhInfoPopup:InfoPopupControl>

                            <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="CPU usage" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CpuTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="RAM usage" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.RamTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>


                <!--  content: about and open source  -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="About &amp; Open Source" />

                <!--  revisit: flat about section  -->
                <!--
                    the expanders here are toggled by hand while the flat link row is being tried out
                    the app data folder button and the third-party list have no home in that row yet
                -->

                <!--  app info  -->
                <controls:SettingsExpander
                    Description="© 2026 Daniel Čech. All rights reserved."
                    Header="Fluent Sensors"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xE946;}"
                    Visibility="Collapsed">

                    <TextBlock
                        x:Name="AboutVersionTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />

                    <controls:SettingsExpander.Items>
                        <!--  (the repository is the documentation, so it appears here once and nowhere else)  -->
                        <controls:SettingsCard Description="Readme, usage and the full source" Header="Documentation">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout/fluent-sensors" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Description="Open a new issue on the project" Header="Report a bug">
                            <HyperlinkButton Content="GitHub Issues" NavigateUri="https://github.com/cechout/fluent-sensors/issues/new" />
                        </controls:SettingsCard>

                        <!--  (the settings and sensor state json files; a portable build keeps them next to the exe)  -->
                        <controls:SettingsCard Description="Where settings and sensor state are stored" Header="App data folder">
                            <Button Click="OpenAppDataFolder_Click">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="Open" />
                                </Grid>
                            </Button>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Developer Profile">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  support  -->
                <!--  (the only place in the app that asks for anything)  -->
                <controls:SettingsExpander
                    Description="Fluent Sensors is free and open source"
                    Header="Support the Project"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xEB51;}"
                    Visibility="Collapsed">

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Description="Recurring or one-off, through GitHub" Header="Sponsor on GitHub">
                            <HyperlinkButton Content="GitHub Sponsors" NavigateUri="https://github.com/sponsors/cechout" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  third-party libraries  -->
                <controls:SettingsExpander
                    Description="Open source projects used in this app"
                    Header="Third-Party Libraries"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xE8F1;}"
                    Visibility="Visible">

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Windows App SDK">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Windows Community Toolkit">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/CommunityToolkit/WindowsCommunityToolkit" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="WinUIEx">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/dotMorten/WinUIEx" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="LiveCharts2">
                            <HyperlinkButton Content="Website" NavigateUri="https://livecharts.dev/" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="LibreHardwareMonitor">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="H.NotifyIcon">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/HavenDV/H.NotifyIcon" />
                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  quick links  -->
                <!--  (the same four destinations the collapsed expanders above carry)  -->
                <controls:WrapPanel
                    Margin="0,4,0,8"
                    HorizontalSpacing="4"
                    VerticalSpacing="0">
                    <HyperlinkButton Content="Documentation" NavigateUri="https://github.com/cechout/fluent-sensors" />
                    <HyperlinkButton Content="Bug Report" NavigateUri="https://github.com/cechout/fluent-sensors/issues/new" />
                    <HyperlinkButton Content="Developer Profile" NavigateUri="https://github.com/cechout" />
                    <HyperlinkButton Content="GitHub Sponsoring" NavigateUri="https://github.com/sponsors/cechout" />
                </controls:WrapPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
