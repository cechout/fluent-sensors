<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Start.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:local="using:FluentSensors.Features.Start"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  (frame1.png is 2560x1317, so 150 wide lands on 77 high; the update button matches that height)  -->
        <x:Double x:Key="StartHeroWidth">150</x:Double>
        <x:Double x:Key="StartHeroHeight">77</x:Double>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            Margin="20"
            HorizontalAlignment="Left"
            Spacing="4">

            <!--  header: app title and version  -->
            <StackPanel
                Margin="4,0,0,12"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Fluent Sensors" />
                <TextBlock
                    x:Name="VersionTextBlock"
                    Margin="0,0,0,3"
                    VerticalAlignment="Bottom"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{ThemeResource BodyTextBlockStyle}" />
            </StackPanel>


            <!--  header: release notes and update state  -->
            <!--
                two separate jobs on purpose: the left button only ever reads out what changed, the right one is
                the only thing that offers to install anything
                both carry the same MinHeight and inner spacing so they read as a pair, and the hero image is what
                sets that height
            -->
            <controls:WrapPanel
                Margin="0,8,0,8"
                HorizontalSpacing="8"
                VerticalSpacing="8">

                <!--  whats new button  -->
                <!--  (no left padding, the image sits flush against the button edge the way the hover fill does)  -->
                <Button
                    Padding="0,0,18,0"
                    Click="ReleaseNotesButton_Click"
                    Style="{ThemeResource SubtleButtonStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  hero image  -->
                        <!--  (Width alone, no Height: letting the image derive its own keeps the ratio exact)  -->
                        <Border Grid.Column="0" CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Image Width="{StaticResource StartHeroWidth}" Source="/Assets/Pictures/frame1.png" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="What's new" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ReleaseNotesSubtitle, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!--  update state button  -->
                <!--  (what a click does depends on the state, see UpdateStatusButton_Click)  -->
                <Button
                    MinHeight="{StaticResource StartHeroHeight}"
                    Padding="18,0"
                    Click="UpdateStatusButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsUpdateActionEnabled, Mode=OneWay}"
                    Style="{ThemeResource SubtleButtonStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  state badge and progress ring  -->
                        <!--
                            these two never show at the same time, and they sit directly in the column rather than
                            in a fixed-size wrapper: a 24px badge centred in a 36px box reads as 6px of padding the
                            neighbouring button does not have
                        -->
                        <Border
                            Grid.Column="0"
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            Background="{x:Bind ViewModel.UpdateBadgeBrush, Mode=OneWay}"
                            CornerRadius="12"
                            Visibility="{x:Bind InverseBoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="{x:Bind ViewModel.UpdateBadgeGlyph, Mode=OneWay}" />
                        </Border>
                        <ProgressRing
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsUpdateChecking, Mode=OneWay}"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.UpdateStatusTitle, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpdateStatusDescription, Mode=OneWay}"
                                Visibility="{x:Bind HasText(ViewModel.UpdateStatusDescription), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </controls:WrapPanel>


            <!--  content: system snapshot  -->
            <!--
                one tile per device, with icon, colour and category label from HardwareGroupInfo, the same profile
                the sensor list and the hardware view use
                the tiles are deliberately not buttons: nothing here navigates, so there is no hover state to
                promise something that does not happen; what is dynamic is the layout, SquareGridPanel gives up a
                column at a time as the window narrows
            -->
            <TextBlock
                Margin="4,8,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="System" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.SystemSnapshot}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <fhControls:SquareGridPanel MinCellWidth="240" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SystemSnapshotEntry">

                        <!--  (no padding on the card itself, the divider has to reach both edges)  -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">

                            <!--  (SquareGridPanel gives every tile in a row the height of the tallest one,  -->
                            <!--  so the Star row is what pushes the button down onto the card edge)  -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">

                                <!--  tile header  -->
                                <!--  (category over device name, the fact idiom SensorTileControl uses)  -->
                                <Grid Margin="16,14,16,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  (no alignment set, so it centres across both lines like the hardware start view)  -->
                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="20"
                                        Foreground="{x:Bind IconBrush}"
                                        Glyph="{x:Bind IconGlyph}" />

                                    <!--  (the Star column is what gives the trimming below a width to trim against)  -->
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Category}" />
                                        <TextBlock
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind Title}" />
                                    </StackPanel>
                                </Grid>

                                <!--  static facts  -->
                                <!--  (wrapped, so a narrow tile reflows instead of clipping)  -->
                                <ItemsControl Margin="16,10,16,14" ItemsSource="{x:Bind Details}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                </StackPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">

                                <!--  divider  -->
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!--  sensor count button  -->
                                <!--  (opens this hardware group on the sensors page, disabled when there is none)  -->
                                <Button
                                    Padding="16,10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Click="SensorCount_Click"
                                    CornerRadius="0,0,4,4"
                                    IsEnabled="{x:Bind HasSensors, Mode=OneWay}"
                                    Style="{StaticResource SubtleBarButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Glyph="&#xECAA;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind SensorCountText, Mode=OneWay}" />
                                        <FontIcon
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Glyph="&#xE76C;" />
                                    </Grid>
                                </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <!--  content: app status  -->
            <!--
                fed by AppStatusService, the same snapshot the title bar readout runs on, so the two always agree
                label and value follow SensorTileControl: a caption in the secondary brush over a BodyLarge value
                with tabular numerals, so a digit change never shifts the text
            -->
            <TextBlock
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="App Status" />

            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">

                <!--  sensor counts  -->
                <Border
                    Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel MinWidth="74" Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Found Sensors" />
                            <TextBlock
                                Style="{ThemeResource BodyLargeTextBlockStyle}"
                                Text="{x:Bind ViewModel.SensorsFoundText, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                        </StackPanel>

                        <StackPanel MinWidth="74" Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Rendering Sensors" />
                            <TextBlock
                                Style="{ThemeResource BodyLargeTextBlockStyle}"
                                Text="{x:Bind ViewModel.SensorsRenderedText, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    MinWidth="140"
                    Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="CPU usage" />
                        <TextBlock
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.CpuTileValue, Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>

                <Border
                    MinWidth="140"
                    Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="RAM usage" />
                        <TextBlock
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.RamTileValue, Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>
            </controls:WrapPanel>


            <!--  content: about and open source  -->
            <TextBlock
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About &amp; Open Source" />

            <controls:SettingsExpander
                Description="© 2026 Daniel Čech. All rights reserved."
                Header="Fluent Sensors"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE946;}">

                <TextBlock
                    x:Name="AboutVersionTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True" />

                <controls:SettingsExpander.Items>
                    <!--  (the repository is the documentation, so it appears here once and nowhere else)  -->
                    <controls:SettingsCard Description="Readme, usage and the full source" Header="Documentation">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout/fluent-sensors" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Open a new issue on the project" Header="Report a bug">
                        <HyperlinkButton Content="GitHub Issues" NavigateUri="https://github.com/cechout/fluent-sensors/issues/new" />
                    </controls:SettingsCard>

                    <!--  (the settings and sensor state json files; a portable build keeps them next to the exe)  -->
                    <controls:SettingsCard Description="Where settings and sensor state are stored" Header="App data folder">
                        <Button Click="OpenAppDataFolder_Click" Content="Open" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Developer Profile">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  support  -->
            <!--  (the only place in the app that asks for anything)  -->
            <controls:SettingsExpander
                Description="Fluent Sensors is free and open source"
                Header="Support the Project"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xEB51;}">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="Recurring or one-off, through GitHub" Header="Sponsor on GitHub">
                        <HyperlinkButton Content="GitHub Sponsors" NavigateUri="https://github.com/sponsors/cechout" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Description="Open source projects used in this app"
                Header="Third-Party Libraries"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE8F1;}">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Windows App SDK">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Windows Community Toolkit">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/CommunityToolkit/WindowsCommunityToolkit" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="WinUIEx">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/dotMorten/WinUIEx" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="LiveCharts2">
                        <HyperlinkButton Content="Website" NavigateUri="https://livecharts.dev/" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="LibreHardwareMonitor">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="H.NotifyIcon">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/HavenDV/H.NotifyIcon" />
                    </controls:SettingsCard>

                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
