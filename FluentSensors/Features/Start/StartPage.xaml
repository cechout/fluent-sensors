<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Start.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:local="using:FluentSensors.Features.Start"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  (the 2560x1317 header exports at 150 wide are 77 high; the update button matches)  -->
        <x:Double x:Key="StartHeroWidth">150</x:Double>
        <x:Double x:Key="StartHeroHeight">77</x:Double>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: app title and release-button + check-for-updates-button  -->
        <!--  (the inset is padding inside the border, so the divider reaches both window edges)  -->
        <Border
            Grid.Row="0"
            Padding="20,20,20,12"
            fhUi:FocusGroup.IsEnabled="True"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <!--  (left aligned like the scrolled content, so the update button stays beside its neighbour)  -->
            <StackPanel HorizontalAlignment="Left" Spacing="4">

                <!--  app title, version and copy-version-button  -->
                <StackPanel
                    Margin="4,0,0,12"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Fluent Sensors" />

                    <StackPanel
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="2">
                        <TextBlock
                            x:Name="VersionTextBlock"
                            Margin="0,0,0,3"
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{ThemeResource BodyTextBlockStyle}" />

                        <!--  copy version button  -->
                        <!--  (a checkmark for a moment once copied, see CopyVersionButton_Click)  -->
                        <Button
                            x:Uid="Start_CopyVersionButton"
                            Width="24"
                            Height="24"
                            Margin="0,0,0,0"
                            Padding="0"
                            VerticalAlignment="Bottom"
                            Click="CopyVersionButton_Click"
                            Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon
                                x:Name="CopyVersionIcon"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8C8;" />
                        </Button>
                    </StackPanel>
                </StackPanel>


                <!--  release-button and check-for-updates-button  -->
                <!--
                    (the left one reads out what changed, only the right one offers to install; one MinHeight, so
                    they pair; MaxWidth is both columns plus the spacing, the star weights keep the ratio and the
                    text trims)
                -->
                <Grid
                    MaxWidth="628"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340*" />
                        <ColumnDefinition Width="280*" />
                    </Grid.ColumnDefinitions>

                    <!--  whats new button  -->
                    <!--  (no left padding, the image sits flush with the button edge like the hover fill)  -->
                    <Button
                        Grid.Column="0"
                        Padding="0,0,18,0"
                        Click="ReleaseNotesButton_Click"
                        Style="{StaticResource SubtleTileButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  hero image  -->
                            <!--
                                (an ImageBrush, a background is clipped by the corner radius; the fixed pair keeps
                                the 2560x1317 ratio; the source is set in code per theme, see ApplyHeroImage)
                            -->
                            <Border
                                x:Name="HeroBorder"
                                Grid.Column="0"
                                Width="{StaticResource StartHeroWidth}"
                                Height="{StaticResource StartHeroHeight}"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Border.Background>
                                    <ImageBrush x:Name="HeroBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    x:Uid="Start_WhatsNewText"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ReleaseNotesSubtitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!--  update state button  -->
                    <!--  (a click depends on the state, see UpdateStatusButton_Click)  -->
                    <Button
                        Grid.Column="1"
                        MinHeight="{StaticResource StartHeroHeight}"
                        Padding="18,0"
                        Click="UpdateStatusButton_Click"
                        IsEnabled="{x:Bind ViewModel.IsUpdateActionEnabled, Mode=OneWay}"
                        Style="{StaticResource SubtleTileButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  state badge and progress ring  -->
                            <!--
                                (never shown together; directly in the column, a fixed box would read as padding the
                                neighbouring button does not have)
                            -->
                            <Border
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Background="{x:Bind ViewModel.UpdateBadgeBrush, Mode=OneWay}"
                                CornerRadius="12"
                                Visibility="{x:Bind InverseBoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="{x:Bind ViewModel.UpdateBadgeGlyph, Mode=OneWay}" />
                            </Border>
                            <ProgressRing
                                Grid.Column="0"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsUpdateChecking, Mode=OneWay}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UpdateStatusTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UpdateStatusDescription, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind HasText(ViewModel.UpdateStatusDescription), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                Margin="20"
                HorizontalAlignment="Left"
                Spacing="4">

                <!--  content: system snapshot  -->
                <!--
                    one tile per device, with icon, colour and category label from HardwareGroupInfo, the same profile
                    the sensor list and the hardware view use
                    all tiles are placed in a SquareGridPanel
                -->
                <TextBlock
                    x:Uid="Start_SystemText"
                    Margin="4,4,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <ItemsControl fhUi:FocusGroup.IsEnabled="True" ItemsSource="{x:Bind ViewModel.SystemSnapshot}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <fhControls:SquareGridPanel MinCellWidth="240" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SystemSnapshotEntry">

                            <!--  (no padding on the card itself, the divider has to reach both edges)  -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">

                                <!--
                                    (a row of tiles takes the tallest height, the Star row pushes
                                    the button onto the card edge)
                                -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">

                                        <!--  tile header  -->
                                        <!--  (category over device name, like SensorTileControl)  -->
                                        <Grid Margin="16,14,16,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  (centred across both lines, like the hardware start view)  -->
                                            <FontIcon
                                                Grid.Column="0"
                                                FontSize="20"
                                                Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                                Glyph="{x:Bind IconGlyph}" />

                                            <!--  (the Star column gives the trimming a width)  -->
                                            <StackPanel Grid.Column="1" Spacing="0">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Category}" />
                                                <TextBlock
                                                    Style="{ThemeResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    ToolTipService.ToolTip="{x:Bind Title}" />
                                            </StackPanel>
                                        </Grid>

                                        <!--  static facts  -->
                                        <!--  (wrapped, so a narrow tile reflows instead of clipping)  -->
                                        <ItemsControl Margin="16,16,16,12" ItemsSource="{x:Bind Details}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">

                                        <!--  divider  -->
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!--  sensor count button  -->
                                        <!--  (opens the hardware group on the sensors page; disabled without one)  -->
                                        <Button
                                            Padding="16,10"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="SensorCount_Click"
                                            CornerRadius="0,0,4,4"
                                            IsEnabled="{x:Bind HasSensors, Mode=OneWay}"
                                            Style="{StaticResource SubtleBarButtonStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Glyph="&#xECAA;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind SensorCountText, Mode=OneWay}" />
                                                <FontIcon
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Glyph="&#xE76C;" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <!--  content: app status  -->
                <!--
                    (AppStatusService, the snapshot of the title bar readout, so both agree; carded like the system
                    snapshot, so the page reads as one board)
                -->
                <TextBlock
                    x:Uid="Start_AppStatusText"
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <!--  (a row takes the tallest card, so the three read as one board; MaxWidth is three 300 wide cards)  -->
                <fhControls:SquareGridPanel
                    MaxWidth="916"
                    HorizontalAlignment="Left"
                    fhUi:FocusGroup.IsEnabled="True"
                    MinCellWidth="240"
                    Spacing="8">

                    <!--  lhm group  -->
                    <!--  (the inset sits on the panel, nothing in this card has to reach its edge)  -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Margin="16,14,16,14" Spacing="6">
                            <fhInfoPopup:InfoPopupControl
                                x:Uid="Start_LhmPopup"
                                Title="LibreHardwareMonitor"
                                PlacementMode="Above"
                                TitleTextTrimming="CharacterEllipsis">
                                <fhInfoPopup:InfoPopupControl.SourceLinks>
                                    <fhInfoPopup:SourceLink x:Uid="Start_LhmGitHubSource" Url="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                                </fhInfoPopup:InfoPopupControl.SourceLinks>
                            </fhInfoPopup:InfoPopupControl>

                            <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_FoundSensorsText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SensorsFoundText, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_RenderingSensorsText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SensorsRenderedText, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_UpdateIntervalText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.UpdateIntervalTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_ReadTimeText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.ReadTimeTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_PawnIoText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.PawnIoTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <!--  this app group  -->
                    <!--  (the usage of this app, not of the machine, as the flyout spells out)  -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Margin="16,14,16,14" Spacing="6">
                            <fhInfoPopup:InfoPopupControl
                                x:Uid="Start_ThisAppPopup"
                                PlacementMode="Above"
                                TitleTextTrimming="CharacterEllipsis">
                                <fhInfoPopup:InfoPopupControl.SourceLinks>
                                    <fhInfoPopup:SourceLink Label="Windows Process API" Url="https://learn.microsoft.com/en-us/dotnet/api/system.diagnostics.process" />
                                </fhInfoPopup:InfoPopupControl.SourceLinks>
                            </fhInfoPopup:InfoPopupControl>

                            <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_CPUUsageText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CpuTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_RAMUsageText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.RamTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_GcMemoryText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.GcMemoryTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_HandlesText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.HandlesTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <!--  (ticks on its own timer, not with the status snapshot, see StartPage)  -->
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_UptimeText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.UptimeTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <!--  graphics group  -->
                    <!--
                        (the gpu of this app; on a hybrid laptop rendering on the discrete gpu every frame is copied to the
                        one driving the screen, the link leads to where the user picks the gpu)
                    -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Margin="16,14,16,14" Spacing="6">
                            <fhInfoPopup:InfoPopupControl
                                x:Uid="Start_GraphicsPopup"
                                PlacementMode="Above"
                                TitleTextTrimming="CharacterEllipsis">
                                <fhInfoPopup:InfoPopupControl.SourceLinks>
                                    <fhInfoPopup:SourceLink Label="Windows GPU performance counters" Url="https://devblogs.microsoft.com/directx/gpus-in-the-task-manager/" />
                                </fhInfoPopup:InfoPopupControl.SourceLinks>
                            </fhInfoPopup:InfoPopupControl>

                            <!--  (on its own line, the name is long; the hint below refers to it)  -->
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Uid="Start_RunningOnText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.GpuAdapterTileValue, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.GpuAdapterTileValue, Mode=OneWay}" />
                            </StackPanel>

                            <!--  (wording and look still open)  -->
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.IsGpuNotDisplay, Mode=OneWay}">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE7BA;" />
                                <TextBlock x:Uid="Start_GpuNotDisplayText" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <!--  (the info popup link style, under the gpu it is about)  -->
                            <HyperlinkButton
                                x:Uid="Start_GraphicsSettingsLink"
                                Margin="-7,0,0,2"
                                Click="GraphicsSettingsLink_Click"
                                Style="{StaticResource SourceLinkButtonStyle}" />

                            <!--  (the top margin makes the gap to the line above the 8 of the wrapped rows)  -->
                            <controls:WrapPanel
                                Margin="0,2,0,0"
                                HorizontalSpacing="24"
                                VerticalSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_GpuUsageText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.GpuUsageTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_GpuMemoryText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.GpuMemoryTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </fhControls:SquareGridPanel>


                <!--  content: about and open source  -->
                <TextBlock
                    x:Uid="Start_AboutOpenSourceText"
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <!--  revisit: flat about section  -->
                <!--
                    the expanders are toggled by hand while the flat link row is tried out; the third-party list
                    has no place in that row yet
                -->

                <!--  app info  -->
                <controls:SettingsExpander
                    fhUi:FocusGroup.IsEnabled="True"
                    Description="© 2026 Daniel Čech · MIT License"
                    Header="Fluent Sensors"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xE946;}"
                    Visibility="Collapsed">

                    <TextBlock
                        x:Name="AboutVersionTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />

                    <controls:SettingsExpander.Items>
                        <!--  (the repository is the documentation, so it appears here once and nowhere else)  -->
                        <controls:SettingsCard x:Uid="Start_DocumentationCard">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout/fluent-sensors" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="Start_FeedbackOnGitHubCard">
                            <HyperlinkButton Content="GitHub Issues" NavigateUri="https://github.com/cechout/fluent-sensors/issues/new/choose" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="Start_DeveloperProfileCard">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  support  -->
                <!--  (the only place in the app that asks for anything)  -->
                <controls:SettingsExpander
                    x:Uid="Start_SupportTheProjectExpander"
                    fhUi:FocusGroup.IsEnabled="True"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xEB51;}"
                    Visibility="Collapsed">

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="Start_ReviewOnMicrosoftStoreCard" Visibility="{x:Bind BoolToVisibility(IsStoreBuild)}">
                            <HyperlinkButton Click="StoreReviewLink_Click" Content="Microsoft Store" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="Start_SponsorOnGitHubCard">
                            <HyperlinkButton Content="GitHub Sponsors" NavigateUri="https://github.com/sponsors/cechout" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  third-party libraries  -->
                <controls:SettingsExpander
                    x:Uid="Start_ThirdPartyLibrariesExpander"
                    fhUi:FocusGroup.IsEnabled="True"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xE8F1;}"
                    Visibility="Visible">

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Windows App SDK">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Windows Community Toolkit">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/CommunityToolkit/Windows" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="WinUIEx">
