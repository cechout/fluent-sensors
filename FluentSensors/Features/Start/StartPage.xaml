<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Start.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:local="using:FluentSensors.Features.Start"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  (the 2560x1317 header exports at 150 wide are 77 high; the update button matches)  -->
        <x:Double x:Key="StartHeroWidth">150</x:Double>
        <x:Double x:Key="StartHeroHeight">77</x:Double>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: app title and release-button + check-for-updates-button  -->
        <!--  (the inset is padding inside the border, so the divider reaches both window edges)  -->
        <Border
            Grid.Row="0"
            Padding="20,20,20,12"
            fhUi:FocusGroup.IsEnabled="True"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <!--  (left aligned like the scrolled content, so the update button stays beside its neighbour)  -->
            <StackPanel HorizontalAlignment="Left" Spacing="4">

                <!--  app title, version and copy-version-button  -->
                <StackPanel
                    Margin="4,0,0,12"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Fluent Sensors" />

                    <StackPanel
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="2">
                        <TextBlock
                            x:Name="VersionTextBlock"
                            Margin="0,0,0,3"
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{ThemeResource BodyTextBlockStyle}" />

                        <!--  copy version button  -->
                        <!--  (a checkmark for a moment once copied, see CopyVersionButton_Click)  -->
                        <Button
                            Width="24"
                            Height="24"
                            Margin="0,0,0,0"
                            Padding="0"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="Copy Version"
                            Click="CopyVersionButton_Click"
                            Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon
                                x:Name="CopyVersionIcon"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8C8;" />
                        </Button>
                    </StackPanel>
                </StackPanel>


                <!--  release-button and check-for-updates-button  -->
                <!--
                    (the left one reads out what changed, only the right one offers to install; one MinHeight, so
                    they pair; MaxWidth is both columns plus the spacing, the star weights keep the ratio and the
                    text trims)
                -->
                <Grid
                    MaxWidth="628"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340*" />
                        <ColumnDefinition Width="280*" />
                    </Grid.ColumnDefinitions>

                    <!--  whats new button  -->
                    <!--  (no left padding, the image sits flush with the button edge like the hover fill)  -->
                    <Button
                        Grid.Column="0"
                        Padding="0,0,18,0"
                        Click="ReleaseNotesButton_Click"
                        Style="{StaticResource SubtleTileButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  hero image  -->
                            <!--
                                (an ImageBrush, a background is clipped by the corner radius; the fixed pair keeps
                                the 2560x1317 ratio; the source is set in code per theme, see ApplyHeroImage)
                            -->
                            <Border
                                x:Name="HeroBorder"
                                Grid.Column="0"
                                Width="{StaticResource StartHeroWidth}"
                                Height="{StaticResource StartHeroHeight}"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Border.Background>
                                    <ImageBrush x:Name="HeroBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="What's new"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ReleaseNotesSubtitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!--  update state button  -->
                    <!--  (a click depends on the state, see UpdateStatusButton_Click)  -->
                    <Button
                        Grid.Column="1"
                        MinHeight="{StaticResource StartHeroHeight}"
                        Padding="18,0"
                        Click="UpdateStatusButton_Click"
                        IsEnabled="{x:Bind ViewModel.IsUpdateActionEnabled, Mode=OneWay}"
                        Style="{StaticResource SubtleTileButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  state badge and progress ring  -->
                            <!--
                                (never shown together; directly in the column, a fixed box would read as padding the
                                neighbouring button does not have)
                            -->
                            <Border
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Background="{x:Bind ViewModel.UpdateBadgeBrush, Mode=OneWay}"
                                CornerRadius="12"
                                Visibility="{x:Bind InverseBoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="{x:Bind ViewModel.UpdateBadgeGlyph, Mode=OneWay}" />
                            </Border>
                            <ProgressRing
                                Grid.Column="0"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsUpdateChecking, Mode=OneWay}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UpdateStatusTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UpdateStatusDescription, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind HasText(ViewModel.UpdateStatusDescription), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                Margin="20"
                HorizontalAlignment="Left"
                Spacing="4">

                <!--  content: system snapshot  -->
                <!--
                    one tile per device, with icon, colour and category label from HardwareGroupInfo, the same profile
                    the sensor list and the hardware view use
                    all tiles are placed in a SquareGridPanel
                -->
                <TextBlock
                    Margin="4,4,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="System" />

                <ItemsControl fhUi:FocusGroup.IsEnabled="True" ItemsSource="{x:Bind ViewModel.SystemSnapshot}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <fhControls:SquareGridPanel MinCellWidth="240" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SystemSnapshotEntry">

                            <!--  (no padding on the card itself, the divider has to reach both edges)  -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">

                                <!--
                                    (a row of tiles takes the tallest height, the Star row pushes
                                    the button onto the card edge)
                                -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">

                                        <!--  tile header  -->
                                        <!--  (category over device name, like SensorTileControl)  -->
                                        <Grid Margin="16,14,16,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  (centred across both lines, like the hardware start view)  -->
                                            <FontIcon
                                                Grid.Column="0"
                                                FontSize="20"
                                                Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                                Glyph="{x:Bind IconGlyph}" />

                                            <!--  (the Star column gives the trimming a width)  -->
                                            <StackPanel Grid.Column="1" Spacing="0">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Category}" />
                                                <TextBlock
                                                    Style="{ThemeResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    ToolTipService.ToolTip="{x:Bind Title}" />
                                            </StackPanel>
                                        </Grid>

                                        <!--  static facts  -->
                                        <!--  (wrapped, so a narrow tile reflows instead of clipping)  -->
                                        <ItemsControl Margin="16,16,16,12" ItemsSource="{x:Bind Details}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">

                                        <!--  divider  -->
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!--  sensor count button  -->
                                        <!--  (opens the hardware group on the sensors page; disabled without one)  -->
                                        <Button
                                            Padding="16,10"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="SensorCount_Click"
                                            CornerRadius="0,0,4,4"
                                            IsEnabled="{x:Bind HasSensors, Mode=OneWay}"
                                            Style="{StaticResource SubtleBarButtonStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Glyph="&#xECAA;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind SensorCountText, Mode=OneWay}" />
                                                <FontIcon
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Glyph="&#xE76C;" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <!--  content: app status  -->
                <!--
                    (AppStatusService, the snapshot of the title bar readout, so both agree; carded like the system
                    snapshot, so the page reads as one board)
                -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="App Status" />

                <!--  (MaxWidth is both 300 wide cards plus the spacing, so the star columns never push them apart)  -->
                <Grid
                    MaxWidth="608"
                    HorizontalAlignment="Left"
                    fhUi:FocusGroup.IsEnabled="True"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  lhm group  -->
                    <!--  (the inset sits on the panel, nothing in this card has to reach its edge)  -->
                    <Border
                        Grid.Column="0"
                        MaxWidth="300"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Margin="16,14,16,14" Spacing="6">
                            <fhInfoPopup:InfoPopupControl
                                Title="LibreHardwareMonitor"
                                Description="Found Sensors - every sensor LibreHardwareMonitor reports on this machine&#10;Rendering Sensors - how many of them are actively drawn right now&#10;LibreHardwareMonitorLib is the largest and most established hardware monitoring library for Windows"
                                PlacementMode="Above"
                                SourceIntro="This App is powered by the open source LibreHardwareMonitor project:"
                                TitleTextTrimming="CharacterEllipsis">
                                <fhInfoPopup:InfoPopupControl.SourceLinks>
                                    <fhInfoPopup:SourceLink Label="LibreHardwareMonitor on GitHub" Url="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                                </fhInfoPopup:InfoPopupControl.SourceLinks>
                            </fhInfoPopup:InfoPopupControl>

                            <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Found Sensors" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SensorsFoundText, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Rendering Sensors" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SensorsRenderedText, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <!--  this app group  -->
                    <!--  (the usage of this app, not of the machine, as the flyout spells out)  -->
                    <Border
                        Grid.Column="1"
                        MaxWidth="300"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Margin="16,14,16,14" Spacing="6">
                            <fhInfoPopup:InfoPopupControl
                                Title="This App"
                                Description="CPU Usage - this app's own CPU time relative to total capacity across all cores&#10;RAM Usage - physical memory currently mapped by this app (working set)&#10;Uptime - how long this app has been running since it was last started"
                                PlacementMode="Above"
                                SourceIntro="Source:"
                                TitleTextTrimming="CharacterEllipsis">
                                <fhInfoPopup:InfoPopupControl.SourceLinks>
                                    <fhInfoPopup:SourceLink Label="Windows Process API" Url="https://learn.microsoft.com/en-us/dotnet/api/system.diagnostics.process" />
                                </fhInfoPopup:InfoPopupControl.SourceLinks>
                            </fhInfoPopup:InfoPopupControl>

                            <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="CPU usage" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CpuTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="RAM usage" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.RamTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <!--  (ticks on its own timer, not with the status snapshot, see StartPage)  -->
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Uptime" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.UptimeTileValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>


                <!--  content: about and open source  -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="About &amp; Open Source" />

                <!--  revisit: flat about section  -->
                <!--
                    the expanders are toggled by hand while the flat link row is tried out; the third-party list
                    has no place in that row yet
                -->

                <!--  app info  -->
                <controls:SettingsExpander
                    fhUi:FocusGroup.IsEnabled="True"
                    Description="© 2026 Daniel Čech · MIT License"
                    Header="Fluent Sensors"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xE946;}"
                    Visibility="Collapsed">

                    <TextBlock
                        x:Name="AboutVersionTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />

                    <controls:SettingsExpander.Items>
                        <!--  (the repository is the documentation, so it appears here once and nowhere else)  -->
                        <controls:SettingsCard Description="Readme, usage and the full source" Header="Documentation">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout/fluent-sensors" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Description="Bug reports and feature requests" Header="Feedback on GitHub">
                            <HyperlinkButton Content="GitHub Issues" NavigateUri="https://github.com/cechout/fluent-sensors/issues/new/choose" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Developer Profile">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  support  -->
                <!--  (the only place in the app that asks for anything)  -->
                <controls:SettingsExpander
                    fhUi:FocusGroup.IsEnabled="True"
                    Description="Fluent Sensors is free and open source"
                    Header="Support the Project"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xEB51;}"
                    Visibility="Collapsed">

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            Description="A rating helps others find the app"
                            Header="Review on Microsoft Store"
                            Visibility="{x:Bind BoolToVisibility(IsStoreBuild)}">
                            <HyperlinkButton Click="StoreReviewLink_Click" Content="Microsoft Store" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Description="Recurring or one-off, through GitHub" Header="Sponsor on GitHub">
                            <HyperlinkButton Content="GitHub Sponsors" NavigateUri="https://github.com/sponsors/cechout" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  third-party libraries  -->
                <controls:SettingsExpander
                    fhUi:FocusGroup.IsEnabled="True"
                    Description="Open source projects used in this app"
                    Header="Third-Party Libraries"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xE8F1;}"
                    Visibility="Visible">

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Windows App SDK">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Windows Community Toolkit">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/CommunityToolkit/Windows" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="WinUIEx">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/dotMorten/WinUIEx" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="LiveCharts2">
                            <HyperlinkButton Content="Website" NavigateUri="https://livecharts.dev/" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="SkiaSharp">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/mono/SkiaSharp" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="LibreHardwareMonitor">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="H.NotifyIcon">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/HavenDV/H.NotifyIcon" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Vortice.Windows">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/amerkoleci/Vortice.Windows" />
                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  quick links  -->
                <!--
                    (the destinations of the collapsed expanders, from using the app to supporting it; the store
                    review only in the store build)
                -->
                <controls:WrapPanel
                    Margin="0,4,0,8"
                    fhUi:FocusGroup.IsEnabled="True"
                    HorizontalSpacing="4"
                    VerticalSpacing="0">
                    <HyperlinkButton Content="Documentation" NavigateUri="https://github.com/cechout/fluent-sensors" />
                    <HyperlinkButton Content="Feedback on GitHub" NavigateUri="https://github.com/cechout/fluent-sensors/issues/new/choose" />
                    <HyperlinkButton
                        Click="StoreReviewLink_Click"
                        Content="Review on Microsoft Store"
                        Visibility="{x:Bind BoolToVisibility(IsStoreBuild)}" />
                    <HyperlinkButton Content="Sponsor on GitHub" NavigateUri="https://github.com/sponsors/cechout" />
                    <HyperlinkButton Content="Developer Profile" NavigateUri="https://github.com/cechout" />
                </controls:WrapPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
