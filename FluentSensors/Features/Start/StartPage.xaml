<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Start.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:local="using:FluentSensors.Features.Start"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  frame1.png is 2560x1317; 150 wide therefore lands on 77 high, and the update button matches it  -->
        <x:Double x:Key="StartHeroWidth">150</x:Double>
        <x:Double x:Key="StartHeroHeight">77</x:Double>
    </Page.Resources>

    <ScrollViewer>
        <!--  capped rather than stretched, unlike the settings page: the snapshot rows below read badly once  -->
        <!--  they run the full width of a wide monitor  -->
        <StackPanel
            MaxWidth="1000"
            Margin="20"
            HorizontalAlignment="Left"
            Spacing="4">

            <!--  app title and running version  -->
            <StackPanel
                Margin="4,0,0,12"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Fluent Sensors" />
                <TextBlock
                    x:Name="VersionTextBlock"
                    Margin="0,0,0,3"
                    VerticalAlignment="Bottom"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{ThemeResource BodyTextBlockStyle}" />
            </StackPanel>


            <!--  release notes and update state  -->
            <!--
                two separate jobs on purpose: the left button only ever reads out what changed, the right one is
                the only thing that offers to install anything
                a WrapPanel rather than two fixed columns, so a narrow window stacks them instead of clipping

                both buttons carry the same MinHeight and the same inner spacing so they read as a pair; the hero
                image sets that height and the update button matches it rather than the other way round
            -->
            <controls:WrapPanel
                Margin="0,0,0,8"
                HorizontalSpacing="8"
                VerticalSpacing="8">

                <!--  what is new in the latest release  -->
                <!--  no left padding, the image sits flush against the button edge the way the hover fill does  -->
                <Button Padding="0,0,18,0" Style="{ThemeResource SubtleButtonStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            Width alone, deliberately no Height: the source is 2560x1317, and letting the image
                            derive its own height is what keeps that ratio exact at any width
                            the Border is what rounds it, a Border clips its child to its own corner radius
                        -->
                        <Border Grid.Column="0" CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Image Width="{StaticResource StartHeroWidth}" Source="/Assets/Pictures/frame1.png" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="What's new" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ReleaseNotesSubtitle, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Button.Flyout>
                        <!--  the presenter scrolls nothing itself, the control inside brings its own scroller  -->
                        <Flyout Opening="ReleaseNotesFlyout_Opening" Placement="Bottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="470" />
                                    <Setter Property="Padding" Value="16" />
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <local:ReleaseNotesControl x:Name="ReleaseNotes" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--  update state; what a click does depends on the state, see UpdateStatusButton_Click  -->
                <Button
                    MinHeight="{StaticResource StartHeroHeight}"
                    Padding="18,0"
                    Click="UpdateStatusButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsUpdateActionEnabled, Mode=OneWay}"
                    Style="{ThemeResource SubtleButtonStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            badge and progress ring sit directly in the column and never show at the same time
                            deliberately without the fixed-size wrapper they used to have: a 24px badge centred in a
                            36px box reads as 6px of extra padding that the neighbouring button does not have
                        -->
                        <Border
                            Grid.Column="0"
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            Background="{x:Bind ViewModel.UpdateBadgeBrush, Mode=OneWay}"
                            CornerRadius="12"
                            Visibility="{x:Bind InverseBoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="{x:Bind ViewModel.UpdateBadgeGlyph, Mode=OneWay}" />
                        </Border>
                        <ProgressRing
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsUpdateChecking, Mode=OneWay}"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.IsUpdateChecking), Mode=OneWay}" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpdateStatusTitle, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpdateStatusDescription, Mode=OneWay}"
                                Visibility="{x:Bind HasText(ViewModel.UpdateStatusDescription), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </controls:WrapPanel>


            <!--  system snapshot  -->
            <!--
                one tile per device rather than one card for the whole machine; the icon, colour and category
                label per tile come from HardwareGroupInfo, the same profile the sensor list and the hardware
                view use

                deliberately not buttons: nothing here navigates, so there is no hover or pressed state to
                promise something that does not happen; what is dynamic is the layout, SquareGridPanel gives up
                a column at a time as the window narrows, exactly as the hardware start view does
            -->
            <TextBlock
                Margin="4,8,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="System" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.SystemSnapshot}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <fhControls:SquareGridPanel MinCellWidth="290" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SystemSnapshotEntry">

                        <Border
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">

                            <StackPanel Spacing="10">

                                <!--  device name leads, the category is the label under it; the icon already  -->
                                <!--  carries the category in its own colour  -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,2,0,0"
                                        VerticalAlignment="Top"
                                        FontSize="20"
                                        Foreground="{x:Bind IconBrush}"
                                        Glyph="{x:Bind IconGlyph}" />

                                    <!--  the Star column is what gives the trimming below an actual width to  -->
                                    <!--  trim against; inside a horizontal StackPanel it would never trigger  -->
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <TextBlock
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind Title}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Category}" />
                                    </StackPanel>
                                </Grid>

                                <!--  the static facts, wrapped so a narrow tile reflows instead of clipping  -->
                                <ItemsControl ItemsSource="{x:Bind Details}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  how much of this device the sensor list actually covers  -->
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xECAA;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SensorCountText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <!--  this apps own live status  -->
            <!--
                fed by AppStatusService, the same snapshot the title bar readout runs on, so the two always agree
                deliberately just three numbers for now

                label and value follow SensorTileControl: caption in the secondary brush over a BodyLarge value
                with tabular numerals, so a digit change never shifts the text
            -->
            <TextBlock
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="App Status" />

            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">

                <Border
                    MinWidth="185"
                    Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Sensors" />
                        <TextBlock
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.SensorsTileValue, Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>

                <Border
                    MinWidth="140"
                    Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="CPU usage" />
                        <TextBlock
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.CpuTileValue, Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>

                <Border
                    MinWidth="140"
                    Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="RAM usage" />
                        <TextBlock
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.RamTileValue, Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>
            </controls:WrapPanel>


            <!--  about section  -->
            <TextBlock
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About &amp; Open Source" />

            <controls:SettingsExpander
                Description="© 2026 Daniel Čech. All rights reserved."
                Header="Fluent Sensors"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE946;}">

                <TextBlock
                    x:Name="AboutVersionTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True" />

                <controls:SettingsExpander.Items>
                    <!--  the repository is the documentation, so it appears here once and nowhere else  -->
                    <controls:SettingsCard Description="Readme, usage and the full source" Header="Documentation">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout/fluent-sensors" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Open a new issue on the project" Header="Report a bug">
                        <HyperlinkButton Content="GitHub Issues" NavigateUri="https://github.com/cechout/fluent-sensors/issues/new" />
                    </controls:SettingsCard>

                    <!--  (the settings and sensor state json files; a portable build keeps them next to the exe)  -->
                    <controls:SettingsCard Description="Where settings and sensor state are stored" Header="App data folder">
                        <Button Click="OpenAppDataFolder_Click" Content="Open" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Developer Profile">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  the only place in the app that asks for anything  -->
            <controls:SettingsExpander
                Description="Fluent Sensors is free and open source"
                Header="Support the Project"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xEB51;}">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="Recurring or one-off, through GitHub" Header="Sponsor on GitHub">
                        <HyperlinkButton Content="GitHub Sponsors" NavigateUri="https://github.com/sponsors/cechout" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Description="Open source projects used in this app"
                Header="Third-Party Libraries"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE8F1;}">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Windows App SDK">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Windows Community Toolkit">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/CommunityToolkit/WindowsCommunityToolkit" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="WinUIEx">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/dotMorten/WinUIEx" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="LiveCharts2">
                        <HyperlinkButton Content="Website" NavigateUri="https://livecharts.dev/" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="LibreHardwareMonitor">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="H.NotifyIcon">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/HavenDV/H.NotifyIcon" />
                    </controls:SettingsCard>

                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
