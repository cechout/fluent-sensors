<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSensors.Features.TaskbarWidget.TaskbarFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhCommon="using:FluentSensors.Common.Sensors"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:fhTimeRange="using:FluentSensors.Controls.TimeRange"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Fluent Sensors Flyout"
    mc:Ignorable="d">

    <!--
        the window around the card: a transparent margin the shadow falls into, set as the margin of the card and
        its material in PositionNextToTaskbar (zero on the window level construction); the transparent fill
        swallows clicks into it
    -->
    <Grid x:Name="FlyoutWindowRoot" Background="Transparent">

        <!--  the shadow: a bitmap over the whole window, computed in RenderCardShadow  -->
        <!--  (in physical pixels and scaled down from code, so the canvas keeps the layout from clipping it)  -->
        <Canvas IsHitTestVisible="False">
            <Image
                x:Name="FlyoutShadowImage"
                IsHitTestVisible="False"
                Stretch="Fill"
                Visibility="Collapsed" />
        </Canvas>

        <!--  the material: the backdrop link visual hangs here, behind the card, sized and clipped to it in code  -->
        <Grid x:Name="FlyoutBackdropHost" IsHitTestVisible="False" />

        <Border
            x:Name="FlyoutRootBorder"
            Background="{ThemeResource FlyoutWindowBackground}"
            BorderBrush="{ThemeResource FlyoutWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">

            <!--
                layout: insets and heights of the rows; the height math in code-behind reads these keys, so the window
                always fits its rows
            -->
            <Border.Resources>
                <!--  graph list; (a margin, not padding on the surface, so the scrollbar rides the window edge)  -->
                <Thickness x:Key="FlyoutGraphsMargin">4,2,4,0</Thickness>
                <x:Double x:Key="FlyoutGraphSpacing">8</x:Double>

                <!--  title row and bottom bar; (one button height, a padding each; the bar runs down to the card border)  -->
                <x:Double x:Key="FlyoutBarButtonHeight">36</x:Double>
                <Thickness x:Key="FlyoutTitleRowPadding">4,4,4,4</Thickness>
                <Thickness x:Key="FlyoutBottomBarPadding">6,5,6,6</Thickness>
                <Thickness x:Key="FlyoutBottomBarSeparatorThickness">0,1,0,0</Thickness>

                <!--  time range row  -->
                <Thickness x:Key="FlyoutTimeRangeRowPadding">4,7,4,7</Thickness>
                <x:Double x:Key="FlyoutTimeRangePickerHeight">22</x:Double>

                <Thickness x:Key="FlyoutTimeRangeSeparatorMargin">0,8,0,0</Thickness>

                <!--  app resources drawer; (its height is measured, not a resource)  -->
                <Thickness x:Key="FlyoutResourcesPanelMargin">14,2,14,12</Thickness>
            </Border.Resources>

            <Grid x:Name="RootGrid" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <!--
                    acrylic grain: the material paints noise last, the backdrop controller does not; below every fill, so
                    it grains the material and not the text or graphs; a canvas, since the rectangle is sized in physical
                    pixels and scaled down from code, which would stretch the rows
                -->
                <Canvas
                    x:Name="FlyoutNoiseHost"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Rectangle x:Name="FlyoutNoiseOverlay" />
                </Canvas>


                <!--  title row, vertical list of sensor graphs, time range row, app resources drawer  -->
                <!--  (one surface for all of them; only the graphs scroll)  -->
                <Grid
                    x:Name="GraphsContentGrid"
                    Grid.Row="0"
                    Background="{ThemeResource FlyoutGraphsBackground}"
                    CornerRadius="7,7,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  title row: title, shortcut hint and snapshot button  -->
                    <!--  (the button height of the bottom bar, a padding of its own)  -->
                    <Grid
                        x:Name="TitleRowGrid"
                        Grid.Row="0"
                        Padding="{StaticResource FlyoutTitleRowPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  title  -->
                        <!--  (row padding plus margin, so it lines up with the button texts below, which sit behind padding and a 1 px border)  -->
                        <TextBlock
                            x:Uid="TaskbarFlyout_SystemSensorsText"
                            Margin="10,-2,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />

                        <!--  shortcut hint: [Ctrl]+[Alt]+[S]  -->
                        <!--
                            (one bordered key per part, built in ApplyShortcutHint and only while the shortcut is
                            registered; the styles live here, so code-built keys still follow a theme switch)
                        -->
                        <StackPanel
                            x:Name="ShortcutHintPanel"
                            Grid.Column="1"
                            Margin="6,-1,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="1"
                            Visibility="Collapsed">
                            <StackPanel.Resources>
                                <Style x:Key="ShortcutKeyBorderStyle" TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="2" />
                                    <Setter Property="Height" Value="16" />
                                    <Setter Property="Padding" Value="4,0,4,1" />
                                </Style>
                                <Style
                                    x:Key="ShortcutKeyTextStyle"
                                    BasedOn="{StaticResource CaptionTextBlockStyle}"
                                    TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="10" />
                                </Style>
                                <!--  the plus between the keys; (centered, so a bottom margin lifts it by half)  -->
                                <Style
                                    x:Key="ShortcutKeyPlusTextStyle"
                                    BasedOn="{StaticResource ShortcutKeyTextStyle}"
                                    TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                </Style>
                            </StackPanel.Resources>
                        </StackPanel>

                        <!--  snapshot button  -->
                        <!--  (pauses and resumes the flyout graphs; name, tooltip and glyph set in ApplyPauseState)  -->
                        <Button
                            x:Name="PauseButton"
                            Grid.Column="2"
                            Width="38"
                            Height="{StaticResource FlyoutBarButtonHeight}"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="PauseButton_Click"
                            Style="{StaticResource SubtleBarButtonStyle}">
                            <FontIcon x:Name="PauseButtonIcon" FontSize="14" />
                        </Button>
                    </Grid>

                    <!--  content  -->
                    <!--  (scrolls only once the pinned sensors pass the height cap; switched in ApplyGraphsScrollMode)  -->
                    <ScrollViewer
                        x:Name="GraphsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <ItemsControl
                            x:Name="GraphsItemsControl"
                            Margin="{StaticResource FlyoutGraphsMargin}"
                            ItemsSource="{x:Bind ViewModel.FlyoutSensors, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <fhControls:VerticalStretchPanel Spacing="{StaticResource FlyoutGraphSpacing}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fhGraph:SensorGraphViewModel">
                                    <fhGraph:SensorPanelControl
                                        ShowStatusRow="True"
                                        ShowThresholdControls="True"
                                        ShowYAxisControls="True"
                                        ViewModel="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  separator above the time range row, edge to edge  -->
                    <Border
                        Grid.Row="2"
                        Height="1"
                        Margin="{StaticResource FlyoutTimeRangeSeparatorMargin}"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  time range row: flyout graphs first, then the taskbar graphs; the drawer arrow at the end  -->
                    <Grid
                        x:Name="TimeRangeRowPanel"
                        Grid.Row="3"
                        Padding="{StaticResource FlyoutTimeRangeRowPadding}"
                        fhUi:FocusGroup.IsEnabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <fhTimeRange:TimeRangePickerControl
                            x:Name="FlyoutTimeRangePicker"
                            x:Uid="TaskbarFlyout_FlyoutTimeRangePicker"
                            Grid.Column="0"
                            Height="{StaticResource FlyoutTimeRangePickerHeight}"
                            Padding="9,0,9,0"
                            Options="{x:Bind fhCommon:GraphTimeRanges.Taskbar}"
                            TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <fhTimeRange:TimeRangePickerControl
                            x:Name="TaskbarTimeRangePicker"
                            x:Uid="TaskbarFlyout_TaskbarTimeRangePicker"
                            Grid.Column="1"
                            Height="{StaticResource FlyoutTimeRangePickerHeight}"
                            Padding="9,0,9,0"
                            Options="{x:Bind fhCommon:GraphTimeRanges.Taskbar}"
                            TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!--  drawer arrow; (turns over with the drawer; name and tooltip in ApplyResourcesButtonState)  -->
                        <Button
                            x:Name="ResourcesButton"
                            Grid.Column="3"
                            Width="30"
                            Height="{StaticResource FlyoutTimeRangePickerHeight}"
                            Padding="0"
                            Click="ResourcesButton_Click"
                            Style="{StaticResource SubtleBarButtonStyle}">
                            <FontIcon
                                x:Name="ResourcesButtonIcon"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE70E;"
                                RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <RotateTransform x:Name="ResourcesButtonIconRotation" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                    </Grid>

                    <!--  status drawer: the lhm status, opened by the arrow above  -->
                    <!--
                        (the card grows by it inside the still window, see ApplyResourcesProgress; the panel sits on the
                        bottom, so the rows above slide up off it)
                    -->
                    <Grid
                        x:Name="ResourcesDrawerHost"
                        Grid.Row="4"
                        Height="0">
                        <!--  (title and info button as on the start page, the values packed like a hardware view info panel)  -->
                        <StackPanel
                            x:Name="ResourcesPanel"
                            Margin="{StaticResource FlyoutResourcesPanelMargin}"
                            VerticalAlignment="Bottom"
                            Spacing="8">
                            <!--  lhm status; (the app resources below are parked, swap the two blocks to bring them back)  -->
                            <fhInfoPopup:InfoPopupControl
                                x:Uid="TaskbarFlyout_LhmPopup"
                                Title="LibreHardwareMonitor"
                                PlacementMode="Above"
                                TitleTextTrimming="CharacterEllipsis">
                                <fhInfoPopup:InfoPopupControl.SourceLinks>
                                    <fhInfoPopup:SourceLink x:Uid="Start_LhmGitHubSource" Url="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                                </fhInfoPopup:InfoPopupControl.SourceLinks>
                            </fhInfoPopup:InfoPopupControl>

                            <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_UpdateIntervalText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ResourcesViewModel.UpdateIntervalValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_ReadTimeText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ResourcesViewModel.ReadTimeValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </controls:WrapPanel>

                            <!--
                            <fhInfoPopup:InfoPopupControl
                                x:Uid="TaskbarFlyout_AppResourcesPopup"
                                PlacementMode="Above"
                                TitleTextTrimming="CharacterEllipsis">
                                <fhInfoPopup:InfoPopupControl.SourceLinks>
                                    <fhInfoPopup:SourceLink Label="Windows Process API" Url="https://learn.microsoft.com/en-us/dotnet/api/system.diagnostics.process" />
                                    <fhInfoPopup:SourceLink Label="Windows GPU performance counters" Url="https://devblogs.microsoft.com/directx/gpus-in-the-task-manager/" />
                                </fhInfoPopup:InfoPopupControl.SourceLinks>
                            </fhInfoPopup:InfoPopupControl>

                            <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_CPUUsageText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ResourcesViewModel.CpuValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_RAMUsageText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ResourcesViewModel.RamValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="Start_GpuUsageText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ResourcesViewModel.GpuUsageValue, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </controls:WrapPanel>
                            -->
                        </StackPanel>
                    </Grid>
                </Grid>


                <!--  bottom bar: navigation actions  -->
                <Border
                    x:Name="FlyoutBottomBarBorder"
                    Grid.Row="1"
                    Background="{ThemeResource FlyoutBottomBarBackground}"
                    BorderBrush="{ThemeResource FlyoutBottomBarSeparatorBrush}"
                    BorderThickness="{StaticResource FlyoutBottomBarSeparatorThickness}"
                    CornerRadius="0,0,7,7">

                    <Grid
                        x:Name="BottomBarContentGrid"
                        Padding="{StaticResource FlyoutBottomBarPadding}"
                        fhUi:FocusGroup.IsEnabled="True">

                        <!--  open the sensor list on main window  -->
                        <Button
                            x:Name="BackToDashboardButton"
                            x:Uid="TaskbarFlyout_BackToDashboardButton"
                            Height="{StaticResource FlyoutBarButtonHeight}"
                            Padding="7,0,7,0"
                            HorizontalAlignment="Left"
                            Click="BackToDashboard_Click"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource SubtleBarButtonStyle}" />

                        <!--  open settings page  -->
                        <Button
                            x:Name="TaskbarSettingsButton"
                            x:Uid="TaskbarFlyout_TaskbarSettingsButton"
                            Width="38"
                            Height="{StaticResource FlyoutBarButtonHeight}"
                            Margin="0,0,1,0"
                            Padding="8,0,8,0"
                            HorizontalAlignment="Right"
                            Click="TaskbarSettings_Click"
                            Style="{StaticResource SubtleBarButtonStyle}">
                            <!--
                                the gear of the native settings item, turning once on press (see TaskbarSettingsButton_PointerPressed);
                                the glyph stands in while animations are off
                            -->
                            <AnimatedIcon
                                x:Name="TaskbarSettingsIcon"
                                Width="14"
                                Height="14">
                                <AnimatedIcon.Source>
                                    <animatedVisuals:AnimatedSettingsVisualSource />
                                </AnimatedIcon.Source>
                                <AnimatedIcon.FallbackIconSource>
                                    <FontIconSource FontSize="14" Glyph="&#xE713;" />
                                </AnimatedIcon.FallbackIconSource>
                            </AnimatedIcon>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
