<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSensors.Features.TaskbarWidget.TaskbarFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhCommon="using:FluentSensors.Common.Sensors"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhTimeRange="using:FluentSensors.Controls.TimeRange"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Fluent Sensors Flyout"
    mc:Ignorable="d">

    <Border
        x:Name="FlyoutRootBorder"
        Background="{ThemeResource FlyoutWindowBackground}"
        BorderBrush="{ThemeResource FlyoutWindowBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid x:Name="RootGrid" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--
                acrylic grain: the material paints noise last, the backdrop controller does not; below every fill, so
                it grains the material and not the text or graphs; a canvas, since the rectangle is sized in physical
                pixels and scaled down from code, which would stretch the rows
            -->
            <Canvas
                x:Name="FlyoutNoiseHost"
                Grid.Row="0"
                Grid.RowSpan="2"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Rectangle x:Name="FlyoutNoiseOverlay" />
            </Canvas>


            <!--  title row, vertical list of sensor graphs, time range row  -->
            <!--  (one surface for all three; title and time ranges stay put, only the graphs scroll)  -->
            <Grid
                x:Name="GraphsContentGrid"
                Grid.Row="0"
                Background="{ThemeResource FlyoutGraphsBackground}"
                CornerRadius="7,7,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  title row: title, shortcut hint and snapshot button  -->
                <!--  (the height and padding of the bottom bar, set from code)  -->
                <Grid x:Name="TitleRowGrid" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  title  -->
                    <!--  (the margin is the button padding of the bottom bar, so it lines up with its text)  -->
                    <TextBlock
                        Margin="11,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="System Sensors"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />

                    <!--  shortcut hint: [Ctrl]+[Alt]+[S]  -->
                    <!--
                        (one bordered key per part, built in ApplyShortcutHint and only while the shortcut is
                        registered; the styles live here, so code-built keys still follow a theme switch)
                    -->
                    <StackPanel
                        x:Name="ShortcutHintPanel"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2"
                        Visibility="Collapsed">
                        <StackPanel.Resources>
                            <Style x:Key="ShortcutKeyBorderStyle" TargetType="Border">
                                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="2" />
                                <Setter Property="Padding" Value="2,0,2,0" />
                            </Style>
                            <Style
                                x:Key="ShortcutKeyTextStyle"
                                BasedOn="{StaticResource CaptionTextBlockStyle}"
                                TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>

                    <!--  snapshot button  -->
                    <!--  (pauses and resumes the flyout graphs; name, tooltip and glyph set in ApplyPauseState)  -->
                    <Button
                        x:Name="PauseButton"
                        Grid.Column="2"
                        Width="38"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Click="PauseButton_Click"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource SubtleBarButtonStyle}">
                        <FontIcon x:Name="PauseButtonIcon" FontSize="14" />
                    </Button>
                </Grid>

                <!--  scrolls only once the pinned sensors pass the height cap (switched in ApplyGraphsScrollMode)  -->
                <ScrollViewer
                    x:Name="GraphsScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <ItemsControl x:Name="GraphsItemsControl" ItemsSource="{x:Bind ViewModel.FlyoutSensors, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <fhControls:VerticalStretchPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fhGraph:SensorGraphViewModel">
                                <fhGraph:SensorPanelControl
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  time range row: taskbar graphs left, flyout graphs right  -->
                <Grid
                    x:Name="TimeRangeRowGrid"
                    Grid.Row="2"
                    fhUi:FocusGroup.IsEnabled="True">
                    <fhTimeRange:TimeRangePickerControl
                        x:Name="TaskbarTimeRangePicker"
                        AccessibleName="Taskbar Time Range"
                        Label="Taskbar"
                        Options="{x:Bind fhCommon:GraphTimeRanges.Taskbar}"
                        TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <fhTimeRange:TimeRangePickerControl
                        x:Name="FlyoutTimeRangePicker"
                        HorizontalAlignment="Right"
                        AccessibleName="Flyout Time Range"
                        Label="Flyout"
                        Options="{x:Bind fhCommon:GraphTimeRanges.Taskbar}"
                        TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>


            <!--  bottom bar: navigation actions  -->
            <Border
                x:Name="FlyoutBottomBarBorder"
                Grid.Row="1"
                Margin="0,0,0,1"
                Background="{ThemeResource FlyoutBottomBarBackground}"
                BorderBrush="{ThemeResource FlyoutBottomBarSeparatorBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,7,7">

                <Grid x:Name="BottomBarContentGrid" fhUi:FocusGroup.IsEnabled="True">

                    <!--  open the sensor list on the taskbar profile  -->
                    <Button
                        x:Name="BackToDashboardButton"
                        Padding="11,0,11,0"
                        HorizontalAlignment="Left"
                        Click="BackToDashboard_Click"
                        Content="Manage Taskbar Sensors"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource SubtleBarButtonStyle}" />

                    <!--  close the taskbar widget  -->
                    <Button
                        x:Name="CloseWidgetButton"
                        Width="38"
                        Padding="0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Close Taskbar Widget"
                        Click="CloseWidget_Click"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource SubtleBarButtonStyle}"
                        ToolTipService.ToolTip="Close Taskbar Widget">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
