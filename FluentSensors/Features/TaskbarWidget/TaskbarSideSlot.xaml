<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.TaskbarWidget.TaskbarSideSlot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid IsHitTestVisible="False">

        <!--  graph, turned in the vertical directions so its values run along the taskbar  -->
        <fhControls:RotatedContentPanel x:Name="GraphRotation">
            <fhGraph:SensorPanelControl
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsGraphHoverEnabled="False"
                ShowGraphCardBackground="{x:Bind ViewModel.IsCardBackgroundVisible, Mode=OneWay}"
                ShowGraphCardBorder="False"
                ShowGraphLabel="False"
                ShowStatusRow="False"
                ShowThresholdControls="False"
                ShowThresholdFlyoutIndicator="False"
                ShowYAxisControls="False"
                ThresholdLabelAlwaysVisible="False"
                UseGraphColorCardBackground="True"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </fhControls:RotatedContentPanel>

        <!--  sensor name  -->
        <!--  (one or two lines, set in ApplyLayout)  -->
        <TextBlock
            x:Name="NameText"
            Margin="4,1,4,0"
            VerticalAlignment="Top"
            FontSize="10"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            MaxLines="1"
            Text="{x:Bind ViewModel.SensorName, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <!--  current value and unit  -->
        <!--  (breaks between value and unit when both do not fit one line)  -->
        <TextBlock
            Margin="4,0,4,1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            FontSize="10"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            MaxLines="2"
            Text="{x:Bind ViewModel.CurrentValueText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="WrapWholeWords"
            Typography.NumeralAlignment="Tabular" />
    </Grid>
</UserControl>
