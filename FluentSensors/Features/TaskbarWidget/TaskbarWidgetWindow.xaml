<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSensors.Features.TaskbarWidget.TaskbarWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Taskbar Widget"
    mc:Ignorable="d">

    <!--
        Background has to stay Transparent, an opaque root paints straight over the backdrop and the window
        looks solid no matter what the backdrop is set to
    -->
    <!--
        the button deliberately does not stretch, the empty area next to it is what shows whether the window
        is really transparent or just painting the taskbar color
    -->
    <Grid Background="Transparent">
        <Button
            x:Name="TestButton"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Click="TestButton_Click"
            Content="Click me" />
    </Grid>
</Window>
