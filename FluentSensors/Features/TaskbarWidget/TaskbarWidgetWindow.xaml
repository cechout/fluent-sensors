<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSensors.Features.TaskbarWidget.TaskbarWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:local="using:FluentSensors.Features.TaskbarWidget"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Taskbar Widget"
    mc:Ignorable="d">

    <!--  background has to stay transparent; an opaque root paints over the backdrop  -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <!--  slot panels and templates, picked by the taskbar orientation in ApplyEdgeLayout  -->
            <ItemsPanelTemplate x:Key="HorizontalSlotsPanel">
                <fhControls:HorizontalStretchPanel Spacing="6" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="VerticalSlotsPanel">
                <fhControls:VerticalStretchPanel Spacing="6" />
            </ItemsPanelTemplate>

            <!--  slot on a horizontal taskbar: graph with name and value in its top row  -->
            <DataTemplate x:Key="HorizontalSlotTemplate" x:DataType="fhGraph:SensorGraphViewModel">
                <fhGraph:SensorPanelControl
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsGraphHoverEnabled="False"
                    IsHitTestVisible="False"
                    ShowGraphCardBackground="{x:Bind IsCardBackgroundVisible, Mode=OneWay}"
                    ShowGraphCardBorder="False"
                    ShowGraphLabel="True"
                    ShowStatusRow="False"
                    ShowThresholdControls="False"
                    ShowThresholdFlyoutIndicator="False"
                    ShowYAxisControls="False"
                    ThresholdLabelAlwaysVisible="False"
                    UseGraphColorCardBackground="True"
                    ViewModel="{x:Bind}" />
            </DataTemplate>

            <!--  slot on a side taskbar  -->
            <!--  (layout pushed from code once loaded, see TaskbarWidgetWindow.ApplySideSlotLayout)  -->
            <DataTemplate x:Key="SideSlotTemplate" x:DataType="fhGraph:SensorGraphViewModel">
                <local:TaskbarSideSlot Loaded="SideSlot_Loaded" ViewModel="{x:Bind}" />
            </DataTemplate>
        </Grid.Resources>

        <!--  the whole widget is one button around all graphs (padding per taskbar edge, from code)  -->
        <Button
            x:Name="TaskbarButton"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.Name="Fluent Sensors"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            Click="TaskbarButton_Click"
            PointerCanceled="TaskbarButton_PointerCanceled"
            PointerEntered="TaskbarButton_PointerEntered"
            PointerExited="TaskbarButton_PointerExited">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!--
                            normal hover fill, composition animated; a 1px transparent inset like PressedBorder keeps
                            the stroke layer over the taskbar, over this fill it reads far too light
                        -->
                        <Border
                            x:Name="BackgroundBorder"
                            Background="{ThemeResource TaskbarButtonHoverBackground}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="0" />

                        <!--
                            normal pressed fill only; the border is PressedStrokeBorder, so the fill crossfades
                            with the hover fill while the border snaps (a gated fill over a fading one double
                            paints and flashes for a few frames)
                        -->
                        <Border
                            x:Name="PressedBorder"
                            Background="{ThemeResource TaskbarButtonPressedBackground}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="0" />

                        <!--  active flyout hover fill (#323232 on screen, DWM compensated), the same 1px inset  -->
                        <Border
                            x:Name="ActiveHoverBorder"
                            Background="{ThemeResource TaskbarButtonActiveHoverBackground}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="0" />

                        <!--  active flyout pressed fill (#2a2a2a on screen, DWM compensated), the same 1px inset  -->
                        <Border
                            x:Name="ActivePressedBorder"
                            Background="{ThemeResource TaskbarButtonActivePressedBackground}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="0" />

                        <!--  normal hover stroke, composition animated  -->
                        <Border
                            x:Name="StrokeBorder"
                            BorderBrush="{ThemeResource TaskbarButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <!--  flipped in the light theme (TaskbarButtonBorderScaleY), like the next two  -->
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{ThemeResource TaskbarButtonBorderScaleY}" />
                            </Border.RenderTransform>
                        </Border>

                        <!--  normal pressed stroke, gated apart from the PressedBorder fill  -->
                        <Border
                            x:Name="PressedStrokeBorder"
                            BorderBrush="{ThemeResource TaskbarButtonPressedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{ThemeResource TaskbarButtonBorderScaleY}" />
                            </Border.RenderTransform>
                        </Border>

                        <!--  active hover stroke  -->
                        <Border
                            x:Name="ActiveHoverStrokeBorder"
                            BorderBrush="{ThemeResource TaskbarButtonActiveHoverBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{ThemeResource TaskbarButtonBorderScaleY}" />
                            </Border.RenderTransform>
                        </Border>

                        <!--  active pressed stroke  -->
                        <Border
                            x:Name="ActivePressedStrokeBorder"
                            BorderBrush="{ThemeResource TaskbarButtonActivePressedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="0" />

                        <!--  content, always visible  -->
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>

            <!--  the graphs along the taskbar, stretched equally (panel and template from RootGrid.Resources)  -->
            <ItemsControl
                x:Name="SlotsItemsControl"
                ItemTemplate="{StaticResource HorizontalSlotTemplate}"
                ItemsPanel="{StaticResource HorizontalSlotsPanel}"
                ItemsSource="{x:Bind ViewModel.PinnedSensors, Mode=OneWay}" />
        </Button>
    </Grid>
</Window>
