<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentSensors.Features.Settings.FlyoutShortcutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Activation Shortcut"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PreviewKeyDown="Dialog_PreviewKeyDown"
    PreviewKeyUp="Dialog_PreviewKeyUp"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <!--  (named style: an implicit style never reaches a subclass, see ReleaseNotesDialog)  -->

    <ContentDialog.Resources>
        <!--  the large keys; the settings card button has a small pair of its own  -->
        <Style x:Key="LargeShortcutKeyBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="16,0,16,0" />
        </Style>
        <Style x:Key="LargeShortcutKeyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <!--  (a fixed width, below 80 percent of the 600 minimum window width with the dialog padding)  -->
    <StackPanel Width="400" Spacing="16">

        <!--  hint: what makes a valid shortcut  -->
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource BodyTextBlockStyle}"
            Text="Press the keys you want to use. Start with Ctrl, Alt or Win, add Shift if you like, and end with one more key, such as a letter, a digit or an F key. The shortcut works everywhere in Windows, so pick one no other app uses."
            TextWrapping="Wrap" />

        <!--  the recorded keys, or the placeholder  -->
        <Border
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid
                x:Name="KeysArea"
                MinHeight="48"
                AutomationProperties.LiveSetting="Polite">
                <StackPanel
                    x:Name="KeysPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8" />
                <TextBlock
                    x:Name="NoShortcutText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No shortcut" />
            </Grid>
        </Border>

        <!--  clear the shortcut  -->
        <Button
            x:Name="ClearButton"
            HorizontalAlignment="Center"
            AutomationProperties.Name="Clear Shortcut"
            Click="ClearButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                <TextBlock Text="Clear" />
            </StackPanel>
        </Button>

        <!--  a rejected combination, or a key without a modifier  -->
        <InfoBar
            x:Name="WarningInfoBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />
    </StackPanel>
</ContentDialog>
