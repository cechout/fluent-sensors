<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Margin="20"
            HorizontalAlignment="Stretch"
            Spacing="4">

            <TextBlock
                Margin="4,0,0,12"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />


            <!--  general settings  -->
            <TextBlock
                Margin="4,8,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="General Settings" />

            <controls:SettingsCard
                Description="Light, dark, or match Windows"
                Header="App Theme"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE790;}">
                <ComboBox
                    x:Name="ThemeComboBox"
                    Width="150"
                    SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="System Default" Tag="Default" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </controls:SettingsCard>

            <!--  engine settings  -->
            <controls:SettingsCard
                Description="How often sensors are polled"
                Header="Update Interval"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE916;}">
                <ComboBox
                    x:Name="IntervalComboBox"
                    Width="150"
                    SelectionChanged="IntervalComboBox_SelectionChanged">
                    <ComboBoxItem Content="100ms" Tag="100" />
                    <ComboBoxItem Content="150ms" Tag="150" />
                    <ComboBoxItem Content="200ms" Tag="200" />
                    <ComboBoxItem Content="250ms" Tag="250" />
                    <ComboBoxItem Content="300ms" Tag="300" />
                    <ComboBoxItem Content="400ms" Tag="400" />
                    <ComboBoxItem Content="500ms" Tag="500" />
                    <ComboBoxItem Content="1000ms" Tag="1000" />
                    <ComboBoxItem Content="2000ms" Tag="2000" />
                    <ComboBoxItem Content="5000ms" Tag="5000" />
                </ComboBox>
            </controls:SettingsCard>

            <!--  graph rendering  -->
            <!--  (both rows apply to every graph in the app, the per-surface sections below only add color and range)  -->
            <controls:SettingsExpander
                Description="Line style and area fill of every graph"
                Header="Graph"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE9D2;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Line Style">
                        <ComboBox
                            x:Name="GraphLineStyleComboBox"
                            Width="150"
                            SelectionChanged="GraphLineStyleComboBox_SelectionChanged">
                            <ComboBoxItem Content="Stepline" Tag="Stepline" />
                            <ComboBoxItem Content="Smooth" Tag="Smooth" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <!--  (stays flat while a threshold is tripped, the alarm zones need the other gradient axis)  -->
                    <controls:SettingsCard Header="Fill Fade">
                        <ToggleSwitch
                            x:Name="GraphFillFadeToggle"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="GraphFillFadeToggle_Toggled" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  hardware colors  -->
            <!--
                (reaches the performance page graphs and the start page snapshot icons; off sends the graphs back
                to the widget graph color and the icons back to the ordinary foreground)
            -->
            <controls:SettingsCard
                Description="Color graphs and icons per hardware category"
                Header="Hardware Colors"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE2B1;}">
                <ToggleSwitch
                    x:Name="HardwareColorsToggle"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="HardwareColorsToggle_Toggled" />
            </controls:SettingsCard>

            <!--  title bar status readout  -->
            <controls:SettingsExpander
                Description="Which readouts the title bar shows, and in which order"
                Header="Title Bar Status"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xF138;}"
                IsExpanded="False">

                <ToggleSwitch
                    x:Name="StatusReadoutToggle"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="StatusReadoutToggle_Toggled" />

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Name="StatusLhmGroupCard" Header="Sensor Status">
                        <ToggleSwitch
                            x:Name="StatusLhmGroupToggle"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="StatusLhmGroupToggle_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="StatusWindowsGroupCard" Header="App Resources">
                        <ToggleSwitch
                            x:Name="StatusWindowsGroupToggle"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="StatusWindowsGroupToggle_Toggled" />
                    </controls:SettingsCard>

                    <!--  (stays disabled until both readouts above are on, there is nothing to order otherwise)  -->
                    <controls:SettingsCard x:Name="StatusGroupOrderCard" Header="Order">
                        <ComboBox
                            x:Name="StatusGroupOrderComboBox"
                            Width="190"
                            SelectionChanged="StatusGroupOrderComboBox_SelectionChanged">
                            <ComboBoxItem Content="Sensor status first" Tag="LhmFirst" />
                            <ComboBoxItem Content="App resources first" Tag="WindowsFirst" />
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  behavior settings  -->
            <controls:SettingsCard
                Description="Hide app to system tray when all windows are minimized"
                Header="Minimize to System Tray"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE744;}">
                <ToggleSwitch
                    x:Name="MinimizeToTrayToggle"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="MinimizeToTrayToggle_Toggled" />
            </controls:SettingsCard>

            <!--  startup  -->
            <!--
                no control on the expander header itself, the four rows are independent of each other
                autostart and its delay are hidden in a portable build, see RestoreStartupSelection
            -->
            <controls:SettingsExpander
                Description="What happens when Windows starts, and what the app does when it launches"
                Header="Startup"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE7E8;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Name="RunOnStartupCard" Header="Run on startup">
                        <ToggleSwitch
                            x:Name="RunOnStartupToggle"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="RunOnStartupToggle_Toggled" />
                    </controls:SettingsCard>

                    <!--  (stays disabled while autostart is off, there is nothing to delay then)  -->
                    <controls:SettingsCard x:Name="DelayStartupCard" Header="Delay start">
                        <ToggleSwitch
                            x:Name="DelayStartupToggle"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="DelayStartupToggle_Toggled" />
                    </controls:SettingsCard>

                    <!--  (applies to the sign-in launch only, opening the app yourself always shows the window)  -->
                    <controls:SettingsCard x:Name="StartMinimizedCard" Header="Start minimized to tray">
                        <ToggleSwitch
                            x:Name="StartMinimizedToggle"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="StartMinimizedToggle_Toggled" />
                    </controls:SettingsCard>

                    <!--  (the labels mirror the navigation entries, so both name the same page)  -->
                    <controls:SettingsCard x:Name="StartupPageCard" Header="Page shown on launch">
                        <ComboBox
                            x:Name="StartupPageComboBox"
                            Width="190"
                            SelectionChanged="StartupPageComboBox_SelectionChanged">
                            <ComboBoxItem Content="Start" Tag="Start" />
                            <ComboBoxItem Content="Sensors" Tag="Sensors" />
                            <ComboBoxItem Content="Hardware View" Tag="Performance" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CheckUpdatesCard" Header="Check for updates on startup">
                        <ToggleSwitch
                            x:Name="CheckUpdatesToggle"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="CheckUpdatesToggle_Toggled" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>




            <!--  performance page settings  -->
            <TextBlock
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Performance Page Appearance" />

            <!--  graph appearance  -->
            <controls:SettingsExpander
                Description="Time range of the overview graphs and the denser grids"
                Header="Graph"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE9D2;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Time Range">
                        <ComboBox
                            x:Name="PerformanceGraphTimeSpanComboBox"
                            Width="40"
                            SelectionChanged="PerformanceGraphTimeSpanComboBox_SelectionChanged">
                            <ComboBoxItem Content="30s" Tag="30" />
                            <ComboBoxItem Content="45s" Tag="45" />
                            <ComboBoxItem Content="60s" Tag="60" />
                            <ComboBoxItem Content="90s" Tag="90" />
                            <ComboBoxItem Content="120s" Tag="120" />
                            <ComboBoxItem Content="240s" Tag="240" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Extended Time Range">
                        <ComboBox
                            x:Name="PerformanceExtendedGraphTimeSpanComboBox"
                            Width="40"
                            SelectionChanged="PerformanceExtendedGraphTimeSpanComboBox_SelectionChanged">
                            <ComboBoxItem Content="15s" Tag="15" />
                            <ComboBoxItem Content="20s" Tag="20" />
                            <ComboBoxItem Content="25s" Tag="25" />
                            <ComboBoxItem Content="30s" Tag="30" />
                            <ComboBoxItem Content="35s" Tag="35" />
                            <ComboBoxItem Content="40s" Tag="40" />
                            <ComboBoxItem Content="45s" Tag="45" />
                            <ComboBoxItem Content="60s" Tag="60" />
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>


            <!--  widget window settings  -->
            <TextBlock
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Widget Window Appearance" />

            <!--  background material  -->
            <controls:SettingsExpander
                Description="Backdrop effect and color for the widget window"
                Header="Background Material"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xEF1F;}"
                IsExpanded="False">

                <ComboBox
                    x:Name="BackdropComboBox"
                    Width="160"
                    SelectionChanged="BackdropComboBox_SelectionChanged">
                    <ComboBoxItem Content="Desktop Acrylic" Tag="Acrylic" />
                    <ComboBoxItem Content="System Mica" Tag="Mica" />
                    <ComboBoxItem Content="Solid" Tag="None" />
                </ComboBox>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="(Acrylic only)" Header="Tint Opacity">
                        <Slider
                            x:Name="TintSlider"
                            Width="200"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.05"
                            TickFrequency="0.1"
                            ValueChanged="TintSlider_ValueChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="(Acrylic only)" Header="Luminosity Opacity">
                        <Slider
                            x:Name="LuminositySlider"
                            Width="200"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.05"
                            TickFrequency="0.1"
                            ValueChanged="LuminositySlider_ValueChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="(Acrylic and Solid)" Header="Background Color Source">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="BackgroundColorSourceComboBox"
                                Width="160"
                                SelectionChanged="BackgroundColorSourceComboBox_SelectionChanged">
                                <ComboBoxItem Content="Windows Accent" Tag="Accent" />
                                <ComboBoxItem Content="Custom Color" Tag="Custom" />
                            </ComboBox>

                            <controls:ColorPickerButton x:Name="WidgetBackgroundColorPicker" />
                        </StackPanel>

                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  graph appearance  -->
            <controls:SettingsExpander
                Description="Graph color and time range"
                Header="Graph"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE9D2;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Graph Color Source">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="GraphColorSourceComboBox"
                                Width="160"
                                SelectionChanged="GraphColorSourceComboBox_SelectionChanged">
                                <ComboBoxItem Content="Windows Accent" Tag="Accent" />
                                <ComboBoxItem Content="Custom Color" Tag="Custom" />
                            </ComboBox>

                            <controls:ColorPickerButton x:Name="GraphColorPicker" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Time Range">
                        <ComboBox
                            x:Name="GraphTimeSpanComboBox"
                            Width="40"
                            SelectionChanged="GraphTimeSpanComboBox_SelectionChanged">
                            <ComboBoxItem Content="15s" Tag="15" />
                            <ComboBoxItem Content="20s" Tag="20" />
                            <ComboBoxItem Content="30s" Tag="30" />
                            <ComboBoxItem Content="45s" Tag="45" />
                            <ComboBoxItem Content="60s" Tag="60" />
                            <ComboBoxItem Content="90s" Tag="90" />
                            <ComboBoxItem Content="120s" Tag="120" />
                            <ComboBoxItem Content="240s" Tag="240" />
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>


            <!--  taskbar widget & flyout settings  -->
            <TextBlock
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Taskbar Widget &amp; Flyout Appearance" />

            <!--  drag lock for the widget position on the taskbar  -->
            <controls:SettingsCard
                Description="Stop the taskbar widget from being dragged along the taskbar"
                Header="Lock Taskbar Widget Position"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE72E;}">
                <ToggleSwitch
                    x:Name="LockWidgetPositionToggle"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="LockWidgetPositionToggle_Toggled" />
            </controls:SettingsCard>

            <!--  taskbar graph appearance  -->
            <controls:SettingsExpander
                Description="Taskbar graph color, background, time range and graph Width"
                Header="Graph"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE9D2;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Graph Color Source">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="TaskbarGraphColorSourceComboBox"
                                Width="160"
                                SelectionChanged="TaskbarGraphColorSourceComboBox_SelectionChanged">
                                <ComboBoxItem Content="Windows Accent" Tag="Accent" />
                                <ComboBoxItem Content="Custom Color" Tag="Custom" />
                            </ComboBox>

                            <controls:ColorPickerButton x:Name="TaskbarGraphColorPicker" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <!--  transparent drops the calculated tint so the taskbar shows through the graph cards  -->
                    <controls:SettingsCard Header="Graph Background Source">
                        <ComboBox
                            x:Name="TaskbarGraphBackgroundSourceComboBox"
                            Width="160"
                            SelectionChanged="TaskbarGraphBackgroundSourceComboBox_SelectionChanged">
                            <ComboBoxItem Content="Calculated" Tag="Calculated" />
                            <ComboBoxItem Content="Transparent" Tag="Transparent" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Time Range">
                        <ComboBox
                            x:Name="TaskbarGraphTimeSpanComboBox"
                            Width="40"
                            SelectionChanged="TaskbarGraphTimeSpanComboBox_SelectionChanged">
                            <ComboBoxItem Content="15s" Tag="15" />
                            <ComboBoxItem Content="20s" Tag="20" />
                            <ComboBoxItem Content="25s" Tag="25" />
                            <ComboBoxItem Content="30s" Tag="30" />
                            <ComboBoxItem Content="35s" Tag="35" />
                            <ComboBoxItem Content="40s" Tag="40" />
                            <ComboBoxItem Content="45s" Tag="45" />
                            <ComboBoxItem Content="60s" Tag="60" />
                            <ComboBoxItem Content="90s" Tag="90" />
                            <ComboBoxItem Content="120s" Tag="120" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Graph Width">
                        <Slider
                            x:Name="TaskbarGraphWidthSlider"
                            Width="200"
                            Maximum="240"
                            Minimum="60"
                            StepFrequency="5"
                            TickFrequency="20"
                            ValueChanged="TaskbarGraphWidthSlider_ValueChanged" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  flyout alignment over the widget  -->
            <controls:SettingsCard
                Description="Where the flyout lines up relative to the widget"
                Header="Flyout Alignment"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE8E3;}">
                <ComboBox
                    x:Name="TaskbarFlyoutAlignmentComboBox"
                    Width="160"
                    SelectionChanged="TaskbarFlyoutAlignmentComboBox_SelectionChanged">
                    <ComboBoxItem Content="Centered" Tag="Center" />
                    <ComboBoxItem Content="Left" Tag="Left" />
                    <ComboBoxItem Content="Right" Tag="Right" />
                </ComboBox>
            </controls:SettingsCard>

            <!--  flyout background material  -->
            <controls:SettingsExpander
                Description="Backdrop effect and color for the taskbar flyout"
                Header="Flyout Background Material"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xEF1F;}"
                IsExpanded="False">

                <ComboBox
                    x:Name="TaskbarBackdropComboBox"
                    Width="160"
                    SelectionChanged="TaskbarBackdropComboBox_SelectionChanged">
                    <ComboBoxItem Content="Desktop Acrylic" Tag="Acrylic" />
                    <ComboBoxItem Content="System Mica" Tag="Mica" />
                    <ComboBoxItem Content="Solid" Tag="None" />
                </ComboBox>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="(Acrylic only)" Header="Tint Opacity">
                        <Slider
                            x:Name="TaskbarTintSlider"
                            Width="200"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.05"
                            TickFrequency="0.1"
                            ValueChanged="TaskbarTintSlider_ValueChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="(Acrylic only)" Header="Luminosity Opacity">
                        <Slider
                            x:Name="TaskbarLuminositySlider"
                            Width="200"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.05"
                            TickFrequency="0.1"
                            ValueChanged="TaskbarLuminositySlider_ValueChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="(Acrylic and Solid)" Header="Background Color Source">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="TaskbarBackgroundColorSourceComboBox"
                                Width="160"
                                SelectionChanged="TaskbarBackgroundColorSourceComboBox_SelectionChanged">
                                <ComboBoxItem Content="Windows Accent" Tag="Accent" />
                                <ComboBoxItem Content="Custom Color" Tag="Custom" />
                            </ComboBox>

                            <controls:ColorPickerButton x:Name="TaskbarBackgroundColorPicker" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>


            <!--  csv logging settings  -->
            <TextBlock
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="CSV Logging" />

            <!--  everything that shapes a recorded row  -->
            <!--
                the format itself sits in the header slot, the way both background material expanders carry their
                backdrop combo: it is the one choice that decides whether the file opens correctly at all, the three
                inside are refinements
            -->
            <controls:SettingsExpander
                Description="How values are written into a recording"
                Header="CSV Format"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE7C3;}"
                IsExpanded="False">

                <ComboBox
                    x:Name="CsvNumberFormatComboBox"
                    Width="160"
                    SelectionChanged="CsvNumberFormatComboBox_SelectionChanged">
                    <ComboBoxItem Content="Regional" Tag="Local" />
                    <ComboBoxItem Content="Invariant" Tag="Invariant" />
                </ComboBox>

                <!--
                    the one element here that is not a setting, so it sits in the one slot that is not a
                    settings row
                -->
                <!--
                    (same top bar the sensors page puts above its sensor rows; text is built from code, through
                    the same formatter that writes the file)
                -->
                <controls:SettingsExpander.ItemsHeader>
                    <controls:SettingsCard
                        MinHeight="0"
                        Padding="58,12,16,8"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="0"
                        ContentAlignment="Vertical"
                        CornerRadius="0">

                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Example row:" />

                            <TextBlock
                                x:Name="CsvFormatExampleTextBlock"
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </controls:SettingsCard>
                </controls:SettingsExpander.ItemsHeader>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Decimal Places">
                        <ComboBox
                            x:Name="CsvDecimalPlacesComboBox"
                            Width="70"
                            SelectionChanged="CsvDecimalPlacesComboBox_SelectionChanged">
                            <ComboBoxItem Content="0" Tag="0" />
                            <ComboBoxItem Content="1" Tag="1" />
                            <ComboBoxItem Content="2" Tag="2" />
                            <ComboBoxItem Content="3" Tag="3" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Units In Values">
                        <ToggleSwitch
                            x:Name="CsvIncludeUnitsToggle"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="CsvIncludeUnitsToggle_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Pause Behavior">
                        <ComboBox
                            x:Name="CsvPauseSeamComboBox"
                            Width="190"
                            SelectionChanged="CsvPauseSeamComboBox_SelectionChanged">
                            <ComboBoxItem Content="Leave an empty row" Tag="Gap" />
                            <ComboBoxItem Content="Continue seamlessly" Tag="Seamless" />
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>

            </controls:SettingsExpander>


            <!--  backup and reset  -->
            <TextBlock
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Backup &amp; Reset" />

            <controls:SettingsCard
                Description="Backup or restore all settings (Import Restarts the app)"
                Header="Export / Import Settings"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE74E;}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="ExportSettings_Click" Content="Export" />
                    <Button Click="ImportSettings_Click" Content="Import" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsExpander
                Description="Restore individual settings files to defaults (Restarts the app)"
                Header="Reset to Defaults"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE777;}"
                IsExpanded="False">

                <Button Click="ResetAllSettings_Click" Content="Reset All" />

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="Theme, backdrop, update interval, graph appearance, tray behavior" Header="General Settings">
                        <Button Click="ResetGeneralSettings_Click" Content="Reset" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Position and size of all windows, title bar status readout, hardware page sensor selection" Header="Window and Page States">
                        <Button Click="ResetWindowAndPageStates_Click" Content="Reset" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Per-sensor visibility, thresholds, graph scaling, pinned selection" Header="Sensor States">
                        <Button Click="ResetSensorStates_Click" Content="Reset" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
