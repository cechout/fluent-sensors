<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <!--  (tab jumps from card to card, the arrow keys walk every row including the ones inside an expander)  -->
    <ScrollViewer>
        <StackPanel
            Margin="20"
            HorizontalAlignment="Stretch"
            fhUi:ArrowNavigation.IsEnabled="True"
            Spacing="4">

            <TextBlock
                x:Uid="Settings_SettingsText"
                Margin="4,0,0,12"
                Style="{StaticResource SubtitleTextBlockStyle}" />


            <!--  general settings  -->
            <TextBlock
                x:Uid="Settings_GeneralSettingsText"
                Margin="4,8,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <controls:SettingsCard
                x:Uid="Settings_AppThemeCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE790;}">
                <ComboBox
                    x:Name="ThemeComboBox"
                    Width="150"
                    SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_ThemeComboBox_Default" Tag="Default" />
                    <ComboBoxItem x:Uid="Settings_ThemeComboBox_Light" Tag="Light" />
                    <ComboBoxItem x:Uid="Settings_ThemeComboBox_Dark" Tag="Dark" />
                </ComboBox>
            </controls:SettingsCard>

            <!--  app language  -->
            <!--  (the languages after the default come from AppLanguage.Supported, see RestoreLanguageSelection)  -->
            <controls:SettingsCard
                x:Uid="Settings_LanguageCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xF2B7;}">
                <ComboBox
                    x:Name="LanguageComboBox"
                    Width="150"
                    SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_LanguageComboBox_Default" Tag="Default" />
                </ComboBox>
            </controls:SettingsCard>

            <!--  technical terms in english  -->
            <!--  (disabled while the app runs in english, there is nothing to keep; a change asks to restart)  -->
            <controls:SettingsCard
                x:Name="TechnicalTermsCard"
                x:Uid="Settings_TechnicalTermsCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE943;}">
                <ToggleSwitch
                    x:Name="TechnicalTermsToggle"
                    x:Uid="Common_ToggleSwitch"
                    Toggled="TechnicalTermsToggle_Toggled" />
            </controls:SettingsCard>

            <!--  hardware icon colors  -->
            <!--
                (reaches the start page tiles, the sensor list and hidden sensor group headers, and the hardware
                views own headers; graph colors are a per surface choice and sit in their Graph sections instead)
            -->
            <controls:SettingsCard
                x:Uid="Settings_HardwareIconColorsCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE2B1;}">
                <ToggleSwitch
                    x:Name="HardwareIconColorsToggle"
                    x:Uid="Common_ToggleSwitch"
                    Toggled="HardwareIconColorsToggle_Toggled" />
            </controls:SettingsCard>

            <!--  graph rendering  -->
            <!--  (both rows apply to every graph in the app, the per-surface sections below only add color and range)  -->
            <controls:SettingsExpander
                x:Uid="Settings_GraphExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE9D2;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="Settings_LineStyleCard">
                        <ComboBox
                            x:Name="GraphLineStyleComboBox"
                            Width="150"
                            SelectionChanged="GraphLineStyleComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="Settings_GraphLineStyleComboBox_Stepline" Tag="Stepline" />
                            <ComboBoxItem x:Uid="Settings_GraphLineStyleComboBox_Smooth" Tag="Smooth" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <!--  (stays flat while a threshold is tripped, the alarm zones need the other gradient axis)  -->
                    <controls:SettingsCard x:Uid="Settings_FillFadeCard">
                        <ToggleSwitch
                            x:Name="GraphFillFadeToggle"
                            x:Uid="Common_ToggleSwitch"
                            Toggled="GraphFillFadeToggle_Toggled" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  data units  -->
            <!--  (reaches every displayed value; csv recordings keep the byte units the raw values are stored in)  -->
            <controls:SettingsExpander
                x:Uid="Settings_DataUnitsExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE8EF;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="Settings_DataSizeCard">
                        <ComboBox
                            x:Name="DataSizeUnitComboBox"
                            Width="150"
                            SelectionChanged="DataSizeUnitComboBox_SelectionChanged">
                            <ComboBoxItem Content="Byte" Tag="Byte" />
                            <ComboBoxItem Content="Bit" Tag="Bit" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="Settings_DataSpeedCard">
                        <ComboBox
                            x:Name="DataSpeedUnitComboBox"
                            Width="150"
                            SelectionChanged="DataSpeedUnitComboBox_SelectionChanged">
                            <ComboBoxItem Content="Byte" Tag="Byte" />
                            <ComboBoxItem Content="Bit" Tag="Bit" />
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  title bar status readout  -->
            <controls:SettingsExpander
                x:Uid="Settings_TitleBarStatusExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xF138;}"
                IsExpanded="False">

                <ToggleSwitch
                    x:Name="StatusReadoutToggle"
                    x:Uid="Common_ToggleSwitch"
                    Toggled="StatusReadoutToggle_Toggled" />

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Name="StatusLhmGroupCard" x:Uid="Settings_StatusLhmGroupCard">
                        <ToggleSwitch
                            x:Name="StatusLhmGroupToggle"
                            x:Uid="Common_ToggleSwitch"
                            Toggled="StatusLhmGroupToggle_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="StatusWindowsGroupCard" x:Uid="Settings_StatusWindowsGroupCard">
                        <ToggleSwitch
                            x:Name="StatusWindowsGroupToggle"
                            x:Uid="Common_ToggleSwitch"
                            Toggled="StatusWindowsGroupToggle_Toggled" />
                    </controls:SettingsCard>

                    <!--  (stays disabled until both readouts above are on, there is nothing to order otherwise)  -->
                    <controls:SettingsCard x:Name="StatusGroupOrderCard" x:Uid="Settings_StatusGroupOrderCard">
                        <ComboBox
                            x:Name="StatusGroupOrderComboBox"
                            Width="190"
                            SelectionChanged="StatusGroupOrderComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="Settings_StatusGroupOrderComboBox_LhmFirst" Tag="LhmFirst" />
                            <ComboBoxItem x:Uid="Settings_StatusGroupOrderComboBox_WindowsFirst" Tag="WindowsFirst" />
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  behavior settings  -->
            <controls:SettingsCard
                x:Uid="Settings_MinimizeToSystemTrayCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE744;}">
                <ToggleSwitch
                    x:Name="MinimizeToTrayToggle"
                    x:Uid="Common_ToggleSwitch"
                    Toggled="MinimizeToTrayToggle_Toggled" />
            </controls:SettingsCard>

            <!--  startup  -->
            <!--
                no control on the expander header itself, the four rows are independent of each other
                autostart and its delay are hidden in a portable build, see RestoreStartupSelection
            -->
            <controls:SettingsExpander
                x:Uid="Settings_StartupExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE7E8;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Name="RunOnStartupCard" x:Uid="Settings_RunOnStartupCard">
                        <ToggleSwitch
                            x:Name="RunOnStartupToggle"
                            x:Uid="Common_ToggleSwitch"
                            Toggled="RunOnStartupToggle_Toggled" />
                    </controls:SettingsCard>

                    <!--  (stays disabled while autostart is off, there is nothing to delay then)  -->
                    <controls:SettingsCard x:Name="DelayStartupCard" x:Uid="Settings_DelayStartupCard">
                        <ToggleSwitch
                            x:Name="DelayStartupToggle"
                            x:Uid="Common_ToggleSwitch"
                            Toggled="DelayStartupToggle_Toggled" />
                    </controls:SettingsCard>

                    <!--  (applies to the sign-in launch only, opening the app yourself always shows the window)  -->
                    <controls:SettingsCard x:Name="StartMinimizedCard" x:Uid="Settings_StartMinimizedCard">
                        <ToggleSwitch
                            x:Name="StartMinimizedToggle"
                            x:Uid="Common_ToggleSwitch"
                            Toggled="StartMinimizedToggle_Toggled" />
                    </controls:SettingsCard>

                    <!--  (the labels mirror the navigation entries, so both name the same page)  -->
                    <controls:SettingsCard x:Name="StartupPageCard" x:Uid="Settings_StartupPageCard">
                        <ComboBox
                            x:Name="StartupPageComboBox"
                            Width="190"
                            SelectionChanged="StartupPageComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="Settings_StartupPageComboBox_Start" Tag="Start" />
                            <ComboBoxItem x:Uid="Settings_StartupPageComboBox_Sensors" Tag="Sensors" />
                            <ComboBoxItem x:Uid="Settings_StartupPageComboBox_Performance" Tag="Performance" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CheckUpdatesCard" x:Uid="Settings_CheckUpdatesCard">
                        <ToggleSwitch
                            x:Name="CheckUpdatesToggle"
                            x:Uid="Common_ToggleSwitch"
                            Toggled="CheckUpdatesToggle_Toggled" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  engine settings  -->
            <controls:SettingsCard
                x:Uid="Settings_UpdateIntervalCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE916;}">
                <ComboBox
                    x:Name="IntervalComboBox"
                    Width="150"
                    SelectionChanged="IntervalComboBox_SelectionChanged">
                    <ComboBoxItem Content="100ms" Tag="100" />
                    <ComboBoxItem Content="150ms" Tag="150" />
                    <ComboBoxItem Content="200ms" Tag="200" />
                    <ComboBoxItem Content="250ms" Tag="250" />
                    <ComboBoxItem Content="300ms" Tag="300" />
                    <ComboBoxItem Content="400ms" Tag="400" />
                    <ComboBoxItem Content="500ms" Tag="500" />
                    <ComboBoxItem Content="1000ms" Tag="1000" />
                    <ComboBoxItem Content="2000ms" Tag="2000" />
                    <ComboBoxItem Content="5000ms" Tag="5000" />
                </ComboBox>
            </controls:SettingsCard>


            <!--  performance page settings  -->
            <TextBlock
                x:Uid="Settings_PerformancePageAppearanceText"
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <!--  graph appearance  -->
            <controls:SettingsExpander
                x:Uid="Settings_PerformanceGraphExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE9D2;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="Settings_TimeRangeCard">
                        <ComboBox
                            x:Name="PerformanceGraphTimeSpanComboBox"
                            Width="40"
                            DisplayMemberPath="DisplayName"
                            SelectionChanged="PerformanceGraphTimeSpanComboBox_SelectionChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="Settings_CPUExtendedTimeRangeCard">
                        <ComboBox
                            x:Name="PerformanceCpuExtendedGraphTimeSpanComboBox"
                            Width="40"
                            DisplayMemberPath="DisplayName"
                            SelectionChanged="PerformanceCpuExtendedGraphTimeSpanComboBox_SelectionChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="Settings_GPUExtendedTimeRangeCard">
                        <ComboBox
                            x:Name="PerformanceGpuExtendedGraphTimeSpanComboBox"
                            Width="40"
                            DisplayMemberPath="DisplayName"
                            SelectionChanged="PerformanceGpuExtendedGraphTimeSpanComboBox_SelectionChanged" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>


            <!--  widget window settings  -->
            <TextBlock
                x:Uid="Settings_WidgetWindowAppearanceText"
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <!--  background material  -->
            <controls:SettingsExpander
                x:Uid="Settings_BackgroundMaterialExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xEF1F;}"
                IsExpanded="False">

                <ComboBox
                    x:Name="BackdropComboBox"
                    Width="160"
                    SelectionChanged="BackdropComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_BackdropComboBox_Acrylic" Tag="Acrylic" />
                    <ComboBoxItem x:Uid="Settings_BackdropComboBox_Mica" Tag="Mica" />
                    <ComboBoxItem x:Uid="Settings_BackdropComboBox_None" Tag="None" />
                </ComboBox>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Name="TintOpacityCard" x:Uid="Settings_TintOpacityCard">
                        <Slider
                            x:Name="TintSlider"
                            Width="200"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.05"
                            TickFrequency="0.1"
                            ValueChanged="TintSlider_ValueChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="LuminosityOpacityCard" x:Uid="Settings_LuminosityOpacityCard">
                        <Slider
                            x:Name="LuminositySlider"
                            Width="200"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.05"
                            TickFrequency="0.1"
                            ValueChanged="LuminositySlider_ValueChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="BackgroundColorSourceCard" x:Uid="Settings_BackgroundColorSourceCard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="BackgroundColorSourceComboBox"
                                x:Uid="Settings_BackgroundColorSourceComboBox"
                                Width="160"
                                SelectionChanged="BackgroundColorSourceComboBox_SelectionChanged">
                                <ComboBoxItem x:Uid="Settings_BackgroundColorSourceComboBox_Accent" Tag="Accent" />
                                <ComboBoxItem x:Uid="Settings_BackgroundColorSourceComboBox_Custom" Tag="Custom" />
                            </ComboBox>

                            <controls:ColorPickerButton x:Name="WidgetBackgroundColorPicker" x:Uid="Settings_WidgetBackgroundColorPicker" />
                        </StackPanel>

                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  graph appearance  -->
            <controls:SettingsExpander
                x:Uid="Settings_WidgetGraphExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE9D2;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="Settings_GraphColorSourceCard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="GraphColorSourceComboBox"
                                x:Uid="Settings_GraphColorSourceComboBox"
                                Width="160"
                                SelectionChanged="GraphColorSourceComboBox_SelectionChanged">
                                <ComboBoxItem x:Uid="Settings_GraphColorSourceComboBox_Accent" Tag="Accent" />
                                <ComboBoxItem x:Uid="Settings_GraphColorSourceComboBox_Custom" Tag="Custom" />
                                <ComboBoxItem x:Uid="Settings_GraphColorSourceComboBox_Hardware" Tag="Hardware" />
                            </ComboBox>

                            <controls:ColorPickerButton x:Name="GraphColorPicker" x:Uid="Settings_GraphColorPicker" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="Settings_TimeRangeCard">
                        <ComboBox
                            x:Name="GraphTimeSpanComboBox"
                            Width="40"
                            DisplayMemberPath="DisplayName"
                            SelectionChanged="GraphTimeSpanComboBox_SelectionChanged" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>


            <!--  taskbar widget & flyout appearance settings  -->
            <!--  (the jump target of the gear button in the taskbar flyout, see ScrollToTaskbarSection)  -->
            <TextBlock
                x:Name="TaskbarSectionHeader"
                x:Uid="Settings_TaskbarSectionHeader"
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <!--  the taskbar edge the per edge settings below belong to  -->
            <!--
                (the position is filled in at runtime from the edge the taskbar sits on; MinHeight and Padding
                override the 68 and 16 the toolkit style sets, so this read only row stays lower than the others)
            -->
            <controls:SettingsCard
                x:Uid="Settings_CurrentTaskbarPositionCard"
                MinHeight="40"
                Padding="16,12,16,12"
                fhUi:FocusGroup.IsEnabled="True"
                Background="{ThemeResource ControlFillColorTertiaryBrush}">
                <TextBlock x:Name="TaskbarPositionText" VerticalAlignment="Center" />
            </controls:SettingsCard>

            <!--  taskbar graph appearance  -->
            <controls:SettingsExpander
                x:Uid="Settings_TaskbarGraphExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE9D2;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="Settings_TaskbarGraphColorSourceCard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="TaskbarGraphColorSourceComboBox"
                                x:Uid="Settings_TaskbarGraphColorSourceComboBox"
                                Width="160"
                                SelectionChanged="TaskbarGraphColorSourceComboBox_SelectionChanged">
                                <ComboBoxItem x:Uid="Settings_TaskbarGraphColorSourceComboBox_Accent" Tag="Accent" />
                                <ComboBoxItem x:Uid="Settings_TaskbarGraphColorSourceComboBox_Custom" Tag="Custom" />
                                <ComboBoxItem x:Uid="Settings_TaskbarGraphColorSourceComboBox_Hardware" Tag="Hardware" />
                            </ComboBox>

                            <controls:ColorPickerButton x:Name="TaskbarGraphColorPicker" x:Uid="Settings_TaskbarGraphColorPicker" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <!--  transparent drops the calculated tint so the taskbar shows through the graph cards  -->
                    <controls:SettingsCard x:Uid="Settings_GraphBackgroundSourceCard">
                        <ComboBox
                            x:Name="TaskbarGraphBackgroundSourceComboBox"
                            Width="160"
                            SelectionChanged="TaskbarGraphBackgroundSourceComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="Settings_TaskbarGraphBackgroundSourceComboBox_Calculated" Tag="Calculated" />
                            <ComboBoxItem x:Uid="Settings_TaskbarGraphBackgroundSourceComboBox_Transparent" Tag="Transparent" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="Settings_TimeRangeCard">
                        <ComboBox
                            x:Name="TaskbarGraphTimeSpanComboBox"
                            Width="40"
                            DisplayMemberPath="DisplayName"
                            SelectionChanged="TaskbarGraphTimeSpanComboBox_SelectionChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="Settings_GraphWidthCard">
                        <Slider
                            x:Name="TaskbarGraphWidthSlider"
                            Width="200"
                            Maximum="180"
                            Minimum="30"
                            StepFrequency="5"
                            TickFrequency="20"
                            ValueChanged="TaskbarGraphWidthSlider_ValueChanged" />
                    </controls:SettingsCard>

                    <!--  side taskbar slot; (only with the taskbar on the left or right)  -->
                    <controls:SettingsCard x:Name="TaskbarSideGraphDirectionCard" x:Uid="Settings_TaskbarSideGraphDirectionCard">
                        <ComboBox
                            x:Name="TaskbarSideGraphDirectionComboBox"
                            Width="160"
                            SelectionChanged="TaskbarSideGraphDirectionComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="Settings_TaskbarSideGraphDirectionComboBox_RightToLeft" Tag="RightToLeft" />
                            <ComboBoxItem x:Uid="Settings_TaskbarSideGraphDirectionComboBox_TopToBottom" Tag="TopToBottom" />
                            <ComboBoxItem x:Uid="Settings_TaskbarSideGraphDirectionComboBox_BottomToTop" Tag="BottomToTop" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="TaskbarSideTitleLinesCard" x:Uid="Settings_TaskbarSideTitleLinesCard">
                        <ComboBox
                            x:Name="TaskbarSideTitleLinesComboBox"
                            Width="160"
                            SelectionChanged="TaskbarSideTitleLinesComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="Settings_TaskbarSideTitleLinesComboBox_1" Tag="1" />
                            <ComboBoxItem x:Uid="Settings_TaskbarSideTitleLinesComboBox_2" Tag="2" />
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  flyout alignment over the widget  -->
            <controls:SettingsCard
                x:Uid="Settings_FlyoutAlignmentCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE8E3;}">
                <ComboBox
                    x:Name="TaskbarFlyoutAlignmentComboBox"
                    Width="160"
                    SelectionChanged="TaskbarFlyoutAlignmentComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_TaskbarFlyoutAlignmentComboBox_Center" Tag="Center" />
                    <ComboBoxItem x:Uid="Settings_TaskbarFlyoutAlignmentComboBox_Left" Tag="Left" />
                    <ComboBoxItem x:Uid="Settings_TaskbarFlyoutAlignmentComboBox_Right" Tag="Right" />
                </ComboBox>
            </controls:SettingsCard>

            <!--  flyout graph appearance  -->
            <controls:SettingsExpander
                x:Uid="Settings_FlyoutGraphExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE9D2;}"
                IsExpanded="False">

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="Settings_TimeRangeCard">
                        <ComboBox
                            x:Name="TaskbarFlyoutGraphTimeSpanComboBox"
                            Width="40"
                            DisplayMemberPath="DisplayName"
                            SelectionChanged="TaskbarFlyoutGraphTimeSpanComboBox_SelectionChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="Settings_GraphHeightCard">
                        <Slider
                            x:Name="TaskbarFlyoutGraphHeightSlider"
                            Width="200"
                            Maximum="180"
                            Minimum="90"
                            StepFrequency="5"
                            TickFrequency="20"
                            ValueChanged="TaskbarFlyoutGraphHeightSlider_ValueChanged" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  flyout background material  -->
            <controls:SettingsExpander
                x:Uid="Settings_FlyoutBackgroundMaterialExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xEF1F;}"
                IsExpanded="False">

                <ComboBox
                    x:Name="TaskbarBackdropComboBox"
                    Width="160"
                    SelectionChanged="TaskbarBackdropComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_TaskbarBackdropComboBox_Acrylic" Tag="Acrylic" />
                    <ComboBoxItem x:Uid="Settings_TaskbarBackdropComboBox_Mica" Tag="Mica" />
                    <ComboBoxItem x:Uid="Settings_TaskbarBackdropComboBox_None" Tag="None" />
                </ComboBox>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Name="TaskbarTintOpacityCard" x:Uid="Settings_TaskbarTintOpacityCard">
                        <Slider
                            x:Name="TaskbarTintSlider"
                            Width="200"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.05"
                            TickFrequency="0.1"
                            ValueChanged="TaskbarTintSlider_ValueChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="TaskbarLuminosityOpacityCard" x:Uid="Settings_TaskbarLuminosityOpacityCard">
                        <Slider
                            x:Name="TaskbarLuminositySlider"
                            Width="200"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.05"
                            TickFrequency="0.1"
                            ValueChanged="TaskbarLuminositySlider_ValueChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="TaskbarBackgroundColorSourceCard" x:Uid="Settings_TaskbarBackgroundColorSourceCard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="TaskbarBackgroundColorSourceComboBox"
                                x:Uid="Settings_TaskbarBackgroundColorSourceComboBox"
                                Width="160"
                                SelectionChanged="TaskbarBackgroundColorSourceComboBox_SelectionChanged">
                                <ComboBoxItem x:Uid="Settings_TaskbarBackgroundColorSourceComboBox_Accent" Tag="Accent" />
                                <ComboBoxItem x:Uid="Settings_TaskbarBackgroundColorSourceComboBox_Custom" Tag="Custom" />
                            </ComboBox>

                            <controls:ColorPickerButton x:Name="TaskbarBackgroundColorPicker" x:Uid="Settings_TaskbarBackgroundColorPicker" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>


            <!--  taskbar widget & flyout behavior settings  -->
            <TextBlock
                x:Uid="Settings_TaskbarWidgetFlyoutBehaviorText"
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <!--  drag lock for the widget position on the taskbar  -->
            <controls:SettingsCard
                x:Uid="Settings_LockTaskbarWidgetPositionCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE72E;}">
                <ToggleSwitch
                    x:Name="LockWidgetPositionToggle"
                    x:Uid="Common_ToggleSwitch"
                    Toggled="LockWidgetPositionToggle_Toggled" />
            </controls:SettingsCard>

            <!--  flyout shortcut  -->
            <!--  (the keys as accent buttons and an edit pencil; a click opens FlyoutShortcutDialog, keys set from code)  -->
            <controls:SettingsCard
                x:Uid="Settings_FlyoutShortcutCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE765;}">
                <Button
                    x:Name="FlyoutShortcutButton"
                    Padding="4,4,8,4"
                    Click="FlyoutShortcutButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel
                            x:Name="FlyoutShortcutKeysPanel"
                            Orientation="Horizontal"
                            Spacing="4">
                            <StackPanel.Resources>
                                <!--  (accent buttons in look only; the click goes to the button around them)  -->
                                <Style
                                    x:Key="ShortcutKeyStyle"
                                    BasedOn="{StaticResource AccentButtonStyle}"
                                    TargetType="Button">
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="MinWidth" Value="32" />
                                    <Setter Property="Padding" Value="8,0,8,0" />
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
                                </Style>
                            </StackPanel.Resources>
                        </StackPanel>
                        <TextBlock
                            x:Name="FlyoutShortcutNoneText"
                            x:Uid="Settings_FlyoutShortcutNoneText"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="&#xE70F;" />
                    </StackPanel>
                </Button>
            </controls:SettingsCard>


            <!--  csv logging settings  -->
            <TextBlock
                x:Uid="Settings_CSVLoggingText"
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <!--  everything that shapes a recorded row  -->
            <!--
                (the format sits in the header slot like the backdrop combos; it decides whether the file opens
                correctly at all, the three inside refine it)
            -->
            <controls:SettingsExpander
                x:Uid="Settings_CSVFormatExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE7C3;}"
                IsExpanded="False">

                <ComboBox
                    x:Name="CsvNumberFormatComboBox"
                    Width="160"
                    SelectionChanged="CsvNumberFormatComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_CsvNumberFormatComboBox_Local" Tag="Local" />
                    <ComboBoxItem x:Uid="Settings_CsvNumberFormatComboBox_Invariant" Tag="Invariant" />
                </ComboBox>

                <!--
                    (same top bar the sensors page puts above its sensor rows; text is built from code, through
                    the same formatter that writes the file)
                -->
                <controls:SettingsExpander.ItemsHeader>
                    <controls:SettingsCard
                        MinHeight="0"
                        Padding="58,12,16,8"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="0"
                        ContentAlignment="Vertical"
                        CornerRadius="0">

                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Uid="Settings_ExampleRowText"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}" />

                            <TextBlock
                                x:Name="CsvFormatExampleTextBlock"
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </controls:SettingsCard>
                </controls:SettingsExpander.ItemsHeader>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="Settings_DecimalPlacesCard">
                        <ComboBox
                            x:Name="CsvDecimalPlacesComboBox"
                            Width="70"
                            SelectionChanged="CsvDecimalPlacesComboBox_SelectionChanged">
                            <ComboBoxItem Content="0" Tag="0" />
                            <ComboBoxItem Content="1" Tag="1" />
                            <ComboBoxItem Content="2" Tag="2" />
                            <ComboBoxItem Content="3" Tag="3" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="Settings_UnitsInValuesCard">
                        <ToggleSwitch
                            x:Name="CsvIncludeUnitsToggle"
                            x:Uid="Common_ToggleSwitch"
                            Toggled="CsvIncludeUnitsToggle_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="Settings_PauseBehaviorCard">
                        <ComboBox
                            x:Name="CsvPauseSeamComboBox"
                            Width="190"
                            SelectionChanged="CsvPauseSeamComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="Settings_CsvPauseSeamComboBox_Gap" Tag="Gap" />
                            <ComboBoxItem x:Uid="Settings_CsvPauseSeamComboBox_Seamless" Tag="Seamless" />
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>

            </controls:SettingsExpander>


            <!--  backup and reset  -->
            <TextBlock
                x:Uid="Settings_BackupResetText"
                Margin="4,20,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <!--  (the path is filled in at runtime, it differs per distribution channel)  -->
            <controls:SettingsCard
                x:Name="AppDataFolderCard"
                x:Uid="Settings_AppDataFolderCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE8B7;}">
                <Button x:Uid="Settings_OpenAppDataButton" Click="OpenAppDataFolder_Click" />
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Uid="Settings_ExportImportSettingsCard"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE74E;}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="Settings_ExportButton" Click="ExportSettings_Click" />
                    <Button x:Uid="Settings_ImportButton" Click="ImportSettings_Click" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsExpander
                x:Uid="Settings_ResetToDefaultsExpander"
                fhUi:FocusGroup.IsEnabled="True"
                HeaderIcon="{toolkit:FontIcon Glyph=&#xE777;}"
                IsExpanded="False">

                <Button x:Uid="Settings_ResetAllButton" Click="ResetAllSettings_Click" />

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="Settings_GeneralSettingsCard">
                        <Button x:Uid="Settings_ResetButton" Click="ResetGeneralSettings_Click" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="Settings_WindowAndPageStatesCard">
                        <Button x:Uid="Settings_ResetButton" Click="ResetWindowAndPageStates_Click" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="Settings_SensorStatesCard">
                        <Button x:Uid="Settings_ResetButton" Click="ResetSensorStates_Click" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
