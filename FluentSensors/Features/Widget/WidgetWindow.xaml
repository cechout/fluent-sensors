<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSensors.Features.Widget.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhCommon="using:FluentSensors.Common.Sensors"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhTimeRange="using:FluentSensors.Controls.TimeRange"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Fluent Sensors"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  custom title bar: title  -->
        <!--  (as tall as before, when it held the back button and the time range picker)  -->
        <Grid
            x:Name="CustomTitleBar"
            Grid.Row="0"
            Height="26"
            Background="Transparent">
            <TextBlock
                Margin="12,4,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="System Sensors" />
        </Grid>


        <!--  the graphs  -->
        <!--  (stretched to fill the height together)  -->
        <Grid Grid.Row="1" Padding="4,0,4,5">
            <ItemsControl ItemsSource="{x:Bind ViewModel.PinnedSensors, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <fhControls:VerticalStretchPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="fhGraph:SensorGraphViewModel">
                        <fhGraph:SensorPanelControl
                            ShowStatusRow="True"
                            ShowThresholdControls="True"
                            ShowYAxisControls="True"
                            ViewModel="{x:Bind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>


        <!--  bottom bar: back to the main window and time range + pause  -->
        <!--  (flat buttons at the height the title bar had them, a plain divider above)  -->
        <Border
            Grid.Row="2"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="4" fhUi:FocusGroup.IsEnabled="True">

                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="4">

                    <!--  back to the main window  -->
                    <Button
                        x:Name="BackToDashboardButton"
                        Width="32"
                        Height="22"
                        Padding="0"
                        AutomationProperties.Name="Back to Main Application"
                        Click="BackToDashboard_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Back to Main Application">
                        <FontIcon
                            FontSize="14"
                            FontWeight="SemiLight"
                            Glyph="&#xE944;" />
                    </Button>

                    <!--  graph time range  -->
                    <fhTimeRange:TimeRangePickerControl
                        x:Name="TimeRangePicker"
                        Height="22"
                        Options="{x:Bind fhCommon:GraphTimeRanges.Widget}"
                        TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!--  pause  -->
                <!--  (freezes and resumes every graph; name, tooltip and glyph set in ApplyPauseState)  -->
                <Button
                    x:Name="PauseButton"
                    Width="32"
                    Height="22"
                    Padding="0"
                    HorizontalAlignment="Right"
                    Click="PauseButton_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon x:Name="PauseButtonIcon" FontSize="14" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
