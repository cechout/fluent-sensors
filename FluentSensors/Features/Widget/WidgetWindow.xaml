<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSensors.Features.Widget.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhCommon="using:FluentSensors.Common.Sensors"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhTimeRange="using:FluentSensors.Controls.TimeRange"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Fluent Sensors"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            acrylic grain: the material paints noise last, the backdrop controller does not; below every fill, so it
            grains the material and not the text or graphs; shown by WindowBackdrop for system acrylic with Windows
            transparency on, sized from code like the taskbar flyout grain
        -->
        <Canvas
            x:Name="NoiseHost"
            Grid.RowSpan="3"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Rectangle x:Name="NoiseOverlay" />
        </Canvas>

        <!--  custom title bar: title  -->
        <!--  (26 tall; part of ChromeHeight in code; the text is the window name, set in the constructor)  -->
        <Grid
            x:Name="CustomTitleBar"
            Grid.Row="0"
            Height="26"
            Background="Transparent">
            <TextBlock
                x:Name="TitleText"
                Margin="12,3,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>


        <!--  the graphs  -->
        <!--  (stretched to fill the height together)  -->
        <Grid Grid.Row="1" Padding="4,8,4,8">
            <ItemsControl ItemsSource="{x:Bind ViewModel.PinnedSensors, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <fhControls:VerticalStretchPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="fhGraph:SensorGraphViewModel">
                        <fhGraph:SensorPanelControl
                            ShowStatusRow="True"
                            ShowThresholdControls="True"
                            ShowYAxisControls="True"
                            ViewModel="{x:Bind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>


        <!--  bottom bar: back to the main window and time range on the left, z-order and pause on the right  -->
        <!--  (flat 22 px buttons, a plain divider above; part of ChromeHeight in code)  -->
        <Border
            Grid.Row="2"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="4" fhUi:FocusGroup.IsEnabled="True">

                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="4">

                    <!--  back to the main window  -->
                    <Button
                        x:Name="BackToDashboardButton"
                        x:Uid="Widget_BackToDashboardButton"
                        Width="32"
                        Height="22"
                        Padding="0"
                        Click="BackToDashboard_Click"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon
                            FontSize="14"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE944;" />
                    </Button>

                    <!--  graph time range  -->
                    <fhTimeRange:TimeRangePickerControl
                        x:Name="TimeRangePicker"
                        Height="22"
                        Padding="8,0,8,0"
                        Options="{x:Bind fhCommon:GraphTimeRanges.Widget}"
                        TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">

                    <!--  z-order  -->
                    <!--
                        (on top, normal, pinned to desktop: a fixed arrow up with a bar over it, through its middle or
                        under it, on a 15 px grid at half pixels; arrow and bar are one geometry from ApplyZOrder, so the
                        crossing is not drawn twice; a click flashes the accent bar)
                    -->
                    <Button
                        x:Name="ZOrderButton"
                        Width="32"
                        Height="22"
                        Padding="0"
                        Click="ZOrderButton_Click"
                        Style="{StaticResource SubtleButtonStyle}">
                        <Canvas Width="15" Height="15">
                            <Path
                                x:Name="ZOrderIcon"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1" />
                            <Line
                                x:Name="ZOrderBarAccent"
                                Opacity="0"
                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1" />
                        </Canvas>
                    </Button>

                    <!--  pause  -->
                    <!--  (freezes and resumes every graph; name, tooltip and glyph set in ApplyPauseState)  -->
                    <Button
                        x:Name="PauseButton"
                        Width="32"
                        Height="22"
                        Padding="0"
                        Click="PauseButton_Click"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon
                            x:Name="PauseButtonIcon"
                            FontSize="14"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
