<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.PerformanceStartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:local="using:FluentSensors.Features.Performance"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>

            <!--  plain-Button version of PerformancePages SidebarNavToggleButtonStyle; same subtle background/hover/pressed  -->
            <!--  language, minus the Checked states, since a tile is a one-shot navigation action, not a persisted  -->
            <!--  selection; pressed state additionally dims the content itself, on top of the background change, as a  -->
            <!--  clearer press cue  -->
            <Style x:Key="StartTileButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder" CornerRadius="5">
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <ItemsControl Margin="8" ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}">

            <!--  (same SquareGridPanel layout idea as GPU Extended view)  -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <fhControls:SquareGridPanel MinCellWidth="280" Spacing="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PerformanceNavItemViewModel">
                    <Button Click="Tile_Click" Style="{StaticResource StartTileButtonStyle}">

                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>


                            <!--  header  -->
                            <!--  hardware type icon, group label, hardware name  -->
                            <Grid Grid.Row="0" Margin="8,4,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Grid instead of a horizontal StackPanel: a StackPanel always measures its children at infinite width along  -->
                                <!--  its own orientation axis and never compresses them back down on arrange, so TextTrimming below never had an  -->
                                <!--  actual width to trim against; the Star column here does constrain it correctly  -->
                                <Grid Grid.Column="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="20"
                                        Glyph="{x:Bind GroupIconGlyph, Mode=OneTime}" />

                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{x:Bind GroupLabel, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel
                                    Grid.Column="1"
                                    Padding="8,0,0,0"
                                    Orientation="Horizontal"
                                    Spacing="12">

                                    <!--  (later for hiding hardware groups?)  -->
                                    <!--<FontIcon
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondary}"
                                        Glyph="&#xED1A;" />-->
                                    <FontIcon
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Glyph="&#xE76C;" />
                                </StackPanel>

                            </Grid>


                            <!--  graph  -->
                            <!--  (the same PrimaryGraph the sidebar shows, but rendered as a full SensorPanelControl)  -->
                            <!--  (no hover, no side controls, not even hit-testable)  -->
                            <fhGraph:SensorPanelControl
                                Grid.Row="1"
                                Height="130"
                                GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                IsGraphHoverEnabled="False"
                                IsHitTestVisible="False"
                                ShowCompactStatusRow="True"
                                ShowStatusRow="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind PrimaryGraph, Mode=OneWay}" />
                        </Grid>

                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
    </ScrollViewer>
</UserControl>
