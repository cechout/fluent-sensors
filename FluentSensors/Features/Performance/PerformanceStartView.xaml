<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.PerformanceStartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:local="using:FluentSensors.Features.Performance"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>

            <!--  plain-Button version of PerformancePages SidebarNavToggleButtonStyle; same subtle background/hover/pressed  -->
            <!--  language, minus the Checked states, since the header is a one-shot navigation action, not a persisted  -->
            <!--  selection; only the header navigates, the panel below it stays fully interactive  -->
            <Style x:Key="StartTileHeaderButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,4,8,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder" CornerRadius="5">
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <ItemsControl Margin="16" ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}">

            <!--  same SquareGridPanel layout idea as GPU Extended view, just flat: one grid over every NavItem, no  -->
            <!--  grouping into sections  -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <fhControls:SquareGridPanel MinCellWidth="320" Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PerformanceNavItemViewModel">

                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  header: same sidebar content (group label + hardware name), clickable to jump into that  -->
                        <!--  hardwares detail view  -->
                        <Button
                            Grid.Row="0"
                            Click="Header_Click"
                            Style="{StaticResource StartTileHeaderButtonStyle}">
                            <StackPanel>
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind GroupLabel, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <!--  the same PrimaryGraph the sidebar shows, but rendered as a full SensorPanelControl instead of  -->
                        <!--  the sidebars bare mini graph; scaling stays inherited from the graphs own state (no  -->
                        <!--  override), exactly like the sidebar reads PrimaryGraph.IsAutoScaled/ManualYMax  -->
                        <fhGraph:SensorPanelControl
                            Grid.Row="1"
                            Height="150"
                            GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                            ShowStatusRow="True"
                            ShowThresholdControls="True"
                            ShowYAxisControls="True"
                            ThresholdLabelAlwaysVisible="False"
                            ViewModel="{x:Bind PrimaryGraph, Mode=OneWay}" />
                    </Grid>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
    </ScrollViewer>
</UserControl>
