<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Performance.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhLhm="using:FluentSensors.Features.Performance.Lhm"
    xmlns:local="using:FluentSensors.Features.Performance"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: control buttons  -->
        <Border
            Grid.Row="0"
            Padding="16,0,10,1"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PerformanceTitleText"
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Performance" />

                <CommandBar
                    x:Name="PerformanceCommandBar"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    DefaultLabelPosition="Right">

                    <!--  placeholders, not final  -->
                    <AppBarButton x:Name="PlaceholderButtonOne" Label="Placeholder 1" />
                    <AppBarButton x:Name="PlaceholderButtonTwo" Label="Placeholder 2" />

                </CommandBar>

            </Grid>
        </Border>


        <!--  content: hardware selection sidebar + detail area  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                sidebar: hardware selection, one unified list for every category (Cpu/Ram are always present,
                Gpu/Storage/Network are added reactively as PerformanceViewModel discovers them)
            -->
            <Border
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="8" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PerformanceNavItemViewModel">
                                <Button
                                    Padding="8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="NavItem_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            mini graph placeholder; real per-instance mini graphs are a
                                            separate future step, selection highlighting likewise
                                        -->
                                        <Border
                                            Grid.Column="0"
                                            Width="48"
                                            Height="38"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>


            <!--  detail area  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  header for one hardware  -->
                <!--  group label (left) + hardware display name (right) for the selected nav item  -->
                <Border
                    Grid.Row="0"
                    Padding="16,12,16,0"
                    Background="Transparent"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,0">
                    <Grid>
                        <TextBlock
                            Margin="4,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="24"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedItem.GroupLabel, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedItem.DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>


                <!--  CPU detail content  -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    Visibility="{x:Bind ShowIfCpuSelected(ViewModel.SelectedItem), Mode=OneWay}">
                    <StackPanel Padding="16,8,16,16" Spacing="12">
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{x:Bind GetSelectedCpu(ViewModel.SelectedItem), Mode=OneWay}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="fhLhm:LhmCpuInstanceViewModel">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid.Resources>

                                            <!--  1 tile for 1 sensor: sensor name + current value, no graph  -->
                                            <!--  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"  -->
                                            <DataTemplate x:Key="SensorValueTileTemplate" x:DataType="fhGraph:SensorGraphViewModel">
                                                <Border
                                                    Padding="2"
                                                    Background="Transparent"
                                                    CornerRadius="4">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind SensorName, Mode=OneWay}" />
                                                        <TextBlock
                                                            Foreground="{x:Bind CurrentValueColor, Mode=OneWay}"
                                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                                            Text="{x:Bind CurrentValueText, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>

                                            <!--  1 border for 1 physical core  -->
                                            <!--  it stack whicever threads, temperatur, clocks it actually has  -->
                                            <DataTemplate x:Key="CpuCoreCellTemplate" x:DataType="fhLhm:LhmCpuCoreViewModel">
                                                <Border
                                                    Padding="0"
                                                    Background="Transparent"
                                                    CornerRadius="4">
                                                    <Grid RowSpacing="2">
                                                        <Grid.RowDefinitions>
                                                            <!--  core title  -->
                                                            <!--  (from the Temperature sensors raw name)  -->
                                                            <RowDefinition Height="Auto" />
                                                            <!--  threads  -->
                                                            <RowDefinition Height="2*" />
                                                            <!--  temperature  -->
                                                            <RowDefinition Height="*" />
                                                            <!--  clock  -->
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <!--  core title  -->
                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Margin="4,0,0,0"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Temperature.SensorName, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <!--  threads graphs  -->
                                                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Threads, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <fhControls:VerticalStretchPanel Spacing="2" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="fhGraph:SensorGraphViewModel">
                                                                    <fhGraph:SensorPanelControl
                                                                        GraphColorOverride="#FF00B7C3"
                                                                        GraphDataPointsOverride="70"
                                                                        GraphTapAction="ShowFlyout"
                                                                        IsAutoScaledOverride="False"
                                                                        ManualYMaxOverride="100"
                                                                        ShowGraphLabel="True"
                                                                        ShowThresholdFlyoutIndicator="False"
                                                                        ShowTitleRow="False"
                                                                        ThresholdLabelAlwaysVisible="False"
                                                                        ViewModel="{x:Bind}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!--  temperature graph  -->
                                                        <fhGraph:SensorPanelControl
                                                            Grid.Row="2"
                                                            GraphColorOverride="#FFFFB900"
                                                            GraphDataPointsOverride="70"
                                                            GraphTapAction="ShowFlyout"
                                                            IsAutoScaledOverride="False"
                                                            ManualYMaxOverride="100"
                                                            ShowGraphLabel="True"
                                                            ShowThresholdFlyoutIndicator="False"
                                                            ShowTitleRow="False"
                                                            ThresholdLabelAlwaysVisible="False"
                                                            ViewModel="{x:Bind Temperature, Mode=OneWay}" />

                                                        <!--  clock graph  -->
                                                        <fhGraph:SensorPanelControl
                                                            Grid.Row="3"
                                                            GraphColorOverride="#FF00CC6A"
                                                            GraphDataPointsOverride="70"
                                                            GraphTapAction="ShowFlyout"
                                                            IsAutoScaledOverride="False"
                                                            ManualYMaxOverride="5000"
                                                            ShowGraphLabel="True"
                                                            ShowThresholdFlyoutIndicator="False"
                                                            ShowTitleRow="False"
                                                            ThresholdLabelAlwaysVisible="False"
                                                            ViewModel="{x:Bind Clock, Mode=OneWay}" />

                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </Grid.Resources>

                                        <!--  first: overall cpu view  -->
                                        <!--  total load (big) + max temperature / power, stacked  -->
                                        <Grid
                                            Grid.Row="0"
                                            ColumnSpacing="8"
                                            RowSpacing="8"
                                            Visibility="{x:Bind OverallVisibility, Mode=OneWay}">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>

                                            <fhGraph:SensorPanelControl
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                MinHeight="180"
                                                GraphColorOverride="#FF00B7C3"
                                                GraphDataPointsOverride="180"
                                                IsAutoScaledOverride="False"
                                                ManualYMaxOverride="100"
                                                ShowStatusRow="True"
                                                ShowThresholdControls="True"
                                                ShowYAxisControls="True"
                                                ThresholdLabelAlwaysVisible="True"
                                                ViewModel="{x:Bind TotalLoad, Mode=OneWay}" />

                                            <fhGraph:SensorPanelControl
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                MinHeight="100"
                                                GraphColorOverride="#FFFFB900"
                                                GraphDataPointsOverride="120"
                                                IsAutoScaledOverride="False"
                                                ManualYMaxOverride="100"
                                                ShowStatusRow="True"
                                                ShowThresholdControls="True"
                                                ShowYAxisControls="True"
                                                ThresholdLabelAlwaysVisible="True"
                                                ViewModel="{x:Bind MaxTemperature, Mode=OneWay}" />

                                            <fhGraph:SensorPanelControl
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                MinHeight="100"
                                                GraphColorOverride="#FFFFB900"
                                                GraphDataPointsOverride="120"
                                                IsAutoScaledOverride="False"
                                                ManualYMaxOverride="150"
                                                ShowStatusRow="True"
                                                ShowThresholdControls="True"
                                                ShowYAxisControls="True"
                                                ThresholdLabelAlwaysVisible="True"
                                                ViewModel="{x:Bind PackagePower, Mode=OneWay}" />
                                        </Grid>

                                        <!--  extra row: quick-glance tiles (left) + static hardware info (right)  -->
                                        <!--  same visibility as the graphs above; not relevant while browsing individual cores  -->
                                        <Grid
                                            Grid.Row="1"
                                            ColumnSpacing="12"
                                            Visibility="{x:Bind OverallVisibility, Mode=OneWay}">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  left: 3 stacked value tiles  -->
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <ContentControl
                                                    HorizontalContentAlignment="Stretch"
                                                    Content="{x:Bind TotalLoad, Mode=OneWay}"
                                                    ContentTemplate="{StaticResource SensorValueTileTemplate}" />
                                                <ContentControl
                                                    HorizontalContentAlignment="Stretch"
                                                    Content="{x:Bind MaxTemperature, Mode=OneWay}"
                                                    ContentTemplate="{StaticResource SensorValueTileTemplate}" />
                                                <ContentControl
                                                    HorizontalContentAlignment="Stretch"
                                                    Content="{x:Bind PackagePower, Mode=OneWay}"
                                                    ContentTemplate="{StaticResource SensorValueTileTemplate}" />
                                            </StackPanel>

                                            <!--  right: static CPU hardware info (raw draft, no final styling yet)  -->
                                            <!--  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"  -->
                                            <Border
                                                Grid.Column="1"
                                                Padding="2"
                                                Background="Transparent"
                                                CornerRadius="4">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="CPU Static Info" />

                                                    <Grid ColumnSpacing="8" RowSpacing="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="Physical Cores" />
                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Text="{x:Bind CpuPhysicalCoresText}" />

                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="Logical Processors" />
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Text="{x:Bind CpuLogicalProcessorsText}" />

                                                        <TextBlock
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="L2 Cache" />
                                                        <TextBlock
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            Text="{x:Bind CpuL2CacheText}" />

                                                        <TextBlock
                                                            Grid.Row="3"
                                                            Grid.Column="0"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="L3 Cache" />
                                                        <TextBlock
                                                            Grid.Row="3"
                                                            Grid.Column="1"
                                                            Text="{x:Bind CpuL3CacheText}" />

                                                        <TextBlock
                                                            Grid.Row="4"
                                                            Grid.Column="0"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="Max Clock Speed" />
                                                        <TextBlock
                                                            Grid.Row="4"
                                                            Grid.Column="1"
                                                            Text="{x:Bind CpuMaxClockText}" />

                                                        <TextBlock
                                                            Grid.Row="5"
                                                            Grid.Column="0"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="Socket" />
                                                        <TextBlock
                                                            Grid.Row="5"
                                                            Grid.Column="1"
                                                            Text="{x:Bind CpuSocketText}" />

                                                        <TextBlock
                                                            Grid.Row="6"
                                                            Grid.Column="0"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="Virtualization (Firmware)" />
                                                        <TextBlock
                                                            Grid.Row="6"
                                                            Grid.Column="1"
                                                            Text="{x:Bind CpuVirtualizationFirmwareText}"
                                                            ToolTipService.ToolTip="Known unreliable on some systems" />

                                                        <TextBlock
                                                            Grid.Row="7"
                                                            Grid.Column="0"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="Virtualization Extensions" />
                                                        <TextBlock
                                                            Grid.Row="7"
                                                            Grid.Column="1"
                                                            Text="{x:Bind CpuVirtualizationExtensionsText}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!--  second: all cpu cores view  -->
                                        <!--  (cores with threads on top and cores withput threads below)  -->
                                        <Grid Grid.Row="0" Visibility="{x:Bind AllThreadsVisibility, Mode=OneWay}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <ItemsControl
                                                Grid.Row="0"
                                                ItemTemplate="{StaticResource CpuCoreCellTemplate}"
                                                ItemsSource="{x:Bind CoresWithThreads, Mode=OneWay}"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollMode="Disabled">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <fhControls:SquareGridPanel MinCellHeight="200" Spacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <Border
                                                Grid.Row="1"
                                                Height="0"
                                                Margin="16"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <ItemsControl
                                                Grid.Row="2"
                                                ItemTemplate="{StaticResource CpuCoreCellTemplate}"
                                                ItemsSource="{x:Bind CoresWithoutThreads, Mode=OneWay}"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollMode="Disabled">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <fhControls:SquareGridPanel MinCellHeight="200" Spacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Grid>

                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                    </StackPanel>
                </ScrollViewer>

                <!--  CPU bottom bar (Overall / All Threads toggle); same visibility as the CPU content above  -->
                <Border
                    Grid.Row="2"
                    Padding="16,0,10,1"
                    Background="Transparent"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{x:Bind ShowIfCpuSelected(ViewModel.SelectedItem), Mode=OneWay}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CommandBar
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="False"
                            IsOpen="False">

                            <CommandBar.Resources>
                                <SolidColorBrush x:Key="CommandBarBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                                <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />

                                <Thickness x:Key="AppBarButtonPadding">0,0,0,0</Thickness>
                            </CommandBar.Resources>

                            <AppBarButton
                                x:Name="ShowOverallButton"
                                Click="ShowOverall_Click"
                                Label="Overall">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE9D9;" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarButton
                                x:Name="ShowAllThreadsButton"
                                Click="ShowAllThreads_Click"
                                Label="All Threads">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE80A;" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                        </CommandBar>

                    </Grid>
                </Border>

            </Grid>

        </Grid>
    </Grid>
</Page>