<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Performance.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentSensors.Features.Performance"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: control buttons  -->
        <Border
            Grid.Row="0"
            Padding="16,0,10,1"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PerformanceTitleText"
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Performance" />

                <CommandBar
                    x:Name="PerformanceCommandBar"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    DefaultLabelPosition="Right">

                    <!--  placeholders, not final  -->
                    <AppBarButton x:Name="PlaceholderButtonOne" Label="Placeholder 1" />
                    <AppBarButton x:Name="PlaceholderButtonTwo" Label="Placeholder 2" />

                </CommandBar>

            </Grid>
        </Border>


        <!--  content: hardware selection sidebar + detail area  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                sidebar: hardware selection, one unified list for every category (Cpu/Ram are always present,
                Gpu/Storage/Network are added reactively as PerformanceViewModel discovers them)
            -->
            <Border
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="8" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PerformanceNavItemViewModel">
                                <Button
                                    Padding="8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="NavItem_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            mini graph placeholder; real per-instance mini graphs are a
                                            separate future step, selection highlighting likewise
                                        -->
                                        <Border
                                            Grid.Column="0"
                                            Width="48"
                                            Height="38"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>


            <!--  detail area  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  header for one hardware  -->
                <!--  group label (left) + hardware display name (right) for the selected nav item  -->
                <Border
                    Grid.Row="0"
                    Padding="16,12,16,0"
                    Background="Transparent"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,0">
                    <Grid>
                        <TextBlock
                            Margin="4,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="26"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedItem.GroupLabel, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,0,4,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedItem.DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>


                <!--
                    detail content host: filled/replaced entirely from code-behind on every selection change,
                    no ContentControl/ContentTemplateSelector - see UpdateDetailView. Every switch tears the
                    previous hardware-specific view down completely and builds a brand new instance, instead
                    of letting WinUI silently recycle the old one; recycling caused stale frozen graphs and,
                    worse, TwoWay threshold bindings leaking state into the wrong sensor
                -->
                <Grid x:Name="DetailHostGrid" Grid.Row="1" />

            </Grid>

        </Grid>
    </Grid>
</Page>