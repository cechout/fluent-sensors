<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Performance.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhLhm="using:FluentSensors.Features.Performance.Lhm"
    xmlns:hw="using:FluentSensors.Features.Performance.HardwareViews"
    xmlns:local="using:FluentSensors.Features.Performance"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>

        <DataTemplate x:Key="CpuDetailTemplate" x:DataType="fhLhm:LhmCpuInstanceViewModel">
            <hw:CpuDetailView Cpu="{x:Bind}" />
        </DataTemplate>

        <!--  picks the content template by the runtime type of the ContentControl belows content  -->
        <!--  (adding a new hardware kind means one more keyed template here + one more property in the selector)  -->
        <local:HardwareDetailTemplateSelector x:Key="HardwareDetailTemplateSelector" CpuTemplate="{StaticResource CpuDetailTemplate}" />

    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  header: control buttons  -->
        <Border
            Grid.Row="0"
            Padding="16,0,10,1"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PerformanceTitleText"
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Performance" />

                <CommandBar
                    x:Name="PerformanceCommandBar"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    DefaultLabelPosition="Right">

                    <!--  placeholders, not final  -->
                    <AppBarButton x:Name="PlaceholderButtonOne" Label="Placeholder 1" />
                    <AppBarButton x:Name="PlaceholderButtonTwo" Label="Placeholder 2" />

                </CommandBar>

            </Grid>
        </Border>


        <!--  content  -->
        <!--  left: selection sidebar, right: hardware detail view  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  sidebar: hardware selection  -->
            <Border
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="8" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PerformanceNavItemViewModel">
                                <Button
                                    Padding="8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="NavItem_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  mini graph for the hardware  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="48"
                                            Height="38"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>


            <!--  hardware view detail area  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  header for one hardware  -->
                <!--  left: group label + right: hardware display name  -->
                <Border
                    Grid.Row="0"
                    Padding="16,12,16,0"
                    Background="Transparent"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,0">
                    <Grid>
                        <TextBlock
                            Margin="4,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            FontSize="26"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedItem.GroupLabel, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,0,4,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedItem.DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!--  HardwareDetailTemplateSelector picks the matching hardware-specific view  -->
                <ContentControl
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{x:Bind ViewModel.SelectedItem.Target, Mode=OneWay}"
                    ContentTemplateSelector="{StaticResource HardwareDetailTemplateSelector}" />

            </Grid>

        </Grid>
    </Grid>
</Page>