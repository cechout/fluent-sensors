<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.NetworkDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhCommon="using:FluentSensors.Common.Sensors"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:fhPerf="using:FluentSensors.Features.Performance"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:fhTimeRange="using:FluentSensors.Controls.TimeRange"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:loc="using:FluentSensors.Common.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="4*" />
            <ColumnDefinition
                x:Name="InfoPanelColumn"
                Width="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnWidth, Mode=OneWay}"
                MinWidth="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnMinWidth, Mode=OneWay}"
                MaxWidth="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnMaxWidth, Mode=OneWay}" />
        </Grid.ColumnDefinitions>


        <!--  view content with header, graphs and tiles  -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="0"
            Grid.Column="0"
            fhUi:FocusSkip.IsEnabled="True"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="ContentScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentStackPanel"
                Padding="16,16,16,16"
                Spacing="14">


                <!--  header  -->
                <Grid
                    x:Name="HeaderGrid"
                    Background="Transparent"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <FontIcon
                            Margin="0,0,0,-2"
                            FontSize="20"
                            Foreground="{x:Bind GroupIconBrush, Mode=OneWay}"
                            Glyph="{x:Bind Network.IconGlyph, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,0,0,0"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind GroupLabel, Mode=OneTime}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,4,2"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Network.PerformanceDisplayName, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>


                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="OverviewBlockGrid"
                        Grid.Row="0"
                        Margin="0,0,0,4"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  utilization (big, switchable) beside upload and download; narrow: all three stacked  -->
                        <Grid
                            x:Name="GraphsAreaGrid"
                            Grid.Row="0"
                            SizeChanged="GraphsAreaGrid_SizeChanged">

                            <Grid
                                x:Name="WideGraphsGrid"
                                MinHeight="190"
                                ColumnSpacing="8"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Network Utilization"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Network.NetworkUtilizationOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.NetworkUtilization, Mode=TwoWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Upload Speed"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.UploadSpeed, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Download Speed"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.DownloadSpeed, Mode=OneWay}" />
                            </Grid>

                            <Grid
                                x:Name="NarrowGraphsPanel"
                                MinHeight="360"
                                IsHitTestVisible="False"
                                Opacity="0"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5*" />
                                    <RowDefinition Height="3*" />
                                    <RowDefinition Height="3*" />
                                </Grid.RowDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Network Utilization"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Network.NetworkUtilizationOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.NetworkUtilization, Mode=TwoWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Upload Speed"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.UploadSpeed, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="2"
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Download Speed"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.DownloadSpeed, Mode=OneWay}" />
                            </Grid>
                        </Grid>

                        <!--  current value tiles  -->
                        <Grid
                            x:Name="TilesGrid"
                            Grid.Row="1"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  graph time range  -->
                            <!--  (inside this grid so RecalculateOverviewHeight measures it together with the tiles)  -->
                            <fhTimeRange:TimeRangePickerControl
                                Grid.Row="0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.Performance}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.StandardGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <controls:WrapPanel
                                Grid.Row="1"
                                Margin="4,0,4,0"
                                HorizontalSpacing="16"
                                VerticalSpacing="0">
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Network.NetworkUtilization.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="00,0 %"
                                    ViewModel="{x:Bind Network.NetworkUtilization, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Network.UploadSpeed.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="00,0 Mb/s"
                                    ViewModel="{x:Bind Network.UploadSpeed, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Network.DownloadSpeed.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="00,0 Mb/s"
                                    ViewModel="{x:Bind Network.DownloadSpeed, Mode=OneWay}" />
                            </controls:WrapPanel>
                        </Grid>
                    </Grid>

                    <!--  view 2: extended, in groups like the gpu extended view  -->
                    <!--
                        (no sensor tiles in this view; a group lays its graphs out in a grid and has a time range
                        picker of its own; in reading order the value that depends on the others comes first and
                        what it rests on last, like the overview)
                    -->
                    <StackPanel
                        x:Name="ExtendedGrid"
                        Grid.Row="0"
                        Margin="0,0,0,4"
                        x:Load="False"
                        IsHitTestVisible="{x:Bind Network.ExtendedIsHitTestVisible, Mode=OneWay}"
                        Opacity="{x:Bind Network.ExtendedOpacity, Mode=OneWay}"
                        Spacing="24">

                        <!--  traffic: the three graphs of the overview, the utilization without its switch  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Network_SectionTraffic')}" />
                            <fhControls:SquareGridPanel
                                MinCellHeight="90"
                                MinCellWidth="260"
                                Spacing="12">
                                <fhGraph:SensorPanelControl
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Network Utilization"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.ExtendedNetworkUtilization, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Upload Speed"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.UploadSpeed, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Download Speed"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.DownloadSpeed, Mode=OneWay}" />
                            </fhControls:SquareGridPanel>

                            <!--  graph time range  -->
                            <fhTimeRange:TimeRangePickerControl
                                Margin="0,-4,0,0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.Performance}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.StandardGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!--  wi-fi: what the link can carry first (transmit, receive), then the signal it rests on  -->
                        <!--  (the sensors of the Windows source; the group is gone while its switch is off or the adapter is wired)  -->
                        <StackPanel Spacing="8" Visibility="{x:Bind Network.WifiSectionVisibility, Mode=OneWay}">
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Network_WiFi')}" />
                            <fhControls:SquareGridPanel
                                MinCellHeight="90"
                                MinCellWidth="260"
                                Spacing="12">
                                <fhGraph:SensorPanelControl
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Transmit Link Rate"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.TransmitLinkRate, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Receive Link Rate"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.ReceiveLinkRate, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="Signal Strength"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.SignalStrength, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="-100"
                                    PlaceholderSensorName="RSSI"
                                    PlaceholderUnit="dBm"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.Rssi, Mode=OneWay}" />
                            </fhControls:SquareGridPanel>

                            <!--  graph time range  -->
                            <fhTimeRange:TimeRangePickerControl
                                Margin="0,-4,0,0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.Performance}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.StandardGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!--  data: the totals since the adapter came up  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Network_SectionData')}" />
                            <fhControls:SquareGridPanel
                                MinCellHeight="90"
                                MinCellWidth="260"
                                Spacing="12">
                                <fhGraph:SensorPanelControl
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Data Uploaded"
                                    PlaceholderUnit="GB"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.DataUploaded, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphHardwareKind="Network"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Data Downloaded"
                                    PlaceholderUnit="GB"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Network.DataDownloaded, Mode=OneWay}" />
                            </fhControls:SquareGridPanel>

                            <!--  graph time range  -->
                            <fhTimeRange:TimeRangePickerControl
                                Margin="0,-4,0,0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.Performance}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.StandardGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--  bottom bar: overall and extended  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Padding="16,0,10,1"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">

            <CommandBar
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                fhUi:FocusGroup.IsEnabled="True"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="False"
                IsOpen="False">

                <CommandBar.Resources>
                    <SolidColorBrush x:Key="CommandBarBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                    <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />

                    <Thickness x:Key="AppBarButtonPadding">0,0,0,0</Thickness>
                </CommandBar.Resources>

                <AppBarButton x:Uid="Network_ShowOverallButton" Click="ShowOverall_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xF16B;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton x:Uid="Network_ShowExtendedButton" Click="ShowExtended_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xF0E2;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Border>



        <!--  info panel: static hardware facts for the selected adapter  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            fhUi:FocusSkip.IsEnabled="True"
            Background="Transparent"
            BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelVisibility, Mode=OneWay}">

            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Margin="16" Spacing="24">
                    <TextBlock
                        Margin="0,0,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind loc:AppTerms.Get('Network_NetworkInfo')}" />

                    <!--  general  -->
                    <StackPanel Spacing="12">
                        <fhInfoPopup:InfoPopupControl
                            x:Uid="Network_GeneralPopup"
                            Margin="0,0,0,-4"
                            PlacementMode="TitleAnchored">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="NetworkInterface (.NET)" Url="https://learn.microsoft.com/en-us/dotnet/api/system.net.networkinformation.networkinterface" />
                                <fhInfoPopup:SourceLink Label="WlanQueryInterface" Url="https://learn.microsoft.com/en-us/windows/win32/api/wlanapi/nf-wlanapi-wlanqueryinterface" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>

                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="Network_HardwareText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Network.NetworkNameText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    x:Uid="Network_TypeText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkInterfaceTypeText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_MACAddress')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkMacAddressText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Network_LinkSpeedReceiveTransmit')}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Network.NetworkSpeedPairText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!--  wi-fi; only a wireless adapter that is connected  -->
                    <StackPanel Spacing="12" Visibility="{x:Bind BoolToVisibility(Network.IsWlan), Mode=OneWay}">
                        <fhInfoPopup:InfoPopupControl
                            x:Uid="Network_WiFiPopup"
                            Title="{x:Bind loc:AppTerms.Get('Network_WiFi')}"
                            Margin="0,0,0,-4"
                            PlacementMode="TitleAnchored">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="WlanQueryInterface" Url="https://learn.microsoft.com/en-us/windows/win32/api/wlanapi/nf-wlanapi-wlanqueryinterface" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_WlanStandard')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkWlanStandardText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_WlanBand')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkWlanBandText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_WlanChannel')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkWlanChannelText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_WlanSecurity')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkWlanSecurityText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>
                    </StackPanel>

                    <!--  driver  -->
                    <StackPanel Spacing="12">
                        <fhInfoPopup:InfoPopupControl
                            x:Uid="Network_DriverPopup"
                            Title="{x:Bind loc:AppTerms.Get('Network_Driver')}"
                            Margin="0,0,0,-4"
                            PlacementMode="TitleAnchored">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="MSFT_NetAdapter" Url="https://learn.microsoft.com/en-us/windows/win32/fwp/wmi/netadaptercimprov/msft-netadapter" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_DriverVersion')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkDriverVersionText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_DriverDate')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkDriverDateText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_DriverProvider')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkDriverProviderText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>
                    </StackPanel>

                    <!--  ip addresses  -->
                    <StackPanel Spacing="12">
                        <fhInfoPopup:InfoPopupControl
                            x:Uid="Network_IPAddressesPopup"
                            Title="{x:Bind loc:AppTerms.Get('Network_IPAddresses')}"
                            Margin="0,0,0,-4"
                            PlacementMode="TitleAnchored">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="IPInterfaceProperties (.NET)" Url="https://learn.microsoft.com/en-us/dotnet/api/system.net.networkinformation.ipinterfaceproperties" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Network_IPv4Addresses')}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Network.NetworkIPv4AddressesText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Network_IPv6Addresses')}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Network.NetworkIPv6AddressesText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Network_Gateway')}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Network.NetworkGatewaysText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Network_DnsServers')}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Network.NetworkDnsServersText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_DHCPEnabled')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkDhcpEnabledText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Network_DhcpServer')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Network.NetworkDhcpServersText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  info panel splitter  -->
        <!--  (a 9px band centered on the divider line; it resizes the content column before it)  -->
        <fhControls:ClampedGridSplitter
            x:Uid="Network_ResizeHardwareInfoSplitter"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="9"
            Margin="-4,0,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            IsTabStop="False"
            IsThumbVisible="False"
            ManipulationCompleted="InfoPanelSplitter_ManipulationCompleted"
            ResizeBehavior="PreviousAndCurrent"
            ResizeDirection="Columns"
            Visibility="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelVisibility, Mode=OneWay}" />

    </Grid>
</UserControl>
