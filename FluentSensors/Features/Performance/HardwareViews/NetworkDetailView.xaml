<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.NetworkDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="ContentScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        SizeChanged="ContentScrollViewer_SizeChanged"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel
            x:Name="ContentStackPanel"
            Padding="16,8,16,16"
            Spacing="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="OverviewBlockGrid"
                    Grid.Row="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  upload + download; wide: side by side, narrow: stacked, switched via SizeChanged  -->
                    <Grid
                        x:Name="GraphsAreaGrid"
                        Grid.Row="0"
                        SizeChanged="GraphsAreaGrid_SizeChanged">

                        <Grid
                            x:Name="WideGraphsGrid"
                            MinHeight="200"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <fhGraph:SensorPanelControl
                                Grid.Column="0"
                                GraphColorOverride="#FFbf5977"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Network.UploadSpeed, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Column="1"
                                GraphColorOverride="#FFbf5977"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Network.DownloadSpeed, Mode=OneWay}" />
                        </Grid>

                        <fhControls:VerticalStretchPanel
                            x:Name="NarrowGraphsPanel"
                            MinHeight="240"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Spacing="8">
                            <fhGraph:SensorPanelControl
                                GraphColorOverride="#FFbf5977"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Network.UploadSpeed, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                GraphColorOverride="#FFbf5977"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Network.DownloadSpeed, Mode=OneWay}" />
                        </fhControls:VerticalStretchPanel>
                    </Grid>

                    <!--  current value tiles  -->
                    <Grid x:Name="TilesGrid" Grid.Row="1">
                        <controls:WrapPanel
                            Margin="0,0,0,16"
                            HorizontalSpacing="8"
                            VerticalSpacing="8">
                            <fhTile:SensorTileControl
                                Title="Upload Speed"
                                Width="110"
                                ViewModel="{x:Bind Network.UploadSpeed, Mode=OneWay}" />
                            <fhTile:SensorTileControl
                                Title="Download Speed"
                                Width="110"
                                ViewModel="{x:Bind Network.DownloadSpeed, Mode=OneWay}" />
                        </controls:WrapPanel>
                    </Grid>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>