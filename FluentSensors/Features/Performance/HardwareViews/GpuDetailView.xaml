<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.GpuDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="ContentScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        SizeChanged="ContentScrollViewer_SizeChanged"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel
            x:Name="ContentStackPanel"
            Padding="16,8,16,16"
            Spacing="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="OverviewBlockGrid"
                    Grid.Row="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  row 1: core load (big) + hot spot temp + package power - same shape as CPU  -->
                    <Grid
                        x:Name="GraphsAreaGrid1"
                        Grid.Row="0"
                        SizeChanged="GraphsAreaGrid1_SizeChanged">

                        <Grid
                            x:Name="WideGraphsGrid1"
                            MinHeight="200"
                            ColumnSpacing="8"
                            RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                GraphColorOverride="#FF00B7C3"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="100"
                                PlaceholderSensorName="GPU Core"
                                PlaceholderUnit="%"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.CoreLoad, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                Grid.Column="1"
                                GraphColorOverride="#FFFFB900"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="100"
                                PlaceholderSensorName="GPU Hot Spot"
                                PlaceholderUnit="°C"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.HotSpotTemperature, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="1"
                                Grid.Column="1"
                                GraphColorOverride="#FF8764B8"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="150"
                                PlaceholderSensorName="GPU Package"
                                PlaceholderUnit="W"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.PackagePower, Mode=OneWay}" />
                        </Grid>

                        <Grid
                            x:Name="NarrowGraphsPanel1"
                            MinHeight="280"
                            RowSpacing="8"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                GraphColorOverride="#FF00B7C3"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="100"
                                PlaceholderSensorName="GPU Core"
                                PlaceholderUnit="%"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.CoreLoad, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="1"
                                GraphColorOverride="#FFFFB900"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="100"
                                PlaceholderSensorName="GPU Hot Spot"
                                PlaceholderUnit="°C"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.HotSpotTemperature, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="2"
                                GraphColorOverride="#FF8764B8"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="150"
                                PlaceholderSensorName="GPU Package"
                                PlaceholderUnit="W"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.PackagePower, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                    <!--  row 2: memory used (big) + core/memory clock stacked - mirrored version of row 1  -->
                    <Grid
                        x:Name="GraphsAreaGrid2"
                        Grid.Row="1"
                        SizeChanged="GraphsAreaGrid2_SizeChanged">

                        <Grid
                            x:Name="WideGraphsGrid2"
                            MinHeight="200"
                            ColumnSpacing="8"
                            RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                Grid.Column="0"
                                GraphColorOverride="#FF00CC6A"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                PlaceholderSensorName="GPU Core"
                                PlaceholderUnit="MHz"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.CoreClock, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="1"
                                Grid.Column="0"
                                GraphColorOverride="#FF00CC6A"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                PlaceholderSensorName="GPU Memory"
                                PlaceholderUnit="MHz"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.MemoryClock, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                GraphColorOverride="#FF0078D4"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="{x:Bind Gpu.MemoryTotal, Mode=OneWay}"
                                PlaceholderSensorName="GPU Memory Used"
                                PlaceholderUnit="MB"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.MemoryUsed, Mode=OneWay}" />
                        </Grid>

                        <Grid
                            x:Name="NarrowGraphsPanel2"
                            MinHeight="280"
                            RowSpacing="8"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                GraphColorOverride="#FF0078D4"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="{x:Bind Gpu.MemoryTotal, Mode=OneWay}"
                                PlaceholderSensorName="GPU Memory Used"
                                PlaceholderUnit="MB"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.MemoryUsed, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="1"
                                GraphColorOverride="#FF00CC6A"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                PlaceholderSensorName="GPU Core"
                                PlaceholderUnit="MHz"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.CoreClock, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="2"
                                GraphColorOverride="#FF00CC6A"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                PlaceholderSensorName="GPU Memory"
                                PlaceholderUnit="MHz"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Gpu.MemoryClock, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                    <!--  current value tiles  -->
                    <Grid x:Name="TilesGrid" Grid.Row="2">
                        <StackPanel
                            Margin="0,0,0,16"
                            Orientation="Horizontal"
                            Spacing="8">
                            <fhTile:SensorTileControl
                                Title="GPU Core Load"
                                Width="100"
                                ViewModel="{x:Bind Gpu.CoreLoad, Mode=OneWay}" />
                            <fhTile:SensorTileControl
                                Title="Hot Spot"
                                Width="90"
                                ViewModel="{x:Bind Gpu.HotSpotTemperature, Mode=OneWay}" />
                            <fhTile:SensorTileControl
                                Title="Package Power"
                                Width="100"
                                ViewModel="{x:Bind Gpu.PackagePower, Mode=OneWay}" />
                            <fhTile:SensorTileControl
                                Title="VRAM Used"
                                Width="120"
                                ViewModel="{x:Bind Gpu.MemoryUsed, Mode=OneWay}" />
                            <fhTile:SensorTileControl
                                Title="Core Clock"
                                Width="120"
                                ViewModel="{x:Bind Gpu.CoreClock, Mode=OneWay}" />
                            <fhTile:SensorTileControl
                                Title="VRAM Clock"
                                Width="120"
                                ViewModel="{x:Bind Gpu.MemoryClock, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>