<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.GpuDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhCommon="using:FluentSensors.Common.Sensors"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:fhPerf="using:FluentSensors.Features.Performance"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:fhTimeRange="using:FluentSensors.Controls.TimeRange"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:loc="using:FluentSensors.Common.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="4*" />
            <ColumnDefinition
                x:Name="InfoPanelColumn"
                Width="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnWidth, Mode=OneWay}"
                MinWidth="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnMinWidth, Mode=OneWay}"
                MaxWidth="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnMaxWidth, Mode=OneWay}" />
        </Grid.ColumnDefinitions>


        <!--  view content with header, graphs and tiles  -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="0"
            Grid.Column="0"
            fhUi:FocusSkip.IsEnabled="True"
            Background="Transparent"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="ContentScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentStackPanel"
                Padding="16,16,16,16"
                Spacing="14">


                <!--  header  -->
                <Grid
                    x:Name="HeaderGrid"
                    Background="Transparent"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <FontIcon
                            Margin="0,0,0,-2"
                            FontSize="20"
                            Foreground="{x:Bind GroupIconBrush, Mode=OneWay}"
                            Glyph="{x:Bind GroupIconGlyph, Mode=OneTime}" />
                        <TextBlock
                            Margin="0,0,0,0"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind GroupLabel, Mode=OneTime}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,4,2"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Gpu.HardwareName, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>


                <Grid x:Name="PageContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  gpu view 1: overview (Load, Temperature, Power), the switchable 3-slot CPU layout  -->
                    <Grid
                        x:Name="OverviewBlockGrid"
                        Grid.Row="0"
                        Margin="0,0,0,4"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="GraphsAreaGrid"
                            Grid.Row="0"
                            Background="Transparent"
                            SizeChanged="GraphsAreaGrid_SizeChanged">

                            <Grid
                                x:Name="WideGraphsGrid"
                                MinHeight="190"
                                ColumnSpacing="8"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Core"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.CoreLoad, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Temperature"
                                    PlaceholderUnit="°C"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.TemperatureOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.Temperature, Mode=TwoWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="GPU Power"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.PackagePowerOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.PackagePower, Mode=TwoWay}" />
                            </Grid>

                            <!--  (narrow: all 3 stacked, first weighted bigger)  -->
                            <Grid
                                x:Name="NarrowGraphsPanel"
                                MinHeight="360"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                Opacity="0"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5*" />
                                    <RowDefinition Height="3*" />
                                    <RowDefinition Height="3*" />
                                </Grid.RowDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Core"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.CoreLoad, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Temperature"
                                    PlaceholderUnit="°C"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.TemperatureOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.Temperature, Mode=TwoWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="2"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="GPU Power"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.PackagePowerOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.PackagePower, Mode=TwoWay}" />
                            </Grid>
                        </Grid>

                        <!--  current graph value tiles  -->
                        <Grid
                            x:Name="TilesGrid"
                            Grid.Row="1"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  graph time range  -->
                            <!--  (inside this grid so UpdateOverviewHeight measures it together with the tiles)  -->
                            <fhTimeRange:TimeRangePickerControl
                                Grid.Row="0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.Performance}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.StandardGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <controls:WrapPanel
                                Grid.Row="1"
                                Margin="4,0,4,0"
                                HorizontalSpacing="16"
                                VerticalSpacing="0">
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Gpu.CoreLoad.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="00,0 %"
                                    ViewModel="{x:Bind Gpu.CoreLoad, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Gpu.Temperature.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="00,0 °C"
                                    ViewModel="{x:Bind Gpu.Temperature, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Gpu.PackagePower.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="000,0 W"
                                    ViewModel="{x:Bind Gpu.PackagePower, Mode=OneWay}" />
                            </controls:WrapPanel>
                        </Grid>
                    </Grid>


                    <!--  gpu view 2: extended, grouped by theme instead of by core  -->
                    <!--  (no sensor tiles in this view)  -->
                    <Grid
                        x:Name="ExtendedGrid"
                        Grid.Row="0"
                        Margin="0,0,0,4"
                        x:Load="False"
                        IsHitTestVisible="{x:Bind Gpu.ExtendedIsHitTestVisible, Mode=OneWay}"
                        Opacity="{x:Bind Gpu.ExtendedOpacity, Mode=OneWay}"
                        RowSpacing="24">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  core; (Power and Voltage at the top, they have no group of their own)  -->
                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Gpu_Core')}" />
                            <fhControls:SquareGridPanel
                                MinCellHeight="90"
                                MinCellWidth="260"
                                Spacing="12">
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="GPU Power"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.ExtendedPackagePowerOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.ExtendedPackagePower, Mode=TwoWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Core"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.ExtendedCoreLoad, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="GPU Core"
                                    PlaceholderUnit="MHz"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.CoreClock, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Core"
                                    PlaceholderUnit="°C"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.CoreTemperature, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Hot Spot"
                                    PlaceholderUnit="°C"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.HotSpotTemperature, Mode=OneWay}" />
                            </fhControls:SquareGridPanel>

                            <!--  graph time range  -->
                            <fhTimeRange:TimeRangePickerControl
                                x:Uid="Gpu_ExtendedTimeRangePicker"
                                Margin="0,-4,0,0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.PerformanceExtended}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.GpuExtendedGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!--  memory; (Memory Free is part of the MemoryUsed switch)  -->
                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Gpu_Memory')}" />
                            <fhControls:SquareGridPanel
                                MinCellHeight="90"
                                MinCellWidth="260"
                                Spacing="12">
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="{x:Bind Gpu.MemoryTotal, Mode=OneWay}"
                                    PlaceholderSensorName="GPU Memory Used"
                                    PlaceholderUnit="MB"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.MemoryUsedOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.MemoryUsed, Mode=TwoWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="GPU Memory"
                                    PlaceholderUnit="MHz"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.MemoryClock, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Memory Controller"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.MemoryControllerLoad, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="D3D Shared Memory Used"
                                    PlaceholderUnit="MB"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.D3dSharedMemoryUsed, Mode=OneWay}" />
                            </fhControls:SquareGridPanel>

                            <!--  graph time range  -->
                            <fhTimeRange:TimeRangePickerControl
                                x:Uid="Gpu_ExtendedTimeRangePicker"
                                Margin="0,-4,0,0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.PerformanceExtended}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.GpuExtendedGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!--  pcie / bus  -->
                        <StackPanel Grid.Row="2" Spacing="8">
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Gpu_PCIeBus')}" />
                            <fhControls:SquareGridPanel
                                MinCellHeight="90"
                                MinCellWidth="260"
                                Spacing="12">
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="GPU PCIe Rx"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.PcieRx, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="GPU PCIe Tx"
                                    PlaceholderUnit="MB/s"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.PcieTx, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Bus"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.BusLoad, Mode=OneWay}" />
                            </fhControls:SquareGridPanel>

                            <!--  graph time range  -->
                            <fhTimeRange:TimeRangePickerControl
                                x:Uid="Gpu_ExtendedTimeRangePicker"
                                Margin="0,-4,0,0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.PerformanceExtended}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.GpuExtendedGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!--  engines: 1 fixed anchor + 4 switchable slots sharing the full D3D pool  -->
                        <StackPanel Grid.Row="3" Spacing="8">
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Gpu_Engines')}" />
                            <fhControls:SquareGridPanel
                                MinCellHeight="90"
                                MinCellWidth="260"
                                Spacing="12">
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="GPU Video Engine"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.VideoEngineLoad, Mode=OneWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="D3D Engine"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.D3dEngineOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.D3dEngineSlot1, Mode=TwoWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="D3D Engine"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.D3dEngineOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.D3dEngineSlot2, Mode=TwoWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="D3D Engine"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.D3dEngineOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.D3dEngineSlot3, Mode=TwoWay}" />
                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="D3D Engine"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Gpu.D3dEngineOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Gpu.D3dEngineSlot4, Mode=TwoWay}" />
                            </fhControls:SquareGridPanel>

                            <!--  graph time range  -->
                            <fhTimeRange:TimeRangePickerControl
                                x:Uid="Gpu_ExtendedTimeRangePicker"
                                Margin="0,-4,0,0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.PerformanceExtended}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.GpuExtendedGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>


        <!--  gpu bottom bar  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Padding="16,0,10,1"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CommandBar
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    fhUi:FocusGroup.IsEnabled="True"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="False"
                    IsOpen="False">

                    <CommandBar.Resources>
                        <SolidColorBrush x:Key="CommandBarBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                        <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />

                        <Thickness x:Key="AppBarButtonPadding">0,0,0,0</Thickness>
                    </CommandBar.Resources>

                    <AppBarButton
                        x:Name="ShowOverallButton"
                        x:Uid="Gpu_ShowOverallButton"
                        Click="ShowOverall_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xF16B;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="ShowExtendedButton"
                        x:Uid="Gpu_ShowExtendedButton"
                        Click="ShowExtended_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xF0E2;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </Border>


        <!--  info panel: static hardware facts for the selected GPU  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            fhUi:FocusSkip.IsEnabled="True"
            Background="Transparent"
            BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelVisibility, Mode=OneWay}">

            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Margin="16" Spacing="24">
                    <TextBlock
                        Margin="0,0,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind loc:AppTerms.Get('Gpu_GPUInfo')}" />

                    <!--  general  -->
                    <StackPanel Spacing="12">
                        <fhInfoPopup:InfoPopupControl
                            x:Uid="Gpu_GeneralPopup"
                            Margin="0,0,0,-4"
                            PlacementMode="TitleAnchored">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="Win32_VideoController" Url="https://learn.microsoft.com/en-us/windows/win32/cimwin32prov/win32-videocontroller" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>

                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="Gpu_NameText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Gpu.GpuNameText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Gpu_Vendor')}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Gpu.GpuVendorText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind loc:AppTerms.Get('Gpu_DriverVersion')}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Gpu.GpuDriverVersionText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!--  memory types  -->
                    <StackPanel Spacing="12">
                        <fhInfoPopup:InfoPopupControl
                            x:Uid="Gpu_MemoryPopup"
                            Title="{x:Bind loc:AppTerms.Get('Gpu_Memory')}"
                            Margin="0,0,0,-4"
                            PlacementMode="TitleAnchored">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="IDXGIAdapter1::GetDesc1 (DXGI)" Url="https://learn.microsoft.com/en-us/windows/win32/api/dxgi/nf-dxgi-idxgiadapter1-getdesc1" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Gpu_DedicatedMemory')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Gpu.GpuDedicatedMemoryText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Gpu_SharedMemory')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Gpu.GpuSharedMemoryText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>
                    </StackPanel>

                    <!--  identifiers  -->
                    <StackPanel Spacing="12">
                        <fhInfoPopup:InfoPopupControl
                            x:Uid="Gpu_IdentifiersPopup"
                            Title="{x:Bind loc:AppTerms.Get('Gpu_Identifiers')}"
                            Margin="0,0,0,-4"
                            PlacementMode="TitleAnchored">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="IDXGIAdapter1::GetDesc1 (PCI Device ID)" Url="https://learn.microsoft.com/en-us/windows/win32/api/dxgi/nf-dxgi-idxgiadapter1-getdesc1" />
                                <fhInfoPopup:SourceLink Label="Win32_VideoController (PnP Device ID)" Url="https://learn.microsoft.com/en-us/windows/win32/cimwin32prov/win32-videocontroller" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Gpu_PCIDeviceID')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Gpu.GpuDeviceIdText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:AppTerms.Get('Gpu_PnPDeviceID')}" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Gpu.GpuPnpDeviceIdText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  info panel splitter  -->
        <!--  (a 9px band centered on the divider line; it resizes the content column before it)  -->
        <fhControls:ClampedGridSplitter
            x:Uid="Gpu_ResizeHardwareInfoSplitter"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="9"
            Margin="-4,0,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            IsTabStop="False"
            IsThumbVisible="False"
            ManipulationCompleted="InfoPanelSplitter_ManipulationCompleted"
            ResizeBehavior="PreviousAndCurrent"
            ResizeDirection="Columns"
            Visibility="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelVisibility, Mode=OneWay}" />

    </Grid>
</UserControl>
