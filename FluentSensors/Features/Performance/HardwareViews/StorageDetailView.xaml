<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.StorageDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="ContentScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        SizeChanged="ContentScrollViewer_SizeChanged"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel
            x:Name="ContentStackPanel"
            Padding="16,8,16,16"
            Spacing="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="OverviewBlockGrid"
                    Grid.Row="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  total activity + read/write rate  -->
                    <Grid
                        x:Name="GraphsAreaGrid"
                        Grid.Row="0"
                        SizeChanged="GraphsAreaGrid_SizeChanged">

                        <Grid
                            x:Name="WideGraphsGrid"
                            MinHeight="200"
                            ColumnSpacing="8"
                            RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="100"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Storage.TotalActivity, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                Grid.Column="1"
                                GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Storage.ReadRate, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="1"
                                Grid.Column="1"
                                GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Storage.WriteRate, Mode=OneWay}" />
                        </Grid>

                        <Grid
                            x:Name="NarrowGraphsPanel"
                            MinHeight="240"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="100"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Storage.TotalActivity, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="1"
                                GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Storage.ReadRate, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="2"
                                GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                GraphDataPointsOverride="180"
                                IsAutoScaledOverride="True"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Storage.WriteRate, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                    <!--  current value tiles  -->
                    <Grid x:Name="TilesGrid" Grid.Row="1">
                        <controls:WrapPanel
                            Margin="0,0,0,16"
                            HorizontalSpacing="8"
                            VerticalSpacing="8">
                            <fhTile:SensorTileControl
                                Title="Total Activity"
                                Width="90"
                                ViewModel="{x:Bind Storage.TotalActivity, Mode=OneWay}" />
                            <fhTile:SensorTileControl
                                Title="Read Rate"
                                Width="110"
                                ViewModel="{x:Bind Storage.ReadRate, Mode=OneWay}" />
                            <fhTile:SensorTileControl
                                Title="Write Rate"
                                Width="110"
                                ViewModel="{x:Bind Storage.WriteRate, Mode=OneWay}" />
                        </controls:WrapPanel>
                    </Grid>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>