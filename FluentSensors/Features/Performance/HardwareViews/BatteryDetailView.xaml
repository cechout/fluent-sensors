<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.BatteryDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhCommon="using:FluentSensors.Common.Sensors"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhFacts="using:FluentSensors.Controls.FactList"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:fhPerf="using:FluentSensors.Features.Performance"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:fhTimeRange="using:FluentSensors.Controls.TimeRange"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:loc="using:FluentSensors.Common.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="4*" />
            <ColumnDefinition
                x:Name="InfoPanelColumn"
                Width="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnWidth, Mode=OneWay}"
                MinWidth="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnMinWidth, Mode=OneWay}"
                MaxWidth="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnMaxWidth, Mode=OneWay}" />
        </Grid.ColumnDefinitions>


        <!--  view content with header, graphs and tiles  -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Column="0"
            fhUi:FocusSkip.IsEnabled="True"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="ContentScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentStackPanel"
                Padding="16,16,16,16"
                Spacing="14">


                <!--  header  -->
                <Grid
                    x:Name="HeaderGrid"
                    Background="Transparent"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <FontIcon
                            Margin="0,0,0,-2"
                            FontSize="20"
                            Foreground="{x:Bind GroupIconBrush, Mode=OneWay}"
                            Glyph="{x:Bind GroupIconGlyph, Mode=OneTime}" />
                        <TextBlock
                            Margin="0,0,0,0"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind GroupLabel, Mode=OneTime}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,4,2"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Battery.HardwareName, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>


                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="OverviewBlockGrid"
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  charge level (big) beside the rate and a switchable detail; narrow: all three stacked  -->
                        <Grid
                            x:Name="GraphsAreaGrid"
                            Grid.Row="0"
                            SizeChanged="GraphsAreaGrid_SizeChanged">

                            <Grid
                                x:Name="WideGraphsGrid"
                                MinHeight="190"
                                ColumnSpacing="8"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    GraphHardwareKind="Battery"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="Charge Level"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Battery.ChargeLevel, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    GraphHardwareKind="Battery"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Charge/Discharge Rate"
                                    PlaceholderUnit="W"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Battery.Rate, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    GraphHardwareKind="Battery"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Voltage"
                                    PlaceholderUnit="V"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Battery.DetailOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Battery.Detail, Mode=TwoWay}" />
                            </Grid>

                            <Grid
                                x:Name="NarrowGraphsPanel"
                                MinHeight="360"
                                IsHitTestVisible="False"
                                Opacity="0"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5*" />
                                    <RowDefinition Height="3*" />
                                    <RowDefinition Height="3*" />
                                </Grid.RowDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    GraphHardwareKind="Battery"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    PlaceholderSensorName="Charge Level"
                                    PlaceholderUnit="%"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Battery.ChargeLevel, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    GraphHardwareKind="Battery"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Charge/Discharge Rate"
                                    PlaceholderUnit="W"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Battery.Rate, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="2"
                                    GraphHardwareKind="Battery"
                                    IsAutoScaledOverride="True"
                                    PlaceholderSensorName="Voltage"
                                    PlaceholderUnit="V"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Battery.DetailOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Battery.Detail, Mode=TwoWay}" />
                            </Grid>
                        </Grid>

                        <!--  current value tiles  -->
                        <Grid
                            x:Name="TilesGrid"
                            Grid.Row="1"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  graph time range  -->
                            <!--  (inside this grid so RecalculateOverviewHeight measures it together with the tiles)  -->
                            <fhTimeRange:TimeRangePickerControl
                                Grid.Row="0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.Performance}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.StandardGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <controls:WrapPanel
                                Grid.Row="1"
                                Margin="4,0,4,0"
                                HorizontalSpacing="16"
                                VerticalSpacing="0">
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Battery.ChargeLevel.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="000,0 %"
                                    ViewModel="{x:Bind Battery.ChargeLevel, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Battery.Rate.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="000,0 W"
                                    ViewModel="{x:Bind Battery.Rate, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Battery.Detail.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="000,0 min"
                                    ViewModel="{x:Bind Battery.Detail, Mode=OneWay}" />
                            </controls:WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>


        <!--  info panel: what the firmware says about the pack and the readings that only move with its age  -->
        <Border
            Grid.Column="1"
            VerticalAlignment="Stretch"
            fhUi:FocusSkip.IsEnabled="True"
            Background="Transparent"
            BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelVisibility, Mode=OneWay}">

            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Margin="16" Spacing="24">
                    <TextBlock
                        Margin="0,0,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind loc:AppTerms.Get('Battery_BatteryInfo')}" />

                    <!--  the pack as its firmware describes it, then the lhm readings labelled with their sensor name  -->
                    <StackPanel Spacing="12">
                        <fhInfoPopup:InfoPopupControl
                            x:Uid="Battery_GeneralPopup"
                            Margin="0,0,0,-4"
                            PlacementMode="TitleAnchored">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="IOCTL_BATTERY_QUERY_INFORMATION" Url="https://learn.microsoft.com/en-us/windows/win32/power/ioctl-battery-query-information" />
                                <fhInfoPopup:SourceLink Label="LibreHardwareMonitor" Url="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>

                        <fhFacts:FactListControl Facts="{x:Bind Battery.StaticFacts, Mode=OneWay}" />

                        <fhFacts:FactListControl Facts="{x:Bind Battery.Facts, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  info panel splitter  -->
        <!--  (a 9px band centered on the divider line; it resizes the content column before it)  -->
        <fhControls:ClampedGridSplitter
            x:Uid="Battery_ResizeHardwareInfoSplitter"
            Grid.Column="1"
            Width="9"
            Margin="-4,0,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            IsTabStop="False"
            IsThumbVisible="False"
            ManipulationCompleted="InfoPanelSplitter_ManipulationCompleted"
            ResizeBehavior="PreviousAndCurrent"
            ResizeDirection="Columns"
            Visibility="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelVisibility, Mode=OneWay}" />

    </Grid>
</UserControl>
