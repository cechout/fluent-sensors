<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.CpuDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhLhm="using:FluentSensors.Features.Performance.Lhm"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  CPU detail content  -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="0"
            Background="Transparent"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="ContentScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentStackPanel"
                Padding="16,8,16,16"
                Spacing="12">
                <Grid x:Name="PageContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <!--  1 border for 1 physical core  -->
                        <!--  it stack whicever threads, temperatur, clocks it actually has  -->
                        <DataTemplate x:Key="CpuCoreCellTemplate" x:DataType="fhLhm:LhmCpuCoreViewModel">
                            <Border
                                Padding="0"
                                Background="Transparent"
                                CornerRadius="4">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <!--  core title, from the Temperature sensor's raw name (e.g. "P-Core #3")  -->
                                        <RowDefinition Height="Auto" />
                                        <!--  threads  -->
                                        <RowDefinition Height="2*" />
                                        <!--  temperature  -->
                                        <RowDefinition Height="*" />
                                        <!--  clock  -->
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!--  core title  -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="4,0,0,0"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Temperature.SensorName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  threads graphs  -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Threads, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <fhControls:VerticalStretchPanel Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="fhGraph:SensorGraphViewModel">
                                                <fhGraph:SensorPanelControl
                                                    GraphColorOverride="#FF00B7C3"
                                                    GraphDataPointsOverride="70"
                                                    GraphTapAction="ShowFlyout"
                                                    IsAutoScaledOverride="False"
                                                    ManualYMaxOverride="100"
                                                    ShowGraphLabel="True"
                                                    ShowThresholdFlyoutIndicator="False"
                                                    ShowTitleRow="False"
                                                    ThresholdLabelAlwaysVisible="False"
                                                    ViewModel="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  temperature graph  -->
                                    <fhGraph:SensorPanelControl
                                        Grid.Row="2"
                                        GraphColorOverride="#FFFFB900"
                                        GraphDataPointsOverride="70"
                                        GraphTapAction="ShowFlyout"
                                        IsAutoScaledOverride="False"
                                        ManualYMaxOverride="100"
                                        ShowGraphLabel="True"
                                        ShowThresholdFlyoutIndicator="False"
                                        ShowTitleRow="False"
                                        ThresholdLabelAlwaysVisible="False"
                                        ViewModel="{x:Bind Temperature, Mode=OneWay}" />

                                    <!--  clock graph  -->
                                    <fhGraph:SensorPanelControl
                                        Grid.Row="3"
                                        GraphColorOverride="#FF00CC6A"
                                        GraphDataPointsOverride="70"
                                        GraphTapAction="ShowFlyout"
                                        IsAutoScaledOverride="True"
                                        ShowGraphLabel="True"
                                        ShowThresholdFlyoutIndicator="False"
                                        ShowTitleRow="False"
                                        ThresholdLabelAlwaysVisible="False"
                                        ViewModel="{x:Bind Clock, Mode=OneWay}" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </Grid.Resources>


                    <!--  cpu view 1: overview  -->
                    <Grid
                        x:Name="OverviewBlockGrid"
                        Grid.Row="0"
                        Background="Transparent"
                        IsHitTestVisible="{x:Bind Cpu.OverallIsHitTestVisible, Mode=OneWay}"
                        Opacity="{x:Bind Cpu.OverallOpacity, Mode=OneWay}"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  total load + max temperature and power  -->
                        <!--  wide: big Load graph + 2 stacked  -->
                        <Grid
                            x:Name="GraphsAreaGrid"
                            Grid.Row="0"
                            Background="Transparent"
                            SizeChanged="GraphsAreaGrid_SizeChanged">

                            <Grid
                                x:Name="WideGraphsGrid"
                                MinHeight="200"
                                ColumnSpacing="8"
                                RowSpacing="8">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    GraphColorOverride="#FF00B7C3"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.TotalLoad, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    GraphColorOverride="#FF00B7C3"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.MaxTemperature, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    GraphColorOverride="#FF00B7C3"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="True"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.PackagePower, Mode=OneWay}" />
                            </Grid>

                            <!--  narrow: all 3 stacked, first weighted bigger, switched via SizeChanged  -->
                            <Grid
                                x:Name="NarrowGraphsPanel"
                                MinHeight="240"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                Opacity="0"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    GraphColorOverride="#FF00B7C3"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.TotalLoad, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    GraphColorOverride="#FF00B7C3"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.MaxTemperature, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="2"
                                    GraphColorOverride="#FF00B7C3"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="True"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.PackagePower, Mode=OneWay}" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="TilesAndStaticInfoGrid" Grid.Row="1">

                            <controls:WrapPanel
                                Margin="0,0,0,16"
                                HorizontalSpacing="8"
                                VerticalSpacing="8">
                                <fhTile:SensorTileControl
                                    Title="CPU Total Load"
                                    Width="100"
                                    ViewModel="{x:Bind Cpu.TotalLoad, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="Max Temperature"
                                    Width="110"
                                    ViewModel="{x:Bind Cpu.MaxTemperature, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="Package Power"
                                    Width="100"
                                    ViewModel="{x:Bind Cpu.PackagePower, Mode=OneWay}" />
                            </controls:WrapPanel>
                        </Grid>
                    </Grid>


                    <!--  cpu view 2: all cpu cores  -->
                    <!--  (cores with threads on top and cores withput threads below)  -->
                    <Grid
                        x:Name="AllThreadsGrid"
                        Grid.Row="0"
                        IsHitTestVisible="{x:Bind Cpu.AllThreadsIsHitTestVisible, Mode=OneWay}"
                        Opacity="{x:Bind Cpu.AllThreadsOpacity, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ItemsControl
                            Grid.Row="0"
                            ItemTemplate="{StaticResource CpuCoreCellTemplate}"
                            ItemsSource="{x:Bind Cpu.CoresWithThreads, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <fhControls:SquareGridPanel MinCellHeight="200" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border
                            Grid.Row="1"
                            Height="0"
                            Margin="0,24,0,0"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <ItemsControl
                            Grid.Row="2"
                            ItemTemplate="{StaticResource CpuCoreCellTemplate}"
                            ItemsSource="{x:Bind Cpu.CoresWithoutThreads, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <fhControls:SquareGridPanel MinCellHeight="200" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                </Grid>
            </StackPanel>
        </ScrollViewer>


        <!--  cpu bottom bar  -->
        <Border
            Grid.Row="1"
            Padding="16,0,10,1"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CommandBar
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="False"
                    IsOpen="False">

                    <CommandBar.Resources>
                        <SolidColorBrush x:Key="CommandBarBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                        <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />

                        <Thickness x:Key="AppBarButtonPadding">0,0,0,0</Thickness>
                    </CommandBar.Resources>

                    <AppBarButton
                        x:Name="ShowOverallButton"
                        Click="ShowOverall_Click"
                        Label="Overall">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="ShowAllThreadsButton"
                        Click="ShowAllThreads_Click"
                        Label="All Threads">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE80A;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </Border>

    </Grid>
</UserControl>