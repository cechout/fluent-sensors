<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.CpuDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhLhm="using:FluentSensors.Features.Performance.Lhm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  CPU detail content  -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="ContentScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentStackPanel"
                Padding="16,8,16,16"
                Spacing="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <Grid.Resources>
                        <!--  1 tile for 1 sensor: sensor name + current value, no graph  -->
                        <DataTemplate x:Key="SensorValueTileTemplate" x:DataType="fhGraph:SensorGraphViewModel">
                            <Border
                                Padding="2"
                                Background="Transparent"
                                CornerRadius="4">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SensorName, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{x:Bind CurrentValueColor, Mode=OneWay}"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind CurrentValueText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <!--  1 border for 1 physical core  -->
                        <!--  it stack whicever threads, temperatur, clocks it actually has  -->
                        <DataTemplate x:Key="CpuCoreCellTemplate" x:DataType="fhLhm:LhmCpuCoreViewModel">
                            <Border
                                Padding="4"
                                Background="Transparent"
                                CornerRadius="4">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <!--  core title, from the Temperature sensor's raw name (e.g. "P-Core #3")  -->
                                        <RowDefinition Height="Auto" />
                                        <!--  threads  -->
                                        <RowDefinition Height="2*" />
                                        <!--  temperature  -->
                                        <RowDefinition Height="*" />
                                        <!--  clock  -->
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!--  core title  -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="4,0,0,2"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Temperature.SensorName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  threads graphs  -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Threads, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <fhControls:VerticalStretchPanel Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="fhGraph:SensorGraphViewModel">
                                                <fhGraph:SensorPanelControl
                                                    GraphColorOverride="#FF00B7C3"
                                                    GraphDataPointsOverride="70"
                                                    GraphTapAction="ShowFlyout"
                                                    IsAutoScaledOverride="False"
                                                    ManualYMaxOverride="100"
                                                    ShowGraphLabel="True"
                                                    ShowThresholdFlyoutIndicator="False"
                                                    ShowTitleRow="False"
                                                    ThresholdLabelAlwaysVisible="False"
                                                    ViewModel="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  temperature graph  -->
                                    <fhGraph:SensorPanelControl
                                        Grid.Row="2"
                                        GraphColorOverride="#FFFFB900"
                                        GraphDataPointsOverride="70"
                                        GraphTapAction="ShowFlyout"
                                        IsAutoScaledOverride="False"
                                        ManualYMaxOverride="100"
                                        ShowGraphLabel="True"
                                        ShowThresholdFlyoutIndicator="False"
                                        ShowTitleRow="False"
                                        ThresholdLabelAlwaysVisible="False"
                                        ViewModel="{x:Bind Temperature, Mode=OneWay}" />

                                    <!--  clock graph  -->
                                    <fhGraph:SensorPanelControl
                                        Grid.Row="3"
                                        GraphColorOverride="#FF00CC6A"
                                        GraphDataPointsOverride="70"
                                        GraphTapAction="ShowFlyout"
                                        IsAutoScaledOverride="False"
                                        ManualYMaxOverride="5000"
                                        ShowGraphLabel="True"
                                        ShowThresholdFlyoutIndicator="False"
                                        ShowTitleRow="False"
                                        ThresholdLabelAlwaysVisible="False"
                                        ViewModel="{x:Bind Clock, Mode=OneWay}" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </Grid.Resources>


                    <!--  cpu view 1: overview  -->
                    <Grid
                        x:Name="OverviewBlockGrid"
                        Grid.Row="0"
                        RowSpacing="12"
                        Visibility="{x:Bind Cpu.OverallVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  total load + max temperature and power  -->
                        <!--  wide: big Load graph + 2 stacked  -->
                        <Grid
                            x:Name="GraphsAreaGrid"
                            Grid.Row="0"
                            Background="Transparent"
                            SizeChanged="GraphsAreaGrid_SizeChanged">

                            <Grid
                                x:Name="WideGraphsGrid"
                                MinHeight="200"
                                ColumnSpacing="8"
                                RowSpacing="8">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    GraphColorOverride="#FF00B7C3"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.TotalLoad, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    GraphColorOverride="#FFFFB900"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.MaxTemperature, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    GraphColorOverride="#FFFFB900"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="150"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.PackagePower, Mode=OneWay}" />
                            </Grid>

                            <!--  narrow: all 3 stacked equally, switched via SizeChanged  -->
                            <fhControls:VerticalStretchPanel
                                x:Name="NarrowGraphsPanel"
                                MinHeight="240"
                                Spacing="8"
                                Visibility="Collapsed">

                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="#FF00B7C3"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.TotalLoad, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="#FFFFB900"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.MaxTemperature, Mode=OneWay}" />

                                <fhGraph:SensorPanelControl
                                    GraphColorOverride="#FFFFB900"
                                    GraphDataPointsOverride="180"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="150"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.PackagePower, Mode=OneWay}" />
                            </fhControls:VerticalStretchPanel>
                        </Grid>

                        <!--  current value tiles + static hardware info  -->
                        <Grid
                            x:Name="TilesAndStaticInfoGrid"
                            Grid.Row="1"
                            ColumnSpacing="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  left: 3 stacked value tiles  -->
                            <!--<StackPanel Grid.Column="0" Spacing="8">
                                <ContentControl
                                    HorizontalContentAlignment="Stretch"
                                    Content="{x:Bind Cpu.TotalLoad, Mode=OneWay}"
                                    ContentTemplate="{StaticResource SensorValueTileTemplate}" />
                                <ContentControl
                                    HorizontalContentAlignment="Stretch"
                                    Content="{x:Bind Cpu.MaxTemperature, Mode=OneWay}"
                                    ContentTemplate="{StaticResource SensorValueTileTemplate}" />
                                <ContentControl
                                    HorizontalContentAlignment="Stretch"
                                    Content="{x:Bind Cpu.PackagePower, Mode=OneWay}"
                                    ContentTemplate="{StaticResource SensorValueTileTemplate}" />
                            </StackPanel>-->

                            <!--  top: value tiles  -->
                            <StackPanel
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,16"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ContentControl
                                    Width="100"
                                    Content="{x:Bind Cpu.TotalLoad, Mode=OneWay}"
                                    ContentTemplate="{StaticResource SensorValueTileTemplate}" />
                                <ContentControl
                                    Width="100"
                                    Content="{x:Bind Cpu.MaxTemperature, Mode=OneWay}"
                                    ContentTemplate="{StaticResource SensorValueTileTemplate}" />
                                <ContentControl
                                    Width="100"
                                    Content="{x:Bind Cpu.PackagePower, Mode=OneWay}"
                                    ContentTemplate="{StaticResource SensorValueTileTemplate}" />
                            </StackPanel>

                            <!--  right: static CPU hardware info (raw draft, no final styling yet)  -->
                            <!--<Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Padding="0"
                                Background="Transparent"
                                CornerRadius="4">
                                <StackPanel Spacing="4">
                            -->
                            <!--<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="CPU Static Info" />-->
                            <!--

                                    <Grid ColumnSpacing="8" RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Physical Cores" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{x:Bind Cpu.CpuPhysicalCoresText}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Logical Processors" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{x:Bind Cpu.CpuLogicalProcessorsText}" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="L2 Cache" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="{x:Bind Cpu.CpuL2CacheText}" />

                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="L3 Cache" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Text="{x:Bind Cpu.CpuL3CacheText}" />

                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Max Clock Speed" />
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Text="{x:Bind Cpu.CpuMaxClockText}" />

                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Socket" />
