                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Text="{x:Bind Cpu.CpuSocketText}" />

                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Virtualization (Firmware)" />
                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Text="{x:Bind Cpu.CpuVirtualizationFirmwareText}"
                                            ToolTipService.ToolTip="Known unreliable on some systems" />

                                        <TextBlock
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Virtualization Extensions" />
                                        <TextBlock
                                            Grid.Row="7"
                                            Grid.Column="1"
                                            Text="{x:Bind Cpu.CpuVirtualizationExtensionsText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>-->
                        </Grid>
                    </Grid>


                    <!--  cpu view 2: all cpu cores  -->
                    <!--  (cores with threads on top and cores withput threads below)  -->
                    <Grid Grid.Row="0" Visibility="{x:Bind Cpu.AllThreadsVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ItemsControl
                            Grid.Row="0"
                            ItemTemplate="{StaticResource CpuCoreCellTemplate}"
                            ItemsSource="{x:Bind Cpu.CoresWithThreads, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <fhControls:SquareGridPanel MinCellHeight="200" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border
                            Grid.Row="1"
                            Height="1"
                            Margin="0,8"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <ItemsControl
                            Grid.Row="2"
                            ItemTemplate="{StaticResource CpuCoreCellTemplate}"
                            ItemsSource="{x:Bind Cpu.CoresWithoutThreads, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <fhControls:SquareGridPanel MinCellHeight="200" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                </Grid>
            </StackPanel>
        </ScrollViewer>


        <!--  cpu bottom bar  -->
        <Border
            Grid.Row="1"
            Padding="16,0,10,1"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CommandBar
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="False"
                    IsOpen="False">

                    <CommandBar.Resources>
                        <SolidColorBrush x:Key="CommandBarBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                        <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />

                        <Thickness x:Key="AppBarButtonPadding">0,0,0,0</Thickness>
                    </CommandBar.Resources>

                    <AppBarButton
                        x:Name="ShowOverallButton"
                        Click="ShowOverall_Click"
                        Label="Overall">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="ShowAllThreadsButton"
                        Click="ShowAllThreads_Click"
                        Label="All Threads">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE80A;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </Border>

    </Grid>
</UserControl>