<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.CpuDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:fhLhm="using:FluentSensors.Features.Performance.Lhm"
    xmlns:fhPerf="using:FluentSensors.Features.Performance"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition
                x:Name="InfoPanelColumn"
                Width="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnWidth, Mode=OneWay}"
                MinWidth="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnMinWidth, Mode=OneWay}"
                MaxWidth="300" />
        </Grid.ColumnDefinitions>


        <!--  view-content with header, graphs and tiles  -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="0"
            Grid.Column="0"
            Background="Transparent"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="ContentScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentStackPanel"
                Padding="16,16,16,16"
                Spacing="14">


                <!--  header  -->
                <Grid
                    x:Name="HeaderGrid"
                    Background="Transparent"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <FontIcon
                            Margin="0,0,0,-2"
                            FontSize="20"
                            Glyph="{x:Bind GroupIconGlyph, Mode=OneTime}" />
                        <TextBlock
                            Margin="0,0,0,0"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind GroupLabel, Mode=OneTime}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,4,2"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Cpu.HardwareName, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>


                <Grid x:Name="PageContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <!--  fixed height for every individual sensor graph inside a core cell  -->
                        <x:Double x:Key="CpuCoreGraphHeight">45</x:Double>

                        <!--  1 border for 1 physical core  -->
                        <!--  it stack whichever threads, temperature, clocks it actually has  -->
                        <DataTemplate x:Key="CpuCoreCellTemplate" x:DataType="fhLhm:LhmCpuCoreViewModel">
                            <Border
                                Padding="0"
                                Background="Transparent"
                                CornerRadius="4">

                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <!--  core title, from the Temperature sensors raw name (e.g. "P-Core #3")  -->
                                        <RowDefinition Height="Auto" />
                                        <!--  threads: one row per thread, each the same fixed height as Temperature/Clock below  -->
                                        <RowDefinition Height="Auto" />
                                        <!--  temperature  -->
                                        <RowDefinition Height="Auto" />
                                        <!--  clock  -->
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  core title  -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="4,0,0,0"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Temperature.SensorName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  threads graphs  -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Threads, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="fhGraph:SensorGraphViewModel">
                                                <fhGraph:SensorPanelControl
                                                    Height="{StaticResource CpuCoreGraphHeight}"
                                                    GraphColorOverride="{Binding HardwareColor, ElementName=Root}"
                                                    GraphTapAction="ShowFlyout"
                                                    IsAutoScaledOverride="False"
                                                    ManualYMaxOverride="100"
                                                    ShowGraphLabel="True"
                                                    ShowThresholdFlyoutIndicator="False"
                                                    ShowTitleRow="False"
                                                    ThresholdLabelAlwaysVisible="False"
                                                    ViewModel="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  temperature graph  -->
                                    <fhGraph:SensorPanelControl
                                        Grid.Row="2"
                                        Height="{StaticResource CpuCoreGraphHeight}"
                                        GraphColorOverride="#FFFFB900"
                                        GraphTapAction="ShowFlyout"
                                        IsAutoScaledOverride="False"
                                        ManualYMaxOverride="100"
                                        ShowGraphLabel="True"
                                        ShowThresholdFlyoutIndicator="False"
                                        ShowTitleRow="False"
                                        ThresholdLabelAlwaysVisible="False"
                                        ViewModel="{x:Bind Temperature, Mode=OneWay}" />

                                    <!--  clock graph  -->
                                    <fhGraph:SensorPanelControl
                                        Grid.Row="3"
                                        Height="{StaticResource CpuCoreGraphHeight}"
                                        GraphColorOverride="#FF00CC6A"
                                        GraphTapAction="ShowFlyout"
                                        IsAutoScaledOverride="True"
                                        ShowGraphLabel="True"
                                        ShowThresholdFlyoutIndicator="False"
                                        ShowTitleRow="False"
                                        ThresholdLabelAlwaysVisible="False"
                                        ViewModel="{x:Bind Clock, Mode=OneWay}" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </Grid.Resources>


                    <!--  cpu view 1: overview  -->
                    <Grid
                        x:Name="OverviewBlockGrid"
                        Grid.Row="0"
                        Background="Transparent"
                        IsHitTestVisible="{x:Bind Cpu.OverallIsHitTestVisible, Mode=OneWay}"
                        Opacity="{x:Bind Cpu.OverallOpacity, Mode=OneWay}"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  total load + max temperature and power  -->
                        <!--  (wide: big Load graph + 2 stacked)  -->
                        <Grid
                            x:Name="GraphsAreaGrid"
                            Grid.Row="0"
                            Background="Transparent"
                            SizeChanged="GraphsAreaGrid_SizeChanged">

                            <Grid
                                x:Name="WideGraphsGrid"
                                MinHeight="190"
                                ColumnSpacing="8"
                                RowSpacing="8">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Cpu.TotalLoadOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.TotalLoad, Mode=TwoWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Cpu.MaxTemperatureOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.MaxTemperature, Mode=TwoWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Cpu.PackagePowerOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.PackagePower, Mode=TwoWay}" />
                            </Grid>

                            <!--  (narrow: all 3 stacked, first weighted bigger)  -->
                            <Grid
                                x:Name="NarrowGraphsPanel"
                                MinHeight="360"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                Opacity="0"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5*" />
                                    <RowDefinition Height="3*" />
                                    <RowDefinition Height="3*" />
                                </Grid.RowDefinitions>

                                <fhGraph:SensorPanelControl
                                    Grid.Row="0"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Cpu.TotalLoadOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.TotalLoad, Mode=TwoWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="1"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="False"
                                    ManualYMaxOverride="100"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Cpu.MaxTemperatureOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.MaxTemperature, Mode=TwoWay}" />

                                <fhGraph:SensorPanelControl
                                    Grid.Row="2"
                                    GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                    IsAutoScaledOverride="True"
                                    ShowStatusRow="True"
                                    ShowThresholdControls="True"
                                    ShowYAxisControls="True"
                                    SwitchCandidates="{x:Bind Cpu.PackagePowerOptions, Mode=OneWay}"
                                    ThresholdLabelAlwaysVisible="False"
                                    ViewModel="{x:Bind Cpu.PackagePower, Mode=TwoWay}" />
                            </Grid>
                        </Grid>

                        <!--  current graph value tiles  -->
                        <Grid x:Name="TilesAndStaticInfoGrid" Grid.Row="1">

                            <controls:WrapPanel
                                Margin="4,0,4,12"
                                HorizontalSpacing="16"
                                VerticalSpacing="8">
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Cpu.TotalLoad.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="00,0 %"
                                    ViewModel="{x:Bind Cpu.TotalLoad, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Cpu.MaxTemperature.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="00,0 °C"
                                    ViewModel="{x:Bind Cpu.MaxTemperature, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="{x:Bind Cpu.PackagePower.SensorName, Mode=OneWay}"
                                    Width="Auto"
                                    MaxValueText="00,0 W"
                                    ViewModel="{x:Bind Cpu.PackagePower, Mode=OneWay}" />
                            </controls:WrapPanel>
                        </Grid>
                    </Grid>


                    <!--  cpu view 2: all cpu cores  -->
                    <!--  (cores with threads on top and cores without threads below, each followed by its own group averages)  -->
                    <!--
                        workaround: RowSpacing still applied to a Collapsed row
                        problem: Grid.RowSpacing (like StackPanel.Spacing) keeps reserving its gap even when the sibling
                        row is Collapsed;
                        Confirmed platform bug: https://github.com/microsoft/microsoft-ui-xaml/issues/916
                        fix: no RowSpacing on this Grid at all, the gap between the two groups instead lives on the second
                        StackPanels own Margin, which (unlike RowSpacing) correctly collapses away together with the panel
                    -->
                    <Grid
                        x:Name="AllThreadsGrid"
                        Grid.Row="0"
                        x:Load="False"
                        IsHitTestVisible="{x:Bind Cpu.AllThreadsIsHitTestVisible, Mode=OneWay}"
                        Opacity="{x:Bind Cpu.AllThreadsOpacity, Mode=OneWay}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  cores with threads  -->
                        <!--  (the whole group collapses if this CPU never populates it)  -->
                        <StackPanel
                            Grid.Row="0"
                            Spacing="8"
                            Visibility="{x:Bind BoolToVisibility(Cpu.HasCoresWithThreads), Mode=OneWay}">
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Cores With Threads"
                                Visibility="{x:Bind BoolToVisibility(Cpu.ShowCoreGroupTitles), Mode=OneWay}" />

                            <ItemsControl
                                ItemTemplate="{StaticResource CpuCoreCellTemplate}"
                                ItemsSource="{x:Bind Cpu.CoresWithThreads, Mode=OneWay}"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <fhControls:SquareGridPanel MinCellHeight="100" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!--  sensor tiles: averages across all cores with threads  -->
                            <controls:WrapPanel
                                Margin="4,0,4,0"
                                HorizontalSpacing="8"
                                VerticalSpacing="8">
                                <fhTile:SensorTileControl
                                    Title="Average Load"
                                    Width="90"
                                    ViewModel="{x:Bind Cpu.AvgLoadWithThreads, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="Average Temperature"
                                    Width="130"
                                    ViewModel="{x:Bind Cpu.AvgTemperatureWithThreads, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="Average Clock"
                                    Width="130"
                                    ViewModel="{x:Bind Cpu.AvgClockWithThreads, Mode=OneWay}" />
                            </controls:WrapPanel>
                        </StackPanel>

                        <!--  cores without threads  -->
                        <!--  (the whole group collapses if this CPU never populates it)  -->
                        <!--  (Margin top is the gap to the group above, 0 when that group is not shown)  -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="{x:Bind GroupSpacingMargin(Cpu.ShowCoreGroupTitles), Mode=OneWay}"
                            Spacing="8"
                            Visibility="{x:Bind BoolToVisibility(Cpu.HasCoresWithoutThreads), Mode=OneWay}">
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Cores Without Threads"
                                Visibility="{x:Bind BoolToVisibility(Cpu.ShowCoreGroupTitles), Mode=OneWay}" />

                            <ItemsControl
                                ItemTemplate="{StaticResource CpuCoreCellTemplate}"
                                ItemsSource="{x:Bind Cpu.CoresWithoutThreads, Mode=OneWay}"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <fhControls:SquareGridPanel MinCellHeight="100" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!--  sensor tiles: averages across all cores without threads  -->
                            <controls:WrapPanel
                                Margin="4,0,4,0"
                                HorizontalSpacing="16"
                                VerticalSpacing="8">
                                <fhTile:SensorTileControl
                                    Title="Average Load"
                                    Width="Auto"
                                    MaxValueText="00,0 %"
                                    ViewModel="{x:Bind Cpu.AvgLoadWithoutThreads, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="Average Temperature"
                                    Width="Auto"
                                    MaxValueText="00,0 °C"
                                    ViewModel="{x:Bind Cpu.AvgTemperatureWithoutThreads, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    Title="Average Clock"
                                    Width="Auto"
                                    MaxValueText="000,0 MHz"
                                    ViewModel="{x:Bind Cpu.AvgClockWithoutThreads, Mode=OneWay}" />
                            </controls:WrapPanel>
                        </StackPanel>

                    </Grid>

                </Grid>
            </StackPanel>
        </ScrollViewer>


        <!--  info panel: static hardware facts for the selected CPU  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelVisibility, Mode=OneWay}">

            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Margin="16" Spacing="24">
                    <TextBlock
                        Margin="0,0,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="CPU Info" />

                    <StackPanel Spacing="12">

                        <!--  general  -->
                        <fhInfoPopup:InfoPopupControl
                            Title="General"
                            Margin="0,0,0,-4"
                            Description="Physical Cores - actual processing units on chip&#10;Logical Processors - total execution threads (SMT/Hyper-Threading doubles per core)&#10;Core Topology - Performance vs Efficient core split on hybrid CPUs"
                            PlacementMode="TitleAnchored"
                            Source="Windows Management Instrumentation (WMI) + Windows CPU topology API for the Performance/Efficient breakdown" />

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Physical Cores"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Cpu.CpuPhysicalCoresText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Logical Processors"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Cpu.CpuLogicalProcessorsText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Core Topology" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Cpu.CpuCoreTopologyText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Socket"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Cpu.CpuSocketText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Max Clock Speed"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Cpu.CpuMaxClockText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>
                    </StackPanel>

                    <!--  cache  -->
                    <StackPanel Spacing="12">
                        <fhInfoPopup:InfoPopupControl
                            Title="Cache"
                            Margin="0,0,0,-4"
                            Description="Cache - small, fast on-die memory holding recently used data&#10;L1 - smallest, fastest, per core; sum of separate instruction + data caches&#10;L2 - larger, slower, per core; unified&#10;L3 - largest, shared across all cores; unified"
                            PlacementMode="TitleAnchored"
                            Source="Windows Management Instrumentation (WMI)" />

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="L1 Cache"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Cpu.CpuL1CacheText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="L2 Cache"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Cpu.CpuL2CacheText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="L3 Cache"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Cpu.CpuL3CacheText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>
                    </StackPanel>

                    <!--  virtualization  -->
                    <StackPanel Spacing="12">
                        <fhInfoPopup:InfoPopupControl
                            Title="Virtualization"
                            Margin="0,0,0,-4"
                            Description="Extensions - CPU hardware support for running virtual machines (VT-x/AMD-V), used by Hyper-V, WSL2, and similar&#10;Firmware - currently enabled or not (unreliable)"
                            PlacementMode="TitleAnchored"
                            Source="Windows Management Instrumentation (WMI)" />

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Firmware"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Cpu.CpuVirtualizationFirmwareText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="Auto" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Extensions"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Cpu.CpuVirtualizationExtensionsText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>


        <!--  cpu bottom bar  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Padding="16,0,10,1"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CommandBar
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="False"
                    IsOpen="False">

                    <CommandBar.Resources>
                        <SolidColorBrush x:Key="CommandBarBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                        <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />

                        <Thickness x:Key="AppBarButtonPadding">0,0,0,0</Thickness>
                    </CommandBar.Resources>

                    <AppBarButton
                        x:Name="ShowOverallButton"
                        Click="ShowOverall_Click"
                        Label="Overall">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xF16B;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="ShowAllThreadsButton"
                        Click="ShowAllThreads_Click"
                        Label="Extended">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xF0E2;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </Border>

    </Grid>
</UserControl>