<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.MemoryDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhCommon="using:FluentSensors.Common.Sensors"
    xmlns:fhControls="using:FluentSensors.Controls"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:fhPerf="using:FluentSensors.Features.Performance"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:fhTimeRange="using:FluentSensors.Controls.TimeRange"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:loc="using:FluentSensors.Common.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:staticInfo="using:FluentSensors.Core.StaticInfo"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="4*" />
            <ColumnDefinition
                x:Name="InfoPanelColumn"
                Width="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnWidth, Mode=OneWay}"
                MinWidth="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnMinWidth, Mode=OneWay}"
                MaxWidth="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelColumnMaxWidth, Mode=OneWay}" />
        </Grid.ColumnDefinitions>


        <!--  view content with header, graph and tiles  -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Column="0"
            fhUi:FocusSkip.IsEnabled="True"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="ContentScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentStackPanel"
                Padding="16,16,16,16"
                Spacing="14">


                <!--  header  -->
                <Grid
                    x:Name="HeaderGrid"
                    Background="Transparent"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <FontIcon
                            Margin="0,0,0,-2"
                            FontSize="20"
                            Foreground="{x:Bind GroupIconBrush, Mode=OneWay}"
                            Glyph="{x:Bind GroupIconGlyph, Mode=OneTime}" />
                        <TextBlock
                            Margin="0,0,0,0"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind GroupLabel, Mode=OneTime}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,4,2"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Memory.PerformanceDisplayName, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>


                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="OverviewBlockGrid"
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  physical memory above virtual memory  -->
                        <Grid
                            x:Name="GraphsAreaGrid"
                            Grid.Row="0"
                            MinHeight="300"
                            RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <fhGraph:SensorPanelControl
                                Grid.Row="0"
                                GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="{x:Bind Memory.RoundedTotalMemory, Mode=OneWay}"
                                PlaceholderSensorName="Memory Used (Physical)"
                                PlaceholderUnit="GB"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Memory.Used, Mode=OneWay}" />

                            <fhGraph:SensorPanelControl
                                Grid.Row="1"
                                GraphColorOverride="{x:Bind HardwareColor, Mode=OneTime}"
                                IsAutoScaledOverride="False"
                                ManualYMaxOverride="{x:Bind Memory.VirtualMemoryTotal, Mode=OneWay}"
                                PlaceholderSensorName="Memory Used (Virtual)"
                                PlaceholderUnit="GB"
                                ShowStatusRow="True"
                                ShowThresholdControls="True"
                                ShowYAxisControls="True"
                                ThresholdLabelAlwaysVisible="False"
                                ViewModel="{x:Bind Memory.VirtualMemoryUsed, Mode=OneWay}" />
                        </Grid>

                        <!--  current value tiles  -->
                        <Grid
                            x:Name="TilesGrid"
                            Grid.Row="1"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  graph time range  -->
                            <!--  (inside this grid so RecalculateOverviewHeight measures it together with the tiles)  -->
                            <fhTimeRange:TimeRangePickerControl
                                Grid.Row="0"
                                Options="{x:Bind fhCommon:GraphTimeRanges.Performance}"
                                SelectedSeconds="{x:Bind fhPerf:PerformanceViewModel.Instance.StandardGraphTimeSpanSeconds, Mode=TwoWay}"
                                TextForeground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <controls:WrapPanel
                                Grid.Row="1"
                                Margin="4,0,4,0"
                                HorizontalSpacing="16"
                                VerticalSpacing="0">
                                <fhTile:SensorTileControl
                                    Title="{x:Bind loc:AppTerms.Get('Memory_MemoryUsedPhysical')}"
                                    Width="Auto"
                                    ViewModel="{x:Bind Memory.Used, Mode=OneWay}" />
                                <fhTile:SensorTileControl
                                    x:Uid="Memory_MemoryUsedVirtualTile"
                                    Title="{x:Bind loc:AppTerms.Get('Memory_MemoryUsedVirtual')}"
                                    Width="Auto"
                                    ShowInfoButton="True"
                                    ViewModel="{x:Bind Memory.VirtualMemoryUsed, Mode=OneWay}" />
                            </controls:WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>


        <!--  info panel: static hardware facts for the selected RAM  -->
        <Border
            Grid.Column="1"
            VerticalAlignment="Stretch"
            fhUi:FocusSkip.IsEnabled="True"
            Background="Transparent"
            BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelVisibility, Mode=OneWay}">

            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Margin="16" Spacing="24">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:AppTerms.Get('Memory_RAMInfo')}" />

                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind loc:AppTerms.Get('Memory_TotalSlots')}" />
                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind Memory.MemoryTotalSlotsText, Mode=OneWay}" />
                    </StackPanel>

                    <!--  one card per physical module  -->
                    <ItemsControl ItemsSource="{x:Bind Memory.MemoryModules, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="staticInfo:WinMemoryModuleInfo">
                                <StackPanel Margin="0,0,0,12" Spacing="12">
                                    <fhInfoPopup:InfoPopupControl
                                        x:Uid="Memory_RamInfoPopup"
                                        Title="{x:Bind DeviceLocator}"
                                        Margin="0,0,0,-4"
                                        PlacementMode="TitleAnchored"
                                        TitleTextTrimming="CharacterEllipsis">
                                        <fhInfoPopup:InfoPopupControl.SourceLinks>
                                            <fhInfoPopup:SourceLink Label="Win32_PhysicalMemory" Url="https://learn.microsoft.com/en-us/windows/win32/cimwin32prov/win32-physicalmemory" />
                                        </fhInfoPopup:InfoPopupControl.SourceLinks>
                                    </fhInfoPopup:InfoPopupControl>

                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            x:Uid="Memory_ManufacturerText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{x:Bind Manufacturer}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                                        <StackPanel Width="Auto" Spacing="2">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind loc:AppTerms.Get('Memory_PartNumber')}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                Text="{x:Bind PartNumber}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Width="Auto" Spacing="2">
                                            <TextBlock
                                                x:Uid="Memory_SerialNumberText"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                Text="{x:Bind SerialNumber}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </controls:WrapPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind loc:AppTerms.Get('Memory_Capacity')}" />
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind staticInfo:HardwareInfoFormatter.FormatBytesAsGb(CapacityBytes)}" />
                                    </StackPanel>

                                    <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                                        <StackPanel Width="Auto" Spacing="2">
                                            <TextBlock
                                                x:Uid="Memory_TypeText"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind staticInfo:HardwareInfoFormatter.FormatMemoryType(SmbiosMemoryType)}" />
                                        </StackPanel>

                                        <StackPanel Width="Auto" Spacing="2">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind loc:AppTerms.Get('Memory_FormFactor')}"
                                                TextWrapping="Wrap" />
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind staticInfo:HardwareInfoFormatter.FormatFormFactor(FormFactor)}" />
                                        </StackPanel>
                                    </controls:WrapPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind loc:AppTerms.Get('Memory_RAMSpeedConfiguredRated')}" />
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind staticInfo:HardwareInfoFormatter.FormatSpeedPair(ConfiguredClockSpeedMhz, RatedSpeedMhz)}" />
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind loc:AppTerms.Get('Memory_VoltageConfiguredMinMax')}" />
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind staticInfo:HardwareInfoFormatter.FormatVoltageRange(ConfiguredVoltageMillivolts, MinVoltageMillivolts, MaxVoltageMillivolts)}" />
                                    </StackPanel>

                                    <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
                                        <StackPanel Width="Auto" Spacing="2">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind loc:AppTerms.Get('Memory_Bank')}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                Text="{x:Bind BankLabel}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Width="Auto" Spacing="2">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind loc:AppTerms.Get('Memory_Rank')}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                Text="{x:Bind staticInfo:HardwareInfoFormatter.FormatRank(Rank)}" />
                                        </StackPanel>
                                    </controls:WrapPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind loc:AppTerms.Get('Memory_WidthTotalData')}" />
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind staticInfo:HardwareInfoFormatter.FormatBitsWidth(TotalWidthBits, DataWidthBits)}" />
                                    </StackPanel>

                                    <Border Height="0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  info panel splitter  -->
        <!--  (a 9px band centered on the divider line; it resizes the content column before it)  -->
        <fhControls:ClampedGridSplitter
            x:Uid="Memory_ResizeHardwareInfoSplitter"
            Grid.Column="1"
            Width="9"
            Margin="-4,0,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            IsTabStop="False"
            IsThumbVisible="False"
            ManipulationCompleted="InfoPanelSplitter_ManipulationCompleted"
            ResizeBehavior="PreviousAndCurrent"
            ResizeDirection="Columns"
            Visibility="{x:Bind fhPerf:PerformanceViewModel.Instance.InfoPanelVisibility, Mode=OneWay}" />

    </Grid>
</UserControl>
