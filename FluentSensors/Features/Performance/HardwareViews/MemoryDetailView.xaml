<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentSensors.Features.Performance.HardwareViews.MemoryDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhGraph="using:FluentSensors.Controls.SensorGraph"
    xmlns:fhTile="using:FluentSensors.Controls.SensorTile"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="ContentScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        SizeChanged="ContentScrollViewer_SizeChanged"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel
            x:Name="ContentStackPanel"
            Padding="16,8,16,16"
            Spacing="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="OverviewBlockGrid"
                    Grid.Row="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  physical memory (top) + virtual memory (bottom), stacked - no wide/narrow switching  -->
                    <Grid
                        x:Name="GraphsAreaGrid"
                        Grid.Row="0"
                        MinHeight="280"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <fhGraph:SensorPanelControl
                            Grid.Row="0"
                            GraphColorOverride="#FF0078D4"
                            GraphDataPointsOverride="180"
                            IsAutoScaledOverride="False"
                            ManualYMaxOverride="{x:Bind Memory.RoundedTotalMemory, Mode=OneWay}"
                            ShowStatusRow="True"
                            ShowThresholdControls="True"
                            ShowYAxisControls="True"
                            ThresholdLabelAlwaysVisible="False"
                            ViewModel="{x:Bind Memory.Used, Mode=OneWay}" />

                        <fhGraph:SensorPanelControl
                            Grid.Row="1"
                            GraphColorOverride="#FF8764B8"
                            GraphDataPointsOverride="180"
                            IsAutoScaledOverride="False"
                            ManualYMaxOverride="{x:Bind Memory.VirtualMemoryTotal, Mode=OneWay}"
                            ShowStatusRow="True"
                            ShowThresholdControls="True"
                            ShowYAxisControls="True"
                            ThresholdLabelAlwaysVisible="False"
                            ViewModel="{x:Bind Memory.VirtualMemoryUsed, Mode=OneWay}" />
                    </Grid>

                    <!--  current value tiles  -->
                    <Grid x:Name="TilesGrid" Grid.Row="1">
                        <StackPanel
                            Margin="0,0,0,16"
                            Orientation="Horizontal"
                            Spacing="8">
                            <fhTile:SensorTileControl
                                Title="Physical Memory Used"
                                Width="140"
                                ViewModel="{x:Bind Memory.Used, Mode=OneWay}" />
                            <fhTile:SensorTileControl
                                Title="Virtual Memory Used"
                                Width="200"
                                InfoMessage="Includes RAM plus page file space reserved for programs - roughly matches Task Manager's &quot;Committed&quot; + &quot;Cached&quot; figures, not just physical RAM."
                                ShowInfoButton="True"
                                ViewModel="{x:Bind Memory.VirtualMemoryUsed, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>