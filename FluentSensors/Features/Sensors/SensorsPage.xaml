<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentSensors.Features.Sensors.SensorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhCommon="using:FluentSensors.Common.Sensors"
    xmlns:fhControls="using:FluentSensors.Controls.SensorRow"
    xmlns:fhSensors="using:FluentSensors.Features.Sensors"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="RootScrollViewer"
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Auto"
        SizeChanged="RootScrollViewer_SizeChanged"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  header: control buttons  -->
            <!--  (the command bar pads its right side itself, so only 10 here)  -->
            <Border
                Grid.Row="0"
                Padding="16,0,10,1"
                Background="Transparent"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">

                <Grid x:Name="SensorListHeaderGrid" SizeChanged="SensorListHeaderGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <!--  column 0 reserves a minimum width from SensorListTitleText  -->
                        <ColumnDefinition Width="Auto" MinWidth="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="SensorListTitleText"
                            x:Uid="Sensors_SensorListTitleText"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />

                        <!--  the profile the checkboxes reflect and commit to  -->
                        <ComboBox
                            x:Name="SelectionProfileComboBox"
                            x:Uid="Sensors_SelectionProfileComboBox"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            SelectedIndex="0"
                            SelectionChanged="SelectionProfileComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="Sensors_SelectionProfileComboBox_WidgetWindow" Tag="WidgetWindow" />
                            <ComboBoxItem x:Uid="Sensors_SelectionProfileComboBox_Csv" Tag="Csv" />
                            <ComboBoxItem x:Uid="Sensors_SelectionProfileComboBox_Taskbar" Tag="Taskbar" />
                        </ComboBox>
                    </StackPanel>

                    <!--  command bar in column 1, after the minimum of column 0  -->
                    <CommandBar
                        x:Name="SensorListCommandBar"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        fhUi:FocusGroup.IsEnabled="True"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="False"
                        IsOpen="False"
                        Loaded="SensorListCommandBar_Loaded">

                        <!--  (slides in from the right after a rebuild, see AnimateCommandBarEntrance)  -->
                        <CommandBar.RenderTransform>
                            <TranslateTransform x:Name="CommandBarTransform" />
                        </CommandBar.RenderTransform>

                        <CommandBar.Resources>
                            <SolidColorBrush x:Key="CommandBarBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                            <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />

                            <Thickness x:Key="AppBarButtonPadding">0,0,0,0</Thickness>
                        </CommandBar.Resources>

                        <CommandBar.PrimaryCommands>
                            <!--  pin to widget button (shown for the Widget profile)  -->
                            <!--  (reads "Update Widget" with an update glyph while the widget is open, see BuildCommandBarPriorityOrder)  -->
                            <AppBarButton
                                x:Name="PinToWidgetButton"
                                x:Uid="Sensors_PinToWidgetButton"
                                Click="PinToWidget_Click">
                                <AppBarButton.Icon>
                                    <FontIcon x:Name="PinToWidgetIcon" Glyph="&#xE718;" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <!--  start csv logging button (shown for the Logging profile)  -->
                            <!--  (reads "Update CSV Logging" with an update glyph while the logger is open, see BuildCommandBarPriorityOrder)  -->
                            <AppBarButton
                                x:Name="StartCsvMonitoringButton"
                                x:Uid="Sensors_StartCsvMonitoringButton"
                                Click="StartCsvMonitoring_Click">
                                <AppBarButton.Icon>
                                    <FontIcon x:Name="StartCsvMonitoringIcon" Glyph="&#xE8A7;" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <!--  pin to taskbar button (shown for the Taskbar profile while the widget is closed)  -->
                            <AppBarButton
                                x:Name="PinToTaskbarButton"
                                x:Uid="Sensors_PinToTaskbarButton"
                                Click="PinToTaskbar_Click">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE840;" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <!--  update and close the taskbar widget as two plain buttons (shown for the Taskbar profile while the widget is open)  -->
                            <AppBarButton
                                x:Name="TaskbarUpdateButton"
                                x:Uid="Sensors_TaskbarUpdateButton"
                                Click="PinToTaskbar_Click">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE895;" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarButton
                                x:Name="TaskbarCloseButton"
                                x:Uid="Sensors_TaskbarCloseButton"
                                Click="CloseTaskbarWidget_Click">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE711;" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <!--  update and close the taskbar widget (shown for the Taskbar profile while the widget is open)  -->
                            <!--
                                (two flat buttons joined into one split shape with the colors of the other bar buttons;
                                hovering either part lights both, see TaskbarWidgetButtons_PointerEntered)
                            -->
                            <!--  revisit: split taskbar buttons; parked while the two plain buttons above are tried out, x:Load keeps it out of the tree  -->
                            <AppBarElementContainer
                                x:Name="TaskbarWidgetButtonsContainer"
                                VerticalContentAlignment="Stretch"
                                x:Load="False">
                                <Grid
                                    x:Name="TaskbarWidgetButtonsGrid"
                                    Margin="2,5,2,5"
                                    ColumnSpacing="0"
                                    PointerCanceled="TaskbarWidgetButtons_PointerExited"
                                    PointerEntered="TaskbarWidgetButtons_PointerEntered"
                                    PointerExited="TaskbarWidgetButtons_PointerExited"
                                    Unloaded="TaskbarWidgetButtons_PointerExited">
                                    <Grid.Resources>
                                        <!--  (the AppBarButton fills; the hover brush is set on the other half from code)  -->
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <!--  light  -->
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                    <!--  (SubtleFillColorSecondary as literals; a StaticResource here resolves against the app theme, not this one)  -->
                                                    <SolidColorBrush x:Key="TaskbarWidgetButtonsHoverBrush" Color="#09000000" />
                                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlFillColorTransparentBrush" />
                                                </ResourceDictionary>
                                                <!--  dark  -->
                                                <ResourceDictionary x:Key="Dark">
                                                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                    <SolidColorBrush x:Key="TaskbarWidgetButtonsHoverBrush" Color="#0FFFFFFF" />
                                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlFillColorTransparentBrush" />
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  update  -->
                                    <Button
                                        x:Name="UpdateTaskbarButton"
                                        Grid.Column="0"
                                        Margin="0,0,-0.4,0"
                                        Padding="11,0,6,0"
                                        VerticalAlignment="Stretch"
                                        Click="PinToTaskbar_Click"
                                        CornerRadius="4.5,0,0,4.5">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE895;" />
                                            <TextBlock
                                                x:Uid="Sensors_UpdateTaskbarText"
                                                VerticalAlignment="Center"
                                                FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!--  close  -->
                                    <Button
                                        x:Name="CloseTaskbarWidgetButton"
                                        x:Uid="Sensors_CloseTaskbarWidgetButton"
                                        Grid.Column="1"
                                        Margin="-0.5,0,0,0"
                                        Padding="6,0,9,0"
                                        VerticalAlignment="Stretch"
                                        Click="CloseTaskbarWidget_Click"
                                        CornerRadius="0,4.5,4.5,0">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="Close" />
                                        <!--<FontIcon FontSize="14" Glyph="&#xE711;" />-->
                                    </Button>
                                </Grid>
                            </AppBarElementContainer>

                            <!--  separator behind the update and close pair, only while it is shown  -->
                            <AppBarSeparator x:Name="TaskbarWidgetButtonsSeparator" />

                            <!--  hide sensors button  -->
                            <AppBarButton
                                x:Name="HideSensorsButton"
                                x:Uid="Sensors_HideSensorsButton"
                                Click="HideSensors_Click">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xED1A;" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarSeparator x:Name="ButtonSeparator" />

                            <!--  reset min max button  -->
                            <AppBarButton
                                x:Name="ResetValuesButton"
                                x:Uid="Sensors_ResetValuesButton"
                                Click="ResetMinMax_Click">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar.PrimaryCommands>

                        <CommandBar.SecondaryCommands>
                            <!--  show hidden sensors button  -->
                            <AppBarButton
                                x:Name="ShowHiddenSensorsButton"
                                x:Uid="Sensors_ShowHiddenSensorsButton"
                                Click="ShowHiddenSensors_Click"
                                IsEnabled="{x:Bind ViewModel.HasHiddenSensors, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar.SecondaryCommands>
                    </CommandBar>

                </Grid>
            </Border>

            <!--  header: column labels  -->
            <Border Grid.Row="1" Background="Transparent">
                <Grid HorizontalAlignment="Stretch">

                    <fhControls:SensorRowHeaderControl Margin="32,12,32,12" />

                    <Border
                        Height="1"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                </Grid>
            </Border>


            <!--  content: the hardware group cards  -->
            <!--  (the group glyphs come from HardwareGroupInfo)  -->
            <ScrollViewer
                x:Name="MainScrollViewer"
                Grid.Row="2"
                Padding="16,0,16,0">

                <!--  (tab jumps between groups, the arrow keys walk the rows across all of them)  -->
                <ItemsControl
                    x:Name="HardwareItemsControl"
                    Margin="0,0,0,16"
                    ItemsSource="{x:Bind ViewModel.HardwareGroups, Mode=OneWay}"
                    XYFocusKeyboardNavigation="Enabled">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fhSensors:HardwareGroupViewModel">

                            <!--  one expander per hardware group  -->
                            <controls:SettingsExpander
                                Margin="0,16,0,0"
                                fhUi:FocusGroup.IsEnabled="True"
                                AutomationProperties.Name="{x:Bind GroupLabel, Mode=OneWay}"
                                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                ItemsSource="{x:Bind Sensors, Mode=OneWay}"
                                Loaded="SettingsExpander_Loaded">

                                <controls:SettingsExpander.Resources>
                                    <Thickness x:Key="SettingsCardHeaderIconMargin">2,0,16,0</Thickness>

                                    <!--
                                        workaround: SettingsCard left-aligns its content below the wrap threshold
                                        problem: below SettingsCardWrapThreshold (476) RightWrapped beats the
                                        Vertical state and aligns the content left, so each row takes the width
                                        of its name (ContentAlignmentStates):
                                        https://github.com/CommunityToolkit/Windows/blob/v8.2.251219/components/SettingsControls/src/SettingsCard/SettingsCard.xaml
                                        fix: a threshold of 0, RightWrapped never triggers; no public issue found
                                    -->
                                    <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                </controls:SettingsExpander.Resources>

                                <controls:SettingsExpander.HeaderIcon>
                                    <FontIcon Foreground="{x:Bind IconBrush, Mode=OneWay}" Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                                </controls:SettingsExpander.HeaderIcon>

                                <!--  header: category and device name  -->
                                <!--
                                    (TextBlocks rather than plain strings, which the card template always wraps; a TextBlock
                                    header also drops the automatic accessible name, so the expander sets its own above)
                                -->
                                <controls:SettingsExpander.Header>
                                    <TextBlock
                                        Text="{x:Bind GroupLabel, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </controls:SettingsExpander.Header>
                                <controls:SettingsExpander.Description>
                                    <TextBlock
                                        Text="{x:Bind HardwareName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </controls:SettingsExpander.Description>

                                <!--  sensor count, shown/total  -->
                                <TextBlock
                                    AutomationProperties.Name="{x:Bind SensorCountName, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind SensorCountText, Mode=OneWay}"
                                    Typography.NumeralAlignment="Tabular" />

                                <!--  column labels  -->
                                <controls:SettingsExpander.ItemsHeader>
                                    <controls:SettingsCard
                                        MinHeight="0"
                                        Padding="16,12,16,8"
                                        HorizontalContentAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="0"
                                        ContentAlignment="Vertical"
                                        CornerRadius="0">

                                        <fhControls:SensorRowHeaderControl />

                                    </controls:SettingsCard>
                                </controls:SettingsExpander.ItemsHeader>

                                <!--  items  -->
                                <controls:SettingsExpander.ItemTemplate>
                                    <DataTemplate x:DataType="fhControls:SensorRowViewModel">

                                        <controls:SettingsCard
                                            MinHeight="0"
                                            Margin="0"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ContentAlignment="Vertical"
                                            CornerRadius="0">

                                            <fhControls:SensorRowControl HorizontalAlignment="Stretch" ViewModel="{x:Bind}" />
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </controls:SettingsExpander.ItemTemplate>

                            </controls:SettingsExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>


            <!--  content area with clipped InfoBar overlay  -->
            <Grid
                x:Name="InfoBarHost"
                Grid.Row="2"
                Grid.RowSpan="2"
                Loaded="InfoBarHost_Loaded">

                <InfoBar
                    x:Name="NoSensorsInfoBar"
                    x:Uid="Sensors_NoSensorsInfoBar"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    IsClosable="False"
                    IsHitTestVisible="False"
                    IsOpen="True"
                    Severity="Warning">

                    <InfoBar.RenderTransform>
                        <TranslateTransform x:Name="InfoBarTransform" Y="100" />
                    </InfoBar.RenderTransform>
                </InfoBar>
            </Grid>


            <!--  bottom bar: control buttons  -->
            <Border
                x:Name="BottomBar"
                Grid.Row="3"
                Padding="16,0,10,1"
                Background="Transparent"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  elapsed time since the last stats reset  -->
                    <StackPanel
                        Grid.Column="0"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            x:Uid="Sensors_RunningForText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StatsElapsedText, Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>

                    <CommandBar
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        fhUi:FocusGroup.IsEnabled="True"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="False"
                        IsOpen="False">

                        <CommandBar.Resources>
                            <SolidColorBrush x:Key="CommandBarBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                            <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />

                            <Thickness x:Key="AppBarButtonPadding">0,0,0,0</Thickness>
                        </CommandBar.Resources>

                        <!--  select pinned sensors button  -->
                        <AppBarButton
                            x:Name="SelectPinnedButton"
                            x:Uid="Sensors_SelectPinnedButton"
                            Click="SelectPinned_Click"
                            IsEnabled="{x:Bind ViewModel.IsPinnedAvailable, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <!--<FontIcon Glyph="&#xE73A;" />-->
                                <FontIcon Glyph="&#xEA52;" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <!--  unselect all sensors button  -->
                        <AppBarButton
                            x:Name="DeselectAllButton"
                            x:Uid="Sensors_DeselectAllButton"
                            Click="DeselectAll_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8E6;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
