<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSensors.Features.Sensors.HiddenSensorsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fhControls="using:FluentSensors.Controls.SensorRow"
    xmlns:fhSensors="using:FluentSensors.Features.Sensors"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Fluent Sensors"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  custom title bar  -->
        <Grid
            x:Name="CustomTitleBar"
            Grid.Row="0"
            Height="32"
            Background="Transparent">

            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Hidden Sensors" />
        </Grid>

        <!--  header labels  -->
        <Border Grid.Row="1" Background="Transparent">
            <Grid HorizontalAlignment="Stretch">

                <fhControls:SensorRowHeaderControl Margin="32,8,32,12" IsCompact="True" />

                <Border
                    Height="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            </Grid>
        </Border>


        <!--  content: the hidden sensors per hardware group, laid out like SensorsPage  -->
        <ScrollViewer
            Grid.Row="2"
            Padding="16,0,16,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <!--  (tab jumps between hardware groups, the arrow keys move through all rows)  -->
            <ItemsControl
                x:Name="HardwareGroupsItemsControl"
                Margin="0,0,0,16"
                ItemsSource="{x:Bind ViewModel.HardwareGroups, Mode=OneWay}"
                XYFocusKeyboardNavigation="Enabled">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="fhSensors:HardwareGroupViewModel">

                        <!--  one hardware group  -->
                        <controls:SettingsExpander
                            Margin="0,16,0,0"
                            fhUi:FocusGroup.IsEnabled="True"
                            AutomationProperties.Name="{x:Bind GroupLabel, Mode=OneWay}"
                            IsExpanded="{x:Bind IsExpandedInHiddenWindow, Mode=TwoWay}"
                            Visibility="{x:Bind HiddenPanelVisibility, Mode=OneWay}">

                            <controls:SettingsExpander.Resources>
                                <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                            </controls:SettingsExpander.Resources>

                            <controls:SettingsExpander.HeaderIcon>
                                <FontIcon Foreground="{x:Bind IconBrush, Mode=OneWay}" Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                            </controls:SettingsExpander.HeaderIcon>

                            <!--  header: category and device, TextBlocks and accessible name as on SensorsPage  -->
                            <controls:SettingsExpander.Header>
                                <TextBlock
                                    Text="{x:Bind GroupLabel, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </controls:SettingsExpander.Header>
                            <controls:SettingsExpander.Description>
                                <TextBlock
                                    Text="{x:Bind HardwareName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </controls:SettingsExpander.Description>

                            <!--  header  -->
                            <controls:SettingsExpander.ItemsHeader>
                                <StackPanel>
                                    <Border Padding="16,12,16,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <fhControls:SensorRowHeaderControl IsCompact="True" />
                                    </Border>

                                    <!--  items  -->
                                    <!--
                                        workaround: SettingsExpander items crash via ItemsSource
                                        problem: the toolkit SettingsExpander styles every ItemsSource item as
                                        TargetType SettingsCard; any other item throws a native exception that
                                        kills the process, invisible even to a debugger (our finding, no public issue)
                                        fix: a plain ItemsControl inside ItemsHeader skips the item styling
                                        (SensorsPage wraps each item in a SettingsCard instead)
                                    -->
                                    <ItemsControl ItemsSource="{x:Bind HiddenSensors, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="fhControls:SensorRowViewModel">
                                                <fhControls:SensorRowControl
                                                    HorizontalAlignment="Stretch"
                                                    IsCompact="True"
                                                    ViewModel="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:SettingsExpander.ItemsHeader>

                        </controls:SettingsExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  bottom bar, the restore action  -->
        <Border
            Grid.Row="3"
            Padding="16,12,16,12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">

            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="RestoreSelected_Click"
                Content="Restore Selected" />
        </Border>
    </Grid>
</Window>