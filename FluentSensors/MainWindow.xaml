<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSensors.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:composition="using:Windows.UI.Composition"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fh="using:FluentSensors"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:fhUi="using:FluentSensors.Common.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:winex="using:WinUIEx"
    Title="Fluent Sensors"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--  custom title bar  -->
        <!--
            (a plain Grid, not the native TitleBar, whose Content and RightHeader force their own alignment and
            can collapse the title; the interactive controls get passthrough rects, see TitleBarPassthrough)
        -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            fhUi:FocusGroup.IsEnabled="True"
            Background="Transparent"
            Loaded="AppTitleBar_Loaded"
            SizeChanged="AppTitleBar_SizeChanged">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  icon  -->
            <Image
                x:Name="AppTitleIcon"
                Grid.Column="0"
                Width="16"
                Height="16"
                Margin="17,0,0,0"
                VerticalAlignment="Center"
                Source="/Assets/Icon/Icon.png" />

            <!--  title text  -->
            <!--  (always shown, never collapses)  -->
            <TextBlock
                x:Name="AppTitleText"
                Grid.Column="1"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Fluent Sensors" />

            <!--  update pill  -->
            <!--
                (shown once UpdateService reports an update; the foreground is set on both children, an accent
                button does not pass its own down)
            -->
            <Button
                x:Name="UpdateButton"
                Grid.Column="2"
                Height="22"
                Margin="10,1,0,0"
                Padding="8,0"
                VerticalAlignment="Center"
                Click="UpdateButton_Click"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind BoolToVisibility(AppStatus.IsUpdateAvailable), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE896;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind AppStatus.UpdateVersionText, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <!--  missing prerequisite hints  -->
            <!--  (one shared column, so the status group columns and their order logic stay put)  -->
            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <!--  dotnet runtime hint  -->
                <!--
                    (only without a system-wide .NET Desktop Runtime 10 or newer, see WinStaticInfoService; several LHM
                    sensors need it whatever the bundled runtime)
                -->
                <fhInfoPopup:InfoPopupControl
                    x:Name="DotNetRuntimePopup"
                    x:Uid="Main_DotNetRuntimePopup"
                    Margin="8,1,0,0"
                    VerticalAlignment="Center"
                    ButtonBackground="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    ButtonGlyphForeground="{ThemeResource SystemFillColorCautionBrush}"
                    PlacementMode="Below"
                    Visibility="{x:Bind BoolToVisibility(AppStatus.IsDotNetRuntimeMissing), Mode=OneWay}">
                    <fhInfoPopup:InfoPopupControl.SourceLinks>
                        <fhInfoPopup:SourceLink Label=".NET 10 Runtime" Url="https://dotnet.microsoft.com/en-us/download/dotnet/10.0" />
                    </fhInfoPopup:InfoPopupControl.SourceLinks>
                </fhInfoPopup:InfoPopupControl>

                <!--  pawnio driver hint  -->
                <!--  (the driver is installed separately, nothing else says why the ring 0 readings are empty)  -->
                <fhInfoPopup:InfoPopupControl
                    x:Name="PawnIoPopup"
                    x:Uid="Main_PawnIoPopup"
                    Margin="8,1,0,0"
                    VerticalAlignment="Center"
                    ButtonBackground="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    ButtonGlyphForeground="{ThemeResource SystemFillColorCautionBrush}"
                    PlacementMode="Below"
                    Visibility="{x:Bind BoolToVisibility(AppStatus.IsPawnIoMissing), Mode=OneWay}">
                    <fhInfoPopup:InfoPopupControl.SourceLinks>
                        <fhInfoPopup:SourceLink Label="PawnIO" Url="https://pawnio.eu" />
                    </fhInfoPopup:InfoPopupControl.SourceLinks>
                </fhInfoPopup:InfoPopupControl>
            </StackPanel>

            <!--  toggle button for the whole status readout  -->
            <Button
                x:Name="StatusToggleButton"
                x:Uid="Main_StatusToggleButton"
                Grid.Column="4"
                Width="22"
                Height="22"
                Margin="8,1,0,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="StatusToggleButton_Click"
                Style="{ThemeResource SubtleButtonStyle}"
                Visibility="{x:Bind BoolToVisibility(AppStatus.IsStatusToggleVisible), Mode=OneWay}">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE76C;" />
            </Button>

            <!--  lhm group  -->
            <!--  (column and margin set from code, the settings page decides the order)  -->
            <StackPanel
                x:Name="LhmStatusGroup"
                Grid.Column="5"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{x:Bind BoolToVisibility(AppStatus.IsLhmGroupVisible), Mode=OneWay}">
                <fhInfoPopup:InfoPopupControl
                    x:Name="LhmInfoPopup"
                    x:Uid="Main_LhmInfoPopup"
                    Margin="-2,1,0,0"
                    PlacementMode="Below"
                    TitleForeground="{ThemeResource TextFillColorSecondaryBrush}">
                    <!--  readouts, carried by the popup so they follow its accent state  -->
                    <!--  (no Foreground of their own, the presenter supplies it)  -->
                    <fhInfoPopup:InfoPopupControl.TitleContent>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind AppStatus.SensorsText, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind AppStatus.PollText, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </fhInfoPopup:InfoPopupControl.TitleContent>

                    <fhInfoPopup:InfoPopupControl.SourceLinks>
                        <fhInfoPopup:SourceLink x:Uid="Main_LhmGitHubSource" Url="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                    </fhInfoPopup:InfoPopupControl.SourceLinks>
                </fhInfoPopup:InfoPopupControl>
            </StackPanel>

            <!--  windows group  -->
            <!--  (the usage of this app; the second group hides on a narrow window)  -->
            <StackPanel
                x:Name="WindowsStatusGroup"
                Grid.Column="6"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{x:Bind BoolToVisibility(AppStatus.IsWindowsGroupVisible), Mode=OneWay}">
                <!--  (handle + gc memory; currently not displayed)  -->
                <!--<TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind AppStatus.HandleCountText, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind AppStatus.GcMemoryText, Mode=OneWay}" />-->
                <!--<fhInfoPopup:InfoPopupControl
                    Margin="-2,1,0,0"
                    Description="CPU Usage - this app's own CPU time relative to total capacity across all cores&#10;RAM Usage - physical memory currently mapped by this app (working set)&#10;Handles - open OS handles held by this app, useful for spotting leaks&#10;GC Memory - size of the managed heap tracked by the .NET garbage collector"
                    PlacementMode="Below"
                    SourceIntro="Source:">
                    <fhInfoPopup:InfoPopupControl.SourceLinks>
                        <fhInfoPopup:SourceLink Label="Windows Process API" Url="https://learn.microsoft.com/en-us/dotnet/api/system.diagnostics.process" />
                        <fhInfoPopup:SourceLink Label=".NET Garbage Collector" Url="https://learn.microsoft.com/en-us/dotnet/standard/garbage-collection/" />
                    </fhInfoPopup:InfoPopupControl.SourceLinks>
                </fhInfoPopup:InfoPopupControl>-->

                <fhInfoPopup:InfoPopupControl
                    x:Name="WindowsInfoPopup"
                    x:Uid="Main_WindowsInfoPopup"
                    Margin="-2,1,0,0"
                    PlacementMode="Below"
                    TitleForeground="{ThemeResource TextFillColorSecondaryBrush}">

                    <!--  readouts, carried by the popup so they follow its accent state  -->
                    <!--  (no Foreground of their own, the presenter supplies it)  -->
                    <fhInfoPopup:InfoPopupControl.TitleContent>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind AppStatus.CpuUsageText, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind AppStatus.RamUsageText, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </fhInfoPopup:InfoPopupControl.TitleContent>

                    <fhInfoPopup:InfoPopupControl.SourceLinks>
                        <fhInfoPopup:SourceLink Label="Windows Process API" Url="https://learn.microsoft.com/en-us/dotnet/api/system.diagnostics.process" />
                    </fhInfoPopup:InfoPopupControl.SourceLinks>
                </fhInfoPopup:InfoPopupControl>
            </StackPanel>

            <!--  (column 7 is an empty star spacer, draggable up to the caption buttons)  -->
        </Grid>


        <!--  navigation view  -->
        <!--
            (invisible until loaded, the transparent splash would show the pane; Opacity, since the reveal
            closes the pane and waits on a layout pass a collapsed element does not get)
        -->
        <NavigationView
            x:Name="MainNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            Opacity="0"
            OpenPaneLength="160"
            PaneDisplayMode="Left"
            SelectionChanged="MainNavigationView_SelectionChanged">

            <!--  (every item has an x:Name, the code behind finds them by name, not by index)  -->
            <NavigationView.MenuItems>

                <!--  start page  -->
                <NavigationViewItem
                    x:Name="StartNavItem"
                    x:Uid="Main_StartNavItem"
                    Tag="Start">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--  sensor page  -->
                <NavigationViewItem
                    x:Name="SensorsNavItem"
                    x:Uid="Main_SensorsNavItem"
                    Tag="Sensors">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xECAA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--  performance page  -->
                <NavigationViewItem
                    x:Name="PerformanceNavItem"
                    x:Uid="Main_PerformanceNavItem"
                    Tag="Performance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>

                <!--  settings page  -->
                <!--  (the animated gear of the built in settings item; NavigationViewItem drives its states itself)  -->
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    x:Uid="Main_SettingsNavItem"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <AnimatedIcon>
                            <AnimatedIcon.Source>
                                <animatedVisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE713;" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!--  page host  -->
            <!--
                (the theme transition runs the NavigationTransitionInfo of a Navigate call, without it the info is
                ignored; see MainNavigationView_SelectionChanged)
            -->
            <Frame x:Name="contentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>

        </NavigationView>


        <!--  loading status screen  -->
        <Grid
            x:Name="SplashOverlay"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Background="Transparent">

            <StackPanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Spacing="16">

                <!--  icon  -->
                <Image
                    Width="80"
                    Height="80"
                    HorizontalAlignment="Center"
                    Source="/Assets/Icon/Icon.png" />

                <ProgressBar
                    x:Name="LoadingProgressBar"
                    Width="200"
                    Margin="0,32,0,0"
                    Maximum="100"
                    Minimum="0"
                    Value="0" />

                <TextBlock
                    x:Name="LoadingStatusText"
                    x:Uid="Main_LoadingStatusText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>


        <!--  taskbar icon  -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            DoubleClickCommand="{x:Bind TrayDoubleClickCommand}"
            IconSource="/Assets/Icon/Icon.ico"
            LeftClickCommand="{x:Bind TrayLeftClickCommand}"
            NoLeftClickDelay="True"
            ToolTipText="Fluent Sensors"
            Visibility="Visible">

            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout x:Name="TrayMenu">
                    <!--  show windows  -->
                    <!--
                        (the tab in Text right-aligns the click hint; H.NotifyIcon rebuilds this as a native win32 menu
                        from Text, IsEnabled and Command, so KeyboardAcceleratorTextOverride never shows; the widget
                        entries are only in the list while their window is open, see UpdateWidgetTrayItems)
                    -->
                    <MenuFlyoutItem x:Name="WidgetWindow1TrayItem" Command="{x:Bind ShowWidgetWindow1Command}" />
                    <MenuFlyoutItem x:Name="WidgetWindow2TrayItem" Command="{x:Bind ShowWidgetWindow2Command}" />
                    <MenuFlyoutItem x:Name="WidgetWindow3TrayItem" Command="{x:Bind ShowWidgetWindow3Command}" />
                    <MenuFlyoutItem x:Uid="Main_CSVWindowSingleClickItem" Command="{x:Bind ShowCsvWindowCommand}" />
                    <MenuFlyoutItem x:Uid="Main_MainWindowDoubleClickItem" Command="{x:Bind TrayDoubleClickCommand}" />

                    <!--<MenuFlyoutSeparator />

                    <MenuFlyoutItem Command="{x:Bind ShowMainWindowCommand}" Text="Sensor Page" />
                    <MenuFlyoutItem Command="{x:Bind OpenPerformanceCommand}" Text="Performance Page" />
                    <MenuFlyoutItem Command="{x:Bind OpenSettingsCommand}" Text="Settings Page" />-->

                    <MenuFlyoutSeparator />

                    <!--  open github page  -->
                    <MenuFlyoutItem x:Uid="Main_DocumentationItem" Command="{x:Bind OpenDocumentationCommand}" />

                    <MenuFlyoutSeparator />

                    <!--  fully exit app  -->
                    <MenuFlyoutItem x:Uid="Main_ExitAppItem" Command="{x:Bind ExitAppCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
