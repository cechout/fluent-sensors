<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSensors.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composition="using:Windows.UI.Composition"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fh="using:FluentSensors"
    xmlns:fhInfoPopup="using:FluentSensors.Controls.InfoPopup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    xmlns:winex="using:WinUIEx"
    Title="Fluent Sensors"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--  custom title bar  -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Fluent Sensors"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            SizeChanged="AppTitleBar_SizeChanged">

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Icon/Icon.ico" />
            </TitleBar.IconSource>

            <!--  tiny toggle for the whole status readout, sits right after the title; styling not final  -->
            <TitleBar.Content>
                <ToggleButton
                    Width="28"
                    Height="28"
                    Margin="4,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    IsChecked="{x:Bind AppStatus.IsStatusEnabled, Mode=TwoWay}">
                    <FontIcon FontSize="10" Glyph="&#xE76C;" />
                </ToggleButton>
            </TitleBar.Content>

            <!--  app status readout, plain TextBlocks for now, design not final  -->
            <TitleBar.RightHeader>
                <StackPanel
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="20">

                    <!--  lhm group, has priority over the windows group below when space runs out  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind BoolToVisibility(AppStatus.IsLhmGroupVisible), Mode=OneWay}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind AppStatus.SensorsFoundText, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind AppStatus.SensorsRenderedText, Mode=OneWay}" />
                        <fhInfoPopup:InfoPopupControl
                            Margin="-2,2,0,0"
                            Description="LibreHardwareMonitor reads CPU, GPU, RAM, storage, and network sensors directly from the hardware&#10;The largest and most established open source hardware monitoring library for Windows"
                            PlacementMode="Below"
                            SourceIntro="Powered by the open source LibreHardwareMonitor project:">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="LibreHardwareMonitor on GitHub" Url="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>
                    </StackPanel>

                    <!--  this apps own resource usage, first to hide on a narrow window  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind BoolToVisibility(AppStatus.IsWindowsGroupVisible), Mode=OneWay}">
                        <TextBlock
                            MinWidth="55"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind AppStatus.CpuUsageText, Mode=OneWay}" />
                        <TextBlock
                            MinWidth="65"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind AppStatus.RamUsageText, Mode=OneWay}" />
                        <!--<TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind AppStatus.HandleCountText, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind AppStatus.GcMemoryText, Mode=OneWay}" />-->
                        <fhInfoPopup:InfoPopupControl
                            Margin="-2,2,0,0"
                            Description="CPU Usage - this app's own CPU time relative to total capacity across all cores&#10;RAM Usage - physical memory currently mapped by this app (working set)&#10;Handles - open OS handles held by this app, useful for spotting leaks&#10;GC Memory - size of the managed heap tracked by the .NET garbage collector"
                            PlacementMode="Below"
                            SourceIntro="Read directly from:">
                            <fhInfoPopup:InfoPopupControl.SourceLinks>
                                <fhInfoPopup:SourceLink Label="Windows Process API" Url="https://learn.microsoft.com/en-us/dotnet/api/system.diagnostics.process" />
                                <fhInfoPopup:SourceLink Label=".NET Garbage Collector" Url="https://learn.microsoft.com/en-us/dotnet/standard/garbage-collection/" />
                            </fhInfoPopup:InfoPopupControl.SourceLinks>
                        </fhInfoPopup:InfoPopupControl>
                    </StackPanel>

                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>


        <!--  navigation view  -->
        <NavigationView
            x:Name="MainNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            OpenPaneLength="170"
            PaneDisplayMode="Left"
            SelectionChanged="MainNavigationView_SelectionChanged">

            <NavigationView.MenuItems>

                <!--  sensor page  -->
                <NavigationViewItem Content="Sensors" Tag="Sensors">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xECAA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--  performance page  -->
                <NavigationViewItem Content="Hardware View" Tag="Performance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>

                <!--  settings page  -->
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="contentFrame" />

        </NavigationView>


        <!--  loading status screen  -->
        <Grid
            x:Name="SplashOverlay"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <StackPanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Spacing="16">

                <!--  icon  -->
                <Grid HorizontalAlignment="Center">
                    <Border x:Name="ShadowReceiver" />
                    <Image
                        Width="80"
                        Height="80"
                        Source="/Assets/Icon/Icon.png">
                        <toolkit:Effects.Shadow>
                            <toolkit:AttachedDropShadow
                                BlurRadius="11"
                                CastTo="{x:Bind ShadowReceiver}"
                                Opacity="0.22"
                                Offset="0,3,0"
                                Color="Black" />
                        </toolkit:Effects.Shadow>
                    </Image>
                </Grid>

                <ProgressBar
                    x:Name="LoadingProgressBar"
                    Width="200"
                    Margin="0,32,0,0"
                    Maximum="100"
                    Minimum="0"
                    Value="0" />

                <TextBlock
                    x:Name="LoadingStatusText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Starting Fluent Sensors..." />
            </StackPanel>
        </Grid>


        <!--  taskbar icon  -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            DoubleClickCommand="{x:Bind TrayDoubleClickCommand}"
            IconSource="/Assets/Icon/Icon.ico"
            LeftClickCommand="{x:Bind TrayLeftClickCommand}"
            NoLeftClickDelay="True"
            ToolTipText="Fluent Sensors"
            Visibility="Visible">

            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Command="{x:Bind TrayLeftClickCommand}"
                        KeyboardAcceleratorTextOverride="Single Click"
                        Text="Widget Window" />
                    <MenuFlyoutItem
                        Command="{x:Bind TrayDoubleClickCommand}"
                        KeyboardAcceleratorTextOverride="Double Click"
                        Text="Main Window" />

                    <!--<MenuFlyoutSeparator />

                    <MenuFlyoutItem Command="{x:Bind ShowMainWindowCommand}" Text="Sensor Page" />
                    <MenuFlyoutItem Command="{x:Bind OpenPerformanceCommand}" Text="Performance Page" />
                    <MenuFlyoutItem Command="{x:Bind OpenSettingsCommand}" Text="Settings Page" />-->

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Command="{x:Bind ExitAppCommand}" Text="Exit App" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>