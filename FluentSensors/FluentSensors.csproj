  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--  PublishTrimmed stays unset, trimming strips the WinRT and COM interop and the app crashes on start  -->
  </PropertyGroup>
  <!--
    binaries the self-contained publish carries but the app never loads: mscordaccore, mscordbi and
    DiaSymReader (debugger and dump readers only), clrgc and clrgcexp (only with System.GC.Name), msquic
    (HTTP/3), Mono.Posix (the linux path of LibreHardwareMonitorLib); the pdb leaves the publish output only,
    so it stays next to the build; after Publish, so the installer and the zip both get the smaller payload

    do NOT add the mui locale folders: Microsoft.ui.xaml.dll keeps its resources only there, no neutral copy,
    and the folder of the Windows UI language is the one loaded; without it the visual tree dies with
    STATUS_STOWED_EXCEPTION (0xc000027b), so en-US alone breaks every machine not running english
  -->
  <Target Name="CollectUnusedPublishPayload">
    <ItemGroup>
      <_PrunedPublishFile Include="$(PublishDir)FluentSensors.pdb" />
      <_PrunedPublishFile Include="$(PublishDir)Mono.Posix.NETStandard.dll" />
      <_PrunedPublishFile Include="$(PublishDir)libMonoPosixHelper.dll" />
      <_PrunedPublishFile Include="$(PublishDir)MonoPosixHelper.dll" />
      <_PrunedPublishFile Include="$(PublishDir)mscordaccore.dll" />
      <_PrunedPublishFile Include="$(PublishDir)mscordaccore_*.dll" />
      <_PrunedPublishFile Include="$(PublishDir)mscordbi.dll" />
      <_PrunedPublishFile Include="$(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll" />
      <_PrunedPublishFile Include="$(PublishDir)createdump.exe" />
      <_PrunedPublishFile Include="$(PublishDir)clretwrc.dll" />
      <_PrunedPublishFile Include="$(PublishDir)clrgc.dll" />
      <_PrunedPublishFile Include="$(PublishDir)clrgcexp.dll" />
      <_PrunedPublishFile Include="$(PublishDir)msquic.dll" />
      <!--
        left by the excluded ML component; ExcludeAssets keeps the declared dependencies, and nothing else
        references this one
      -->
      <_PrunedPublishFile Include="$(PublishDir)System.Numerics.Tensors.dll" />
    </ItemGroup>
  </Target>

  <Target Name="PruneUnusedPublishPayload" AfterTargets="Publish" DependsOnTargets="CollectUnusedPublishPayload">
    <Delete Files="@(_PrunedPublishFile)" />
  </Target>

  <!--
    the msix payload comes from the publish output before PruneUnusedPublishPayload runs, so the item is
    filtered here, independent of the order (a delete would have to hit the window between copy and payload);
    by file name, the payload identities need not be spelled like PublishDir
  -->
  <Target Name="PruneUnusedAppxPayload" AfterTargets="_ComputeAppxPackagePayload" DependsOnTargets="CollectUnusedPublishPayload" Condition="'$(WindowsPackageType)' != 'None'">
    <!--
      through a property, since an item and a batching qualifier in one condition batch against each other and
      match nothing; the semicolons anchor the names (clrgc.dll never swallows gc.dll); mscordaccore by prefix,
      its versioned name comes from a glob over a publish folder a previous prune may have emptied
    -->
    <PropertyGroup>
      <_PrunedPayloadNames>;@(_PrunedPublishFile->'%(Filename)%(Extension)');</_PrunedPayloadNames>
    </PropertyGroup>
    <ItemGroup>
      <_UnusedAppxPayload Include="@(AppxPackagePayload)" Condition="$(_PrunedPayloadNames.Contains(';%(Filename)%(Extension);')) or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore'))" />
      <AppxPackagePayload Remove="@(_UnusedAppxPayload)" />
      <AppxUploadPackagePayload Remove="@(_UnusedAppxPayload)" />
    </ItemGroup>
    <Message Importance="high" Text="dropped @(_UnusedAppxPayload->Count()) unused files from the msix payload" />
  </Target>

  <!--
    the store wants a four part version, stamped from the csproj at build time onto a copy in obj that
    @(AppxManifest) points at; _ValidatePresenceOfAppxManifestItems reads the source item and the file name,
    bundle version and final manifest follow it (stamping the output instead names a 1.4.0.0 payload _1.0.0.0_)
  -->
  <Target Name="StampAppxManifestVersion" BeforeTargets="_ValidatePresenceOfAppxManifestItems" Condition="'$(WindowsPackageType)' != 'None' and '@(AppxManifest)' != ''">
    <PropertyGroup>
      <_StampedAppxManifest>$(IntermediateOutputPath)Package.appxmanifest</_StampedAppxManifest>
    </PropertyGroup>
    <Copy SourceFiles="@(AppxManifest)" DestinationFiles="$(_StampedAppxManifest)" />
    <XmlPoke XmlInputPath="$(_StampedAppxManifest)"
             Query="/pkg:Package/pkg:Identity/@Version"
             Value="$(Version).0"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_StampedAppxManifest)" />
    </ItemGroup>
    <Message Importance="high" Text="stamped AppxManifest version $(Version).0" />
  </Target>

  <!--
    the tooling writes TargetDeviceFamily from TargetPlatformMinVersion (the 10.0.19041 of the github build),
    but an elevated msix needs build 22000; set here, not by a second platform floor and binary, and before
    _ValidateAppxManifest, so the corrected values are validated and packed
  -->
  <Target Name="SetAppxTargetDeviceFamily" AfterTargets="_GenerateCurrentProjectAppxManifest" Condition="'$(WindowsPackageType)' != 'None'">
    <PropertyGroup>
      <_AppxNamespace>&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;</_AppxNamespace>
      <_AppxMinVersion>10.0.22000.0</_AppxMinVersion>
      <_AppxMaxVersionTested>10.0.26100.0</_AppxMaxVersionTested>
    </PropertyGroup>
    <XmlPoke XmlInputPath="$(FinalAppxManifestName)"
             Query="/pkg:Package/pkg:Dependencies/pkg:TargetDeviceFamily/@MinVersion"
             Value="$(_AppxMinVersion)"
             Namespaces="$(_AppxNamespace)" />
    <XmlPoke XmlInputPath="$(FinalAppxManifestName)"
             Query="/pkg:Package/pkg:Dependencies/pkg:TargetDeviceFamily/@MaxVersionTested"
             Value="$(_AppxMaxVersionTested)"
             Namespaces="$(_AppxNamespace)" />
    <Message Importance="high" Text="set TargetDeviceFamily to $(_AppxMinVersion) / $(_AppxMaxVersionTested)" />
  </Target>
</Project>