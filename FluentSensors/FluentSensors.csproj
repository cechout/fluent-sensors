  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--
      PublishTrimmed stays unset on purpose, trimming strips the WinRT and COM interop types this app needs
      and the published build then crashes on startup
    -->
  </PropertyGroup>
  <!--
    the self contained publish carries binaries this app never loads
    the mscordaccore/mscordbi/DiaSymReader set is only ever pulled in by an attached debugger or a dump
    reader, clrgc and clrgcexp are alternative collectors that stay dormant unless System.GC.Name is set in
    the runtimeconfig, msquic is HTTP/3, and Mono.Posix is the linux sensor path inside
    LibreHardwareMonitorLib
    the pdb is dropped here instead of suppressed via DebugType so the symbols still sit next to the build
    for local triage
    this runs after Publish, so the installer and the portable zip both pick up the smaller payload

    do NOT add the mui locale folders here, they look like translations for 83 languages this app does not
    offer, but Microsoft.ui.xaml.dll keeps its resources only in those mui files with no neutral copy inside
    the dll, so the resource load fails as soon as the visual tree is built and the process dies with
    STATUS_STOWED_EXCEPTION (0xc000027b) in Microsoft.UI.Xaml.dll
    the folder that gets loaded is the one matching the Windows UI language, so trimming this down to en-US
    breaks every machine that is not running english
  -->
  <Target Name="CollectUnusedPublishPayload">
    <ItemGroup>
      <_PrunedPublishFile Include="$(PublishDir)FluentSensors.pdb" />
      <_PrunedPublishFile Include="$(PublishDir)Mono.Posix.NETStandard.dll" />
      <_PrunedPublishFile Include="$(PublishDir)libMonoPosixHelper.dll" />
      <_PrunedPublishFile Include="$(PublishDir)MonoPosixHelper.dll" />
      <_PrunedPublishFile Include="$(PublishDir)mscordaccore.dll" />
      <_PrunedPublishFile Include="$(PublishDir)mscordaccore_*.dll" />
      <_PrunedPublishFile Include="$(PublishDir)mscordbi.dll" />
      <_PrunedPublishFile Include="$(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll" />
      <_PrunedPublishFile Include="$(PublishDir)createdump.exe" />
      <_PrunedPublishFile Include="$(PublishDir)clretwrc.dll" />
      <_PrunedPublishFile Include="$(PublishDir)clrgc.dll" />
      <_PrunedPublishFile Include="$(PublishDir)clrgcexp.dll" />
      <_PrunedPublishFile Include="$(PublishDir)msquic.dll" />
      <!--
        left behind by the excluded ML component, ExcludeAssets drops a package own assets but not the
        dependencies it declares, and nothing else in the graph references it
      -->
      <_PrunedPublishFile Include="$(PublishDir)System.Numerics.Tensors.dll" />
    </ItemGroup>
  </Target>

  <Target Name="PruneUnusedPublishPayload" AfterTargets="Publish" DependsOnTargets="CollectUnusedPublishPayload">
    <Delete Files="@(_PrunedPublishFile)" />
  </Target>

  <!--
    the msix payload is assembled out of the publish output while PruneUnusedPublishPayload only runs after the
    Publish target has finished, so without this the package would ship every file that list drops
    the payload item is filtered rather than the files deleted, which keeps this independent of who runs first;
    a delete would have to hit the window between the publish copy and the payload computation
    matched by file name because the payload identities are not guaranteed to be spelled like PublishDir
  -->
  <Target Name="PruneUnusedAppxPayload" AfterTargets="_ComputeAppxPackagePayload" DependsOnTargets="CollectUnusedPublishPayload" Condition="'$(WindowsPackageType)' != 'None'">
    <!--
      the names go through a property first; an item reference and a batching qualifier in the same condition
      make msbuild batch both sides against each other, which silently matches nothing
      the semicolons around each side anchor the match, so clrgc.dll cannot swallow a file called gc.dll
      mscordaccore is matched by prefix instead: the list above resolves its versioned name through a glob over
      the publish folder, which is empty on the run right after a prune emptied it
    -->
    <PropertyGroup>
      <_PrunedPayloadNames>;@(_PrunedPublishFile->'%(Filename)%(Extension)');</_PrunedPayloadNames>
    </PropertyGroup>
    <ItemGroup>
      <_UnusedAppxPayload Include="@(AppxPackagePayload)" Condition="$(_PrunedPayloadNames.Contains(';%(Filename)%(Extension);')) or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore'))" />
      <AppxPackagePayload Remove="@(_UnusedAppxPayload)" />
      <AppxUploadPackagePayload Remove="@(_UnusedAppxPayload)" />
    </ItemGroup>
    <Message Importance="high" Text="dropped @(_UnusedAppxPayload->Count()) unused files from the msix payload" />
  </Target>

  <!--
    the store wants a four part version and the csproj is the only place one gets bumped by hand, so the
    manifest is stamped at build time instead of keeping a second number in Package.appxmanifest
    the stamp goes onto a copy in obj and @(AppxManifest) is pointed at that copy, because
    _ValidatePresenceOfAppxManifestItems reads the version out of the source item and everything downstream
    hangs off it: the package file name, the bundle manifest version and the final manifest
    poking the generated manifest afterwards instead would leave a package called _1.0.0.0_ around a payload
    that says 1.4.0.0
  -->
  <Target Name="StampAppxManifestVersion" BeforeTargets="_ValidatePresenceOfAppxManifestItems" Condition="'$(WindowsPackageType)' != 'None' and '@(AppxManifest)' != ''">
    <PropertyGroup>
      <_StampedAppxManifest>$(IntermediateOutputPath)Package.appxmanifest</_StampedAppxManifest>
    </PropertyGroup>
    <Copy SourceFiles="@(AppxManifest)" DestinationFiles="$(_StampedAppxManifest)" />
    <XmlPoke XmlInputPath="$(_StampedAppxManifest)"
             Query="/pkg:Package/pkg:Identity/@Version"
             Value="$(Version).0"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_StampedAppxManifest)" />
    </ItemGroup>
    <Message Importance="high" Text="stamped AppxManifest version $(Version).0" />
  </Target>

  <!--
    the generated manifest gets its TargetDeviceFamily written by the packaging tooling out of
    TargetPlatformMinVersion, so whatever Package.appxmanifest says is overwritten and the package would claim the
    same 10.0.19041 floor the github build targets
    the store build has to say windows 11 instead, because an elevated msix is not supported below build 22000
    corrected here rather than by raising TargetPlatformMinVersion for the packaged build, which would compile the
    same source against a different platform floor and hand out two different binaries
    runs before _ValidateAppxManifest, so the corrected values are what gets validated and packed
  -->
  <Target Name="SetAppxTargetDeviceFamily" AfterTargets="_GenerateCurrentProjectAppxManifest" Condition="'$(WindowsPackageType)' != 'None'">
    <PropertyGroup>
      <_AppxNamespace>&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;</_AppxNamespace>
      <_AppxMinVersion>10.0.22000.0</_AppxMinVersion>
      <_AppxMaxVersionTested>10.0.26100.0</_AppxMaxVersionTested>
    </PropertyGroup>
    <XmlPoke XmlInputPath="$(FinalAppxManifestName)"
             Query="/pkg:Package/pkg:Dependencies/pkg:TargetDeviceFamily/@MinVersion"
             Value="$(_AppxMinVersion)"
             Namespaces="$(_AppxNamespace)" />
    <XmlPoke XmlInputPath="$(FinalAppxManifestName)"
             Query="/pkg:Package/pkg:Dependencies/pkg:TargetDeviceFamily/@MaxVersionTested"
             Value="$(_AppxMaxVersionTested)"
             Namespaces="$(_AppxNamespace)" />
    <Message Importance="high" Text="set TargetDeviceFamily to $(_AppxMinVersion) / $(_AppxMaxVersionTested)" />
  </Target>
</Project>