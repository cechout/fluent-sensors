<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	  <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
	  
	  <!-- only place the version gets bumped, AssemblyVersion/FileVersion/InformationalVersion derive from this automatically -->
	  <Version>1.5.0</Version>

	  <Authors>Daniel Čech</Authors>
	  <Product>Fluent Sensors</Product>
	  <Copyright>© 2026 Daniel Čech</Copyright>
	  
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FluentSensors</RootNamespace>	
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>FolderProfile.pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>

	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <ApplicationIcon>Assets\Icon\Icon.ico</ApplicationIcon>
	  <WindowsPackageType>None</WindowsPackageType>
	  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
