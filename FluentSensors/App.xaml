<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="FluentSensors.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fh="using:FluentSensors">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  Other merged dictionaries here  -->
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!--  Dark Mode (Default)  -->
                <ResourceDictionary x:Key="Default">
                    <!--  Taskbar Button Border: #333333 top, #292929 sides & bottom (DWM compensated)  -->
                    <LinearGradientBrush x:Key="TaskbarButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#333333" />
                        <GradientStop Offset="0.15" Color="#292929" />
                        <GradientStop Offset="1.0" Color="#292929" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="TaskbarButtonActiveHoverBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBorderBrush" Color="Transparent" />

                    <StaticResource x:Key="TaskbarButtonHoverBackground" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="TaskbarButtonPressedBackground" ResourceKey="SubtleFillColorTertiaryBrush" />

                    <!--  Active Flyout States (DWM compensated: -3 offset so rendered on-screen colors match #323232 and #2A2A2A)  -->
                    <SolidColorBrush x:Key="TaskbarButtonActiveHoverBackground" Color="#2F2F2F" />
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBackground" Color="#272727" />
                </ResourceDictionary>

                <!--  Light Mode  -->
                <ResourceDictionary x:Key="Light">
                    <!--  Light Mode normal hover & normal pressed border: #E8E8E8 sides, #DEDEDE bottom  -->
                    <LinearGradientBrush x:Key="TaskbarButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#E8E8E8" />
                        <GradientStop Offset="0.75" Color="#E8E8E8" />
                        <GradientStop Offset="1.0" Color="#DEDEDE" />
                    </LinearGradientBrush>

                    <!--  Light Mode active hover border: #E5E5E5 sides, #D4D4D4 bottom  -->
                    <LinearGradientBrush x:Key="TaskbarButtonActiveHoverBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#E5E5E5" />
                        <GradientStop Offset="0.75" Color="#E5E5E5" />
                        <GradientStop Offset="1.0" Color="#D4D4D4" />
                    </LinearGradientBrush>

                    <!--  Light Mode active pressed border: #E8E8E8 solid  -->
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBorderBrush" Color="#E8E8E8" />

                    <!--  Light Mode normal hover: #F7F7F7, normal pressed: #F3F3F3  -->
                    <SolidColorBrush x:Key="TaskbarButtonHoverBackground" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="TaskbarButtonPressedBackground" Color="#F3F3F3" />

                    <!--  Light Mode active hover: #FAFAFA, active pressed: #F3F3F3  -->
                    <SolidColorBrush x:Key="TaskbarButtonActiveHoverBackground" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBackground" Color="#F3F3F3" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
