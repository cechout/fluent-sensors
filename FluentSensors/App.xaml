<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="FluentSensors.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fh="using:FluentSensors">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>

                <!--  === dark mode (default theme dictionary) ===  -->

                <!--  base taskbar background: #202020 (32)  -->
                <ResourceDictionary x:Key="Default">
                    <!--  1. taskbar button hover and pressed (alpha white on #202020)  -->
                    <!--  (hover, target #2D2D2D)  -->
                    <SolidColorBrush x:Key="TaskbarButtonHoverBackground" Color="#0FFFFFFF" />
                    <!--  (pressed, target #2A2A2A)  -->
                    <SolidColorBrush x:Key="TaskbarButtonPressedBackground" Color="#0BFFFFFF" />

                    <!--  2. taskbar button borders (dark mode)  -->
                    <!--
                        never transparent: the #1D top highlight lands ~#404040 like the native one, the sides take
                        the fill brush and vanish; the gradients run over a fixed 43.5 DIP, the standard bottom
                        button height, so the highlight keeps its height on every taskbar size and edge
                    -->
                    <!--  (the layers stay upright, the highlight belongs at the top)  -->
                    <x:Double x:Key="TaskbarButtonBorderScaleY">1</x:Double>
                    <LinearGradientBrush x:Key="TaskbarButtonBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,43.5">
                        <GradientStop Offset="0.0" Color="#1DFFFFFF" />
                        <GradientStop Offset="0.10" Color="#0FFFFFFF" />
                        <GradientStop Offset="1.0" Color="#0FFFFFFF" />
                    </LinearGradientBrush>
                    <!--
                        normal pressed border, the only one in that state (StrokeBorder is off); top #3B3B3B,
                        sides and bottom #2E2E2E
                    -->
                    <LinearGradientBrush x:Key="TaskbarButtonPressedBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,43.5">
                        <GradientStop Offset="0.0" Color="#1FFFFFFF" />
                        <GradientStop Offset="0.12" Color="#10FFFFFF" />
                        <GradientStop Offset="1.0" Color="#10FFFFFF" />
                    </LinearGradientBrush>

                    <!--  3. active flyout state (flyout open)  -->
                    <!--  (active hover, target #323232)  -->
                    <SolidColorBrush x:Key="TaskbarButtonActiveHoverBackground" Color="#15FFFFFF" />
                    <!--  active hover border; the normal hover highlight, the active hover fill on the sides  -->
                    <LinearGradientBrush x:Key="TaskbarButtonActiveHoverBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,43.5">
                        <GradientStop Offset="0.0" Color="#1DFFFFFF" />
                        <GradientStop Offset="0.10" Color="#15FFFFFF" />
                        <GradientStop Offset="1.0" Color="#15FFFFFF" />
                    </LinearGradientBrush>
                    <!--  (active pressed, target #2A2A2A)  -->
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBackground" Color="#0BFFFFFF" />
                    <!--  (no visible border here, so the fill brush, never Transparent)  -->
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBorderBrush" Color="#0BFFFFFF" />

                    <!--  4. flyout window styling (dark mode)  -->
                    <!--
                        the dark literals sit a few levels below the tone they show (dark values render lighter);
                        the second value on a line is what this display showed, not a spec
                    -->
                    <!--  content area; reads as #292929, opaque (the bottom bar paints its own, see 6)  -->
                    <SolidColorBrush x:Key="FlyoutWindowBackground" Color="#242424" />
                    <!--  window border; the native window stroke (SurfaceStrokeColorDefault), about #464646 over the content area  -->
                    <SolidColorBrush x:Key="FlyoutWindowBorderBrush" Color="#66757575" />

                    <!--  5. flyout graphs overlay (dark mode)  -->
                    <!--  (blur modes only, lifts the graphs area off the glass; the opaque mode has no overlay)  -->
                    <SolidColorBrush x:Key="FlyoutGraphsBackground" Color="#09FFFFFF" />

                    <!--  6. flyout bottom bar (dark mode)  -->
                    <!--  (reads as #222222, opaque, independent of the content area)  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarBackground" Color="#1C1C1C" />

                    <!--  7. flyout bottom bar separator (dark mode)  -->
                    <!--  (the 1px line above the bar; black at 1 - 0x19/0x24, so over the content area it reads as #191919)  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarSeparatorBrush" Color="#4E000000" />
                    <!--  (in the blur modes translucent like the native line, it darkens the material)  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarSeparatorOnGlassBrush" Color="#1B000000" />
                </ResourceDictionary>


                <!--  === light mode theme dictionary ===  -->

                <!--  base taskbar background: #EDEDED (237)  -->
                <ResourceDictionary x:Key="Light">
                    <!--  1. taskbar button hover and pressed (alpha white on #EDEDED)  -->
                    <!--  (hover, target #F7F7F7)  -->
                    <SolidColorBrush x:Key="TaskbarButtonHoverBackground" Color="#8EFFFFFF" />
                    <!--  (pressed, target #F3F3F3)  -->
                    <SolidColorBrush x:Key="TaskbarButtonPressedBackground" Color="#55FFFFFF" />

                    <!--  2. taskbar button border (normal hover and pressed)  -->
                    <!--
                        alpha black, calibrated on the transparency-on bar (~#F0F0F0): top and sides #E7E7E7, bottom
                        #DDDDDD; the layers are flipped here (TaskbarButtonBorderScaleY), so the gradients start at the
                        bottom and the darker band keeps the height of the dark highlight
                    -->
                    <x:Double x:Key="TaskbarButtonBorderScaleY">-1</x:Double>
                    <LinearGradientBrush x:Key="TaskbarButtonBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,43.5">
                        <GradientStop Offset="0.0" Color="#14000000" />
                        <GradientStop Offset="0.10" Color="#0A000000" />
                        <GradientStop Offset="1.0" Color="#0A000000" />
                    </LinearGradientBrush>
                    <!--  normal pressed border, the only one in that state; the values of TaskbarButtonBorderBrush  -->
                    <LinearGradientBrush x:Key="TaskbarButtonPressedBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,43.5">
                        <GradientStop Offset="0.0" Color="#14000000" />
                        <GradientStop Offset="0.12" Color="#0A000000" />
                        <GradientStop Offset="1.0" Color="#0A000000" />
                    </LinearGradientBrush>

                    <!--  3. active flyout state (flyout open)  -->
                    <!--  (active hover, target #FAFAFA)  -->
                    <SolidColorBrush x:Key="TaskbarButtonActiveHoverBackground" Color="#B8FFFFFF" />
                    <!--  active hover border; on the transparency-on bar top and sides #E5E5E5, bottom #D4D4D4  -->
                    <LinearGradientBrush x:Key="TaskbarButtonActiveHoverBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,43.5">
                        <GradientStop Offset="0.0" Color="#1E000000" />
                        <GradientStop Offset="0.10" Color="#0C000000" />
                        <GradientStop Offset="1.0" Color="#0C000000" />
                    </LinearGradientBrush>

                    <!--  (active pressed, target #F3F3F3)  -->
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBackground" Color="#55FFFFFF" />
                    <!--  active pressed border; alpha black over the bare bar, #E7E7E7 on all four sides  -->
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBorderBrush" Color="#0A000000" />

                    <!--  4. flyout window styling (light mode)  -->
                    <!--  (light needs barely any correction, under one level above roughly 230)  -->
                    <!--  content area; opaque (the bottom bar paints its own, see 6)  -->
                    <SolidColorBrush x:Key="FlyoutWindowBackground" Color="#F2F2F2" />
                    <!--  window border; the native window stroke (SurfaceStrokeColorDefault), #C0C0C0 over the content area  -->
                    <SolidColorBrush x:Key="FlyoutWindowBorderBrush" Color="#66757575" />

                    <!--  5. flyout graphs overlay (light mode)  -->
                    <!--  (blur modes only, lifts the graphs area off the glass; the opaque mode has no overlay)  -->
                    <SolidColorBrush x:Key="FlyoutGraphsBackground" Color="#41FFFFFF" />

                    <!--  6. flyout bottom bar (light mode)  -->
                    <!--  (opaque, independent of the content area)  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarBackground" Color="#EEEEEE" />

                    <!--  7. flyout bottom bar separator (light mode)  -->
                    <!--  (the 1px line above the bar; black at 1 - 0xE0/0xF2, so over the content area it reads as #E0E0E0)  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarSeparatorBrush" Color="#13000000" />
                    <!--  (in the blur modes translucent like the native line, it darkens the material)  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarSeparatorOnGlassBrush" Color="#0F000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>


            <!--  === custom subtle button ===  -->
            <!--
                (the platform SubtleButtonStyle fades the fill over 83 ms but swaps the border at once, so a hover
                starts as an outline round an empty button; here the border stays transparent in every state and
                the fill covers the outer border edge)
            -->
            <Style x:Key="SubtleBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleButtonBackground}" />
                <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleButtonForeground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}" />
                <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{TemplateBinding Background}"
                                BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Foreground="{TemplateBinding Foreground}">
                                <!--
                                    ControlFasterAnimationDuration, spelled out (Duration is a TimeSpan, the
                                    platform key a string; the platform button hardcodes it too)
                                -->
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083" />
                                </ContentPresenter.BackgroundTransition>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonBackgroundPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonForegroundPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonBackgroundPressed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonForegroundPressed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonBackgroundDisabled}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonForegroundDisabled}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--  === subtle tile button ===  -->
            <!--
                (the subtle bar button look, plus the whole content fading while held, since an image or a badge
                does not follow Foreground; its own template, BasedOn cannot add a VisualState)
            -->

            <!--  content opacity per state; (Foreground stays, so everything fades alike)  -->
            <x:Double x:Key="TileButtonContentOpacityHover">0.95</x:Double>
            <x:Double x:Key="TileButtonContentOpacityPressed">0.80</x:Double>
            <x:Double x:Key="TileButtonContentOpacityDisabled">0.45</x:Double>

            <Style x:Key="SubtleTileButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleButtonBackground}" />
                <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleButtonForeground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}" />
                <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{TemplateBinding Background}"
                                BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Foreground="{TemplateBinding Foreground}">
                                <!--  the 83 ms fill fade of the bar button  -->
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083" />
                                </ContentPresenter.BackgroundTransition>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleButtonBackgroundPointerOver}" />
                                                <Setter Target="ContentPresenter.Opacity" Value="{StaticResource TileButtonContentOpacityHover}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleButtonBackgroundPressed}" />
                                                <Setter Target="ContentPresenter.Opacity" Value="{StaticResource TileButtonContentOpacityPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <!--  (the same fade, further down)  -->
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleButtonBackgroundDisabled}" />
                                                <Setter Target="ContentPresenter.Opacity" Value="{StaticResource TileButtonContentOpacityDisabled}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--  === colour swatch button ===  -->
            <!--
                (the face is the colour its picker edits, handed in as Background; a veil lightens it on hover
                and darkens it while pressed)
            -->

            <!--  the veil per state; (the alpha is the strength)  -->
            <SolidColorBrush x:Key="ColorSwatchVeilPointerOver" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ColorSwatchVeilPressed" Color="#26000000" />

            <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                x:Name="RootGrid"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <!--  veil  -->
                                <!--  (one less than the outer radius, it sits inside the 1px stroke)  -->
                                <Border
                                    x:Name="Veil"
                                    Background="Transparent"
                                    CornerRadius="3">
                                    <!--  the 83 ms fade of the subtle buttons  -->
                                    <Border.BackgroundTransition>
                                        <BrushTransition Duration="0:0:0.083" />
                                    </Border.BackgroundTransition>
                                </Border>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Veil.Background" Value="{StaticResource ColorSwatchVeilPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Veil.Background" Value="{StaticResource ColorSwatchVeilPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--  === source link button ===  -->
            <!--  (the info popup link, shared with the release dialog; the negative margin aligns the text)  -->
            <Style x:Key="SourceLinkButtonStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="6,2,6,2" />
                <Setter Property="Margin" Value="-7,0,0,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!--  === page link button ===  -->
            <!--
                (the same link one size up, for a page; without the negative margin, which in a row pulls every
                link towards its neighbour)
            -->
            <Style
                x:Key="PageLinkButtonStyle"
                BasedOn="{StaticResource SourceLinkButtonStyle}"
                TargetType="HyperlinkButton">
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!--  === item lists ===  -->
            <!--
                (WinUI gives ItemsControl no style, so it keeps IsTabStop=True and every list would be an invisible
                tab stop; only the items take focus)
            -->
            <Style TargetType="ItemsControl">
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
