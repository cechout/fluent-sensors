<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="FluentSensors.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fh="using:FluentSensors">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  Other merged dictionaries here  -->
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>

                <!--  === DARK MODE (Default Theme Dictionary) ===  -->

                <!--  Base Taskbar Background: #202020 (32)  -->
                <ResourceDictionary x:Key="Default">
                    <!--  1. Taskbar Button Normal Hover & Pressed Backgrounds (Alpha White on #202020)  -->
                    <!--  Hover -> Target #2D2D2D (45): Alpha 15 (0x0F) -> #0FFFFFFF  -->
                    <SolidColorBrush x:Key="TaskbarButtonHoverBackground" Color="#0FFFFFFF" />
                    <!--  Pressed -> Target #2A2A2A (42): Alpha 11 (0x0B) -> #0BFFFFFF  -->
                    <SolidColorBrush x:Key="TaskbarButtonPressedBackground" Color="#0BFFFFFF" />

                    <!--  2. Taskbar Button Borders (Dark Mode: Only TOP border in Normal Hover, ALL 4 in Normal Pressed)  -->
                    <!--  Normal Hover Border: Top #16FFFFFF (Target #333333), sides & bottom Transparent  -->
                    <LinearGradientBrush x:Key="TaskbarButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#16FFFFFF" />
                        <GradientStop Offset="0.10" Color="Transparent" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </LinearGradientBrush>
                    <!--  Normal Pressed Border: All 4 borders visible with #0AFFFFFF (Target #292929 on sides/bottom)  -->
                    <SolidColorBrush x:Key="TaskbarButtonPressedBorderBrush" Color="#0AFFFFFF" />

                    <!--  3. Active Flyout State (When Flyout is currently OPEN)  -->
                    <!--  Active Hover -> Target #323232 (50): Alpha 21 (0x15) -> #15FFFFFF  -->
                    <SolidColorBrush x:Key="TaskbarButtonActiveHoverBackground" Color="#15FFFFFF" />
                    <!--  Active Hover Border: Keep top border #16FFFFFF, sides & bottom Transparent  -->
                    <LinearGradientBrush x:Key="TaskbarButtonActiveHoverBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#16FFFFFF" />
                        <GradientStop Offset="0.10" Color="Transparent" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </LinearGradientBrush>
                    <!--  Active Pressed -> Target #2A2A2A (42): Alpha 11 (0x0B) -> #0BFFFFFF  -->
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBackground" Color="#0BFFFFFF" />
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBorderBrush" Color="Transparent" />

                    <!--  4. Flyout Window Styling (Dark Mode)  -->
                    <!--
                        the dark literals sit a few levels below the tone they actually show; they were dialed in
                        by comparing screenshots with the native Windows surfaces, where dark values read back
                        lighter than they were written
                        that offset belongs to the display it was tuned on; another monitor measures its own
                        numbers, so the second value on each line is what was seen here and not a spec
                    -->
                    <!--  Content Area -> literal #242424, reads as #292929 here, opaque  -->
                    <!--  (the bottom bar paints its own color, see 6)  -->
                    <SolidColorBrush x:Key="FlyoutWindowBackground" Color="#242424" />
                    <!--
                        Window Border, semi transparent here too, flat: unlike the on-glass brush below there is
                        no native bottom-darker reference for opaque mode, just one measured target
                        white base, alpha fit from two real points instead of an assumed backdrop: alpha 0 is
                        always the backdrop itself by definition, measured here at #1F1F1F (31), and the old alpha
                        0x13 measured at #2F2F2F (47) is the second point; interpolating that line out to the
                        target #444444 (68) gives the alpha below
                        an earlier pass reused the on-glass alpha directly, which was fit against the acrylic
                        materials own backdrop, not this modes flat FlyoutWindowBackground, two different
                        backdrops behind the same alpha land on two different colors
                    -->
                    <SolidColorBrush x:Key="FlyoutWindowBorderBrush" Color="#2CFFFFFF" />
                    <!--
                        the same stroke in the blur modes, drawn as a hand painted gradient for the same reason as
                        in the light dictionary, see that comment for why
                        the top stop sits over the acrylic material, not directly over the desktop, and this
                        themes material barely reacts to what is actually behind the window: MicaPresetDarkLuminosity
                        keeps it within about 51 to 55 whether the desktop behind the flyout is dark or white,
                        confirmed by solving the border equation backwards from two on screen measurements at the
                        old #87FFFFFF (one over a dark desktop area, one over a white one)
                        native swings roughly 96 levels between those same two conditions (measured targets 63
                        and 159); with the material practically flat, no alpha or base color for this stroke can
                        reach both, moving the material itself was ruled out (see backdrop-color-only-not-tint-
                        luminosity in the agent notes)
                        weighted 95/5 toward the dark backdrop target on purpose: alpha barely changes how close
                        that target lands (the material term is too small to matter), so the color below keeps a
                        visible amount of transparency for the glass look while landing about 5 levels from the
                        dark target and giving up on the white one, roughly 92 levels off there
                        bottom stop is unchanged and carries the same caveat, it was never fit against a second
                        backdrop either
                    -->
                    <LinearGradientBrush x:Key="FlyoutWindowBorderOnGlassBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#D9464646" />
                        <GradientStop Offset="0.75" Color="#D9464646" />
                        <GradientStop Offset="1.0" Color="#66FFFFFF" />
                    </LinearGradientBrush>

                    <!--  5. Flyout Graphs Overlay (Dark Mode)  -->
                    <!--  only used in the blur modes, where it lifts the graphs area off the glass  -->
                    <!--  (the opaque mode takes its content color from FlyoutWindowBackground and uses no overlay)  -->
                    <SolidColorBrush x:Key="FlyoutGraphsBackground" Color="#0AFFFFFF" />

                    <!--  6. Flyout Bottom Bar (Dark Mode)  -->
                    <!--  Bottom Bar -> literal #1C1C1C, reads as #222222 here  -->
                    <!--  opaque and independent of the content area  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarBackground" Color="#1C1C1C" />

                    <!--  7. Flyout Bottom Bar Separator (Dark Mode)  -->
                    <!--  1px stroke between content area and bottom bar  -->
                    <!--  literal #181818, reads as #1E1E1E here  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarSeparatorBrush" Color="#181818" />
                    <!--  the same stroke in the blur modes, where the native line is translucent and darkens the  -->
                    <!--  material instead of covering it, so it keeps letting the backdrop through  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarSeparatorOnGlassBrush" Color="#1F000000" />
                </ResourceDictionary>


                <!--  === LIGHT MODE Theme Dictionary ===  -->

                <!--  Base Taskbar Background: #EDEDED (237)  -->
                <ResourceDictionary x:Key="Light">
                    <!--  1. Taskbar Button Normal Hover & Pressed Backgrounds (Alpha White on #EDEDED)  -->
                    <!--  Hover -> Target #F7F7F7 (247): Alpha 142 (0x8E) -> #8EFFFFFF  -->
                    <SolidColorBrush x:Key="TaskbarButtonHoverBackground" Color="#8EFFFFFF" />
                    <!--  Pressed -> Target #F3F3F3 (243): Alpha 85 (0x55) -> #55FFFFFF  -->
                    <SolidColorBrush x:Key="TaskbarButtonPressedBackground" Color="#55FFFFFF" />

                    <!--  2. Taskbar Button Border (Solid: Normal Hover & Pressed)  -->
                    <!--  Top & Sides: #E7E7E7, Bottom: #DDDDDD  -->
                    <LinearGradientBrush x:Key="TaskbarButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#E7E7E7" />
                        <GradientStop Offset="0.75" Color="#E7E7E7" />
                        <GradientStop Offset="1.0" Color="#DDDDDD" />
                    </LinearGradientBrush>
                    <!--  Normal Pressed Border: Transparent (StrokeBorder already covers it)  -->
                    <SolidColorBrush x:Key="TaskbarButtonPressedBorderBrush" Color="Transparent" />

                    <!--  3. Active Flyout State (When Flyout is currently OPEN)  -->
                    <!--  Active Hover -> Target #FAFAFA (250): Alpha 184 (0xB8) -> #B8FFFFFF  -->
                    <SolidColorBrush x:Key="TaskbarButtonActiveHoverBackground" Color="#B8FFFFFF" />
                    <!--  Active Hover Border (Solid) -> Top & Sides: #E5E5E5, Bottom: #D4D4D4  -->
                    <LinearGradientBrush x:Key="TaskbarButtonActiveHoverBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#E5E5E5" />
                        <GradientStop Offset="0.75" Color="#E5E5E5" />
                        <GradientStop Offset="1.0" Color="#D4D4D4" />
                    </LinearGradientBrush>

                    <!--  Active Pressed -> Target #F3F3F3 (243): Alpha 85 (0x55) -> #55FFFFFF  -->
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBackground" Color="#55FFFFFF" />
                    <!--  Active Pressed Border (Solid) -> #E7E7E7 on all 4 sides  -->
                    <SolidColorBrush x:Key="TaskbarButtonActivePressedBorderBrush" Color="#E7E7E7" />

                    <!--  4. Flyout Window Styling (Light Mode)  -->
                    <!--
                        light barely needs the correction described in the dark section, the offset stays under
                        one level above roughly 230
                    -->
                    <!--  Content Area -> #F2F2F2, opaque; the bottom bar paints its own color, see 6  -->
                    <SolidColorBrush x:Key="FlyoutWindowBackground" Color="#F2F2F2" />
                    <!--
                        Window Border, semi transparent here too, flat: unlike the on-glass brush below there is
                        no native bottom-darker reference for opaque mode, just one measured target
                        gray base, alpha fit from two real points instead of an assumed backdrop: alpha 0 is
                        always the backdrop itself by definition, measured here at #F3F3F3 (243), and the old
                        alpha 0x57 measured at #C1C1C1 (193) is the second point; interpolating that line out to
                        the target #B9B9B9 (185) gives the alpha below
                        an earlier pass reused the on-glass alpha directly, which was fit against the acrylic
                        materials own backdrop, not this modes flat FlyoutWindowBackground, two different
                        backdrops behind the same alpha land on two different colors
                    -->
                    <SolidColorBrush x:Key="FlyoutWindowBorderBrush" Color="#65757575" />
                    <!--
                        the same stroke in the blur modes; native flyouts read visibly darker toward the bottom
                        edge there, from their own DWM shadow sitting behind their equally translucent border, but
                        that channel measures out unusably weak on ours: the acrylic material blurs its own host
                        backdrop at a 30px radius (the recipe constant, see the grain section further down),
                        which flattens anything narrower than that long before luminosity (9 percent transmission
                        here) and this brushes own alpha get to it, so a shadow-side fix was tried and dropped,
                        see git history
                        drawn by hand instead: a two stop gradient, flat near the top and ramping darker over the
                        last quarter toward the bottom, mirroring the falloff shape without depending on that
                        channel; composite = alpha*117 + (1-alpha)*backdrop, so raising alpha is what darkens a
                        stop here, because 117 sits below this themes backdrop (the dark dictionary is the
                        opposite way round, see that comment)
                        both stops fit two independently measured points on screen: #66757575 (alpha 0.4) read
                        back as #BBBBBB (187), #99757575 (alpha 0.6) as #A0A0A0 (160); solving that pair for the
                        native targets (170 sides, 153 bottom) gives the alphas below directly, no assumed
                        backdrop value needed
                    -->
                    <LinearGradientBrush x:Key="FlyoutWindowBorderOnGlassBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#86757575" />
                        <GradientStop Offset="0.75" Color="#86757575" />
                        <GradientStop Offset="1.0" Color="#A6757575" />
                    </LinearGradientBrush>

                    <!--  5. Flyout Graphs Overlay (Light Mode)  -->
                    <!--  only used in the blur modes, where it lifts the graphs area off the glass  -->
                    <!--  (the opaque mode takes its content color from FlyoutWindowBackground and uses no overlay)  -->
                    <SolidColorBrush x:Key="FlyoutGraphsBackground" Color="#38FFFFFF" />

                    <!--  6. Flyout Bottom Bar (Light Mode)  -->
                    <!--  Bottom Bar -> Target #EDEDED (237), opaque and independent of the content area  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarBackground" Color="#EDEDED" />

                    <!--  7. Flyout Bottom Bar Separator (Light Mode)  -->
                    <!--  1px stroke between content area and bottom bar  -->
                    <!--  literal #DEDEDE, reads as #DDDDDD here  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarSeparatorBrush" Color="#DEDEDE" />
                    <!--  the same stroke in the blur modes, where the native line is translucent and darkens the  -->
                    <!--  material instead of covering it, so it keeps letting the backdrop through  -->
                    <SolidColorBrush x:Key="FlyoutBottomBarSeparatorOnGlassBrush" Color="#13000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
